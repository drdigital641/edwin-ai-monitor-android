diff -ruN '--exclude=node_modules' '--exclude=dist' runner-base/base44/shared/runner.ts runner/base44/shared/runner.ts
--- runner-base/base44/shared/runner.ts	1970-01-01 00:00:00.000000000 +0000
+++ runner/base44/shared/runner.ts	2026-11-17 22:36:06.242176767 +0000
@@ -0,0 +1,110 @@
+// GROKBOT RUNNER KEY (Edwin 18 Nov 2026, brief "Bridge runner key + image function"): routine jobs (midnight articles,
+// 5am Copy fix sweep, sgcarworkshop sweep, daily builds, IndexNow resends, area pages) move to an API runner on the
+// Grok Bot box. Every Bluehost read and write still goes through the Bridge, with key scope 'runner':
+//   - list / read live files, write_file / write_files (the base sha256 compare-and-swap, verified backup and live
+//     guard of writeFile apply as for every caller), sitemap.xml + llms.txt rebuild, IndexNow submit (the key file is
+//     found on the server and never returned), Controller Copy fix issues + tap counts (read only), the Controller
+//     article_last_* fields, and generateArticleImage (Base44 image -> hero, card and og:image files on Bluehost).
+//   - NOT: deletes, .htaccess (the htaccess tool is session-only), credentials (secret names/content are refused by
+//     writeFile), the database, Bridge config, keys, restore, sync, drops, needs-you, Base44 Publish.
+//   - Only the sites named in RUNNER_SITES. Cleanic and ContiExpert stay frozen (articles only) through the live guard.
+//   - Every runner call (allowed or refused) gets a BridgeLog row with label 'grokbot-runner'.
+import { SITES } from './bridgeConfig.ts';
+import { AUTO_SITEMAP_CLIENT_FOLDERS } from './liveGuard.ts';
+import { BridgeError, normalizeRel } from './bridgeOps.ts';
+import { autoSitemapAfter, findIndexNowKey, sendIndexNow } from './autoSitemapRun.ts';
+import { INDEXNOW_MAX_URLS } from './autoSitemap.ts';
+import { signedControllerCall } from './crawlerLogs.ts';
+
+export const RUNNER_LABEL = 'grokbot-runner';
+export const RUNNER_ACTOR_EMAIL = 'grokbot-runner (runner key)';
+
+// Named client sites (Edwin 18 Nov 2026). A site added to SITES later does NOT join the runner until it is named here.
+// 'pageone' covers pageonesingapore.com and the client folders under preview/ (ContiExpert = preview/contiexpert/,
+// frozen: articles only, enforced by the live guard for every caller).
+export const RUNNER_SITES: readonly string[] = Object.freeze([
+  'sggarage', 'cleanic', 'alicia', 'danny', 'sofacare', 'pageone', 'ktech', 'benzworld', 'lilian', 'carzy',
+  'hybridworld', 'autoseo', 'ecumats', 'apcar', 'jayven', 'urbaneco', 'snapsg',
+]);
+
+// Bridge actions the runner key may run. 'list'/'read' = bridgeListLive/bridgeList and bridgeReadLive/bridgeRead,
+// 'write' = bridgeWrite, 'write_many' = bridgeWriteMany. bridgeHtaccess also says 'write' but is session-only, which is
+// checked before the scope, so a key can never reach it.
+export const RUNNER_KEY_ACTIONS: ReadonlySet<string> = new Set([
+  'list', 'read', 'write', 'write_many', 'runner_sitemap', 'runner_indexnow', 'runner_controller', 'runner_image',
+]);
+
+const bare = (h: string) => h.toLowerCase().replace(/^www\./, '');
+
+// sitemap.xml + llms.txt rebuild for pages already on the server (e.g. after a write whose autoSitemap step failed,
+// or a resend). Same code as the step that runs after every write: merges only, never drops a URL, writes through
+// writeFile (base sha, backup, live guard, HOLD), then sends IndexNow for those pages.
+export async function runnerSitemap(body: any, ctx: { base44: any }) {
+  const list = Array.isArray(body?.paths) ? body.paths : [];
+  if (!list.length || list.length > 20) throw new BridgeError('paths must list 1-20 .html pages already on the site', 400);
+  const paths = list.map((p: unknown) => normalizeRel(p));
+  const bad = paths.find((p: string) => !/\.html?$/i.test(p));
+  if (bad) throw new BridgeError('only .html pages: ' + bad, 400);
+  return { site: body.site, paths, autoSitemap: await autoSitemapAfter({ site: body.site, written: paths.map((path: string) => ({ path })), dryRun: body?.dry_run === true, base44: ctx.base44 }) };
+}
+
+// Where a site's IndexNow key file lives: the site root, or (pageone) the client folder whose domain the URL is on.
+export function indexNowGroups(site: string): { prefix: string; domain: string }[] {
+  if (!(site in SITES)) return [];
+  if (site !== 'pageone') return [{ prefix: '', domain: SITES[site as keyof typeof SITES].domain }];
+  return [{ prefix: '', domain: SITES.pageone.domain },
+    ...Object.entries(AUTO_SITEMAP_CLIENT_FOLDERS).map(([f, d]) => ({ prefix: 'preview/' + f + '/', domain: d }))];
+}
+
+// IndexNow submit. The Bridge finds the site's key file on the server (a 32-hex .txt whose content is its own name)
+// and sends it to api.indexnow.org; the key is never returned or logged. URLs must be https on that site's own domain.
+export async function runnerIndexNow(body: any) {
+  const site = String(body?.site || '');
+  const urls = Array.isArray(body?.urls) ? body.urls.map((u: unknown) => String(u || '').trim()) : [];
+  if (!urls.length || urls.length > INDEXNOW_MAX_URLS) throw new BridgeError('urls must list 1-' + INDEXNOW_MAX_URLS + ' https URLs', 400);
+  const groups = indexNowGroups(site);
+  const byGroup = new Map<string, { prefix: string; host: string; urls: string[] }>();
+  for (const u of urls) {
+    let url: URL;
+    try { url = new URL(u); } catch { throw new BridgeError('not a URL: ' + u.slice(0, 120), 400); }
+    if (url.protocol !== 'https:' || url.username || url.password || url.port) throw new BridgeError('URL must be plain https: ' + u.slice(0, 120), 400);
+    const g = groups.find((x) => bare(x.domain) === bare(url.hostname));
+    if (!g) throw new BridgeError('URL is not on a domain of site ' + site + ': ' + u.slice(0, 120), 403);
+    const k = g.prefix + '|' + url.hostname.toLowerCase();
+    const cur = byGroup.get(k) || { prefix: g.prefix, host: url.hostname.toLowerCase(), urls: [] };
+    if (!cur.urls.includes(url.href)) cur.urls.push(url.href);
+    byGroup.set(k, cur);
+  }
+  const results: any[] = [];
+  for (const g of byGroup.values()) {
+    const key = await findIndexNowKey(site, g.prefix);
+    if (!key) { results.push({ host: g.host, status: 'skipped', reason: 'no IndexNow key file in the site folder', urls: g.urls.length }); continue; }
+    results.push({ host: g.host, ...(await sendIndexNow(g.host, key, g.urls)) });
+  }
+  const st = (s: string) => results.some((r) => r.status === s);
+  return { site, status: st('error') ? 'error' : st('sent') ? (st('skipped') ? 'partial' : 'sent') : 'skipped', results };
+}
+
+// Controller reads and the article_last_* update, through the Controller's runnerFeed function (signed with the
+// Bridge's pinned key, like articleFeed; the Controller app is private and the apps share no secret).
+export async function runnerController(body: any, ctx: { base44: any }) {
+  const op = String(body?.op || '');
+  if (!['copy_fix', 'taps', 'article_last'].includes(op)) throw new BridgeError('op must be copy_fix, taps or article_last', 400);
+  const clip = (v: unknown, n: number) => String(v ?? '').replace(/[\u0000-\u001f\u007f]/g, ' ').trim().slice(0, n);
+  const payload: Record<string, unknown> = { purpose: 'grokbot_runner', op };
+  if (op === 'article_last') {
+    payload.slug = clip(body?.slug, 80); payload.date = clip(body?.date, 10); payload.title = clip(body?.title, 200); payload.url = clip(body?.url, 400);
+    if (!/^[a-z0-9][a-z0-9-]{1,79}$/.test(String(payload.slug))) throw new BridgeError('slug must be the Controller client slug', 400);
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(payload.date))) throw new BridgeError('date must be YYYY-MM-DD (SGT)', 400);
+    if (!payload.title) throw new BridgeError('title is required', 400);
+    if (!/^https:\/\//.test(String(payload.url))) throw new BridgeError('url must be https', 400);
+  } else if (body?.site !== undefined && body?.site !== null && body?.site !== '') {
+    payload.site = clip(body.site, 80);
+  }
+  let out: any;
+  try { out = await signedControllerCall(ctx.base44, 'runnerFeed', payload, 90_000); }
+  catch (e) { throw new BridgeError(String(e instanceof Error ? e.message : e).slice(0, 300), 502); }
+  if (!out || out.ok !== true) throw new BridgeError('Controller: ' + String(out?.error || 'no answer').slice(0, 200), 502);
+  const { ok: _ok, ...rest } = out;
+  return { op, ...rest };
+}
diff -ruN '--exclude=node_modules' '--exclude=dist' runner-base/base44/shared/runnerImage.ts runner/base44/shared/runnerImage.ts
--- runner-base/base44/shared/runnerImage.ts	1970-01-01 00:00:00.000000000 +0000
+++ runner/base44/shared/runnerImage.ts	2026-11-17 22:36:06.242239405 +0000
@@ -0,0 +1,123 @@
+// generateArticleImage (Edwin 18 Nov 2026, Grok Bot runner brief): one Base44 image per article (Base44 makes every image),
+// placed on Bluehost through the Bridge as three files next to each other in the site's article image folder:
+//   <slug>.webp      hero  1536x1024 (3:2)
+//   <slug>-card.webp card  768x512   (3:2)
+//   <slug>-og.jpg    og:image / twitter:image 1200x630 (JPEG for the widest link-preview support)
+// Each file is NEW and written by writeFile (HOLD, live guard, frozen-site rule, verify). An existing file is never
+// replaced: a second call for the same site+folder+slug returns the saved result (cached) and makes no new image.
+// Same daily limits as hero_image (shared counters): 3 per site and 40 in total per Singapore day.
+// If the resize library cannot load, the original image is written once as <slug>.<ext> and all three URLs point to it
+// (warning returned), so an article is never blocked by the resizer.
+import { BridgeError, liveUrl, writeFile } from './bridgeOps.ts';
+import { base44Image, fetchImage, readState, writeState, sgtNow, NO_TEXT } from './heroImage.ts';
+
+const STATE_ENTITY = 'PageOnePublishState';
+const LIMIT_PER_SITE_PER_DAY = 3;
+const LIMIT_TOTAL_PER_DAY = 40;
+const FOLDER_RE = /^[a-z0-9][a-z0-9_-]*(\/[a-z0-9][a-z0-9_-]*){0,5}$/;
+const FOLDER_END = /(^|\/)(images|img|assets|uploads|articles|media|hero)$/;
+const STYLE = 'Photorealistic editorial photo for a Singapore or Malaysia local-business article, realistic everyday setting that matches the scene.';
+const PROMPT_BAN = /\b(our (client|customer|team|technician|shop|workshop)|testimonial|before and after|logo|certified|licensed|guarantee|award)\b|\$\s?\d|RM\s?\d/i;
+const CLAIM_ALT = /\b(our (client|customer|team|technician|job|work)|real (job|photo|customer)|actual (job|customer)|before and after|testimonial)\b/i;
+
+// Default article image folder per site when the caller sends none. Cleanic is WordPress: dated uploads folder.
+function defaultFolder(site: string, y: string, m: string): string {
+  if (site === 'cleanic') return `wp-content/uploads/${y}/${m}`;
+  if (site === 'alicia') return 'assets/articles';
+  return 'images/articles';
+}
+
+// The public URL: a pageone client folder is served on the client's own domain (preview/<folder>/ -> https://<domain>/).
+async function publicUrl(site: string, rel: string): Promise<string> {
+  if (site === 'pageone') {
+    const m = /^preview\/([a-z0-9-]+)\/(.+)$/.exec(rel);
+    if (m) {
+      const { AUTO_SITEMAP_CLIENT_FOLDERS } = await import('./liveGuard.ts');
+      const d = (AUTO_SITEMAP_CLIENT_FOLDERS as Record<string, string>)[m[1]];
+      if (d) return 'https://' + d + '/' + m[2];
+    }
+  }
+  return liveUrl(site, rel);
+}
+
+async function counts(base44: any, date: string, site: string) {
+  const rows = await base44.asServiceRole.entities[STATE_ENTITY].list('-created_date', 400).catch(() => []);
+  let total = 0, perSite = 0;
+  for (const r of rows || []) {
+    const k = String(r.key || '');
+    if (!k.startsWith('hero:')) continue;
+    let v: any = {}; try { v = JSON.parse(r.value || '{}'); } catch { /* ignore */ }
+    if (v.generated_on !== date) continue;
+    total++; if (k.startsWith('hero:' + site + ':')) perSite++;
+  }
+  return { total, perSite };
+}
+
+type Out = { kind: 'hero' | 'card' | 'og'; rel: string; bytes: Uint8Array; w: number; h: number; format: string };
+
+async function variants(src: Uint8Array, base: string, ext: string): Promise<{ files: Out[]; warning?: string }> {
+  try {
+    const { Image } = await import('npm:imagescript@1.3.0');
+    const img: any = await Image.decode(src);
+    const make = async (w: number, h: number, as: 'webp' | 'jpg', q: number) => {
+      const c = img.clone().cover(w, h);
+      return as === 'webp' ? await c.encodeWEBP(q) : await c.encodeJPEG(q);
+    };
+    return { files: [
+      { kind: 'hero', rel: base + '.webp', bytes: await make(1536, 1024, 'webp', 80), w: 1536, h: 1024, format: 'webp' },
+      { kind: 'card', rel: base + '-card.webp', bytes: await make(768, 512, 'webp', 78), w: 768, h: 512, format: 'webp' },
+      { kind: 'og', rel: base + '-og.jpg', bytes: await make(1200, 630, 'jpg', 84), w: 1200, h: 630, format: 'jpg' },
+    ] };
+  } catch (e) {
+    const msg = (e instanceof Error ? e.message : String(e)).slice(0, 120);
+    return { files: [{ kind: 'hero', rel: base + '.' + ext, bytes: src, w: 0, h: 0, format: ext }], warning: 'resize unavailable (' + msg + '): one original file is used for hero, card and og:image' };
+  }
+}
+
+// body: { site, slug, prompt, alt?, folder?, landscape? }
+export async function generateArticleImage(body: any, ctx: { base44: any }) {
+  const { base44 } = ctx;
+  const site = String(body?.site || '');
+  const now = sgtNow();
+  const slug = String(body?.slug || '');
+  if (!/^[a-z0-9][a-z0-9-]{2,79}$/.test(slug)) throw new BridgeError('slug must be lowercase-hyphen, 3-80 chars', 400);
+  const sent = typeof body?.folder === 'string' ? body.folder.trim().replace(/^\/+|\/+$/g, '') : '';
+  if (sent && (sent.includes('..') || !FOLDER_RE.test(sent) || !FOLDER_END.test(sent))) throw new BridgeError('folder must be a lowercase site folder ending in images, img, assets, uploads, articles, media or hero (e.g. images/articles or preview/aivs/images/articles)', 400);
+  if (site === 'pageone' && sent && sent.startsWith('preview/') && !/^preview\/[a-z0-9-]+\//.test(sent)) throw new BridgeError('folder under preview/ must name the client folder', 400);
+  const folder = sent || defaultFolder(site, now.y, now.m);
+  const prompt = String(body?.prompt || '').replace(/\s+/g, ' ').trim();
+  if (prompt.length < 20 || prompt.length > 400) throw new BridgeError('prompt must be 20-400 characters: describe the picture, not the article', 400);
+  if (PROMPT_BAN.test(prompt)) throw new BridgeError(`prompt contains something not allowed (${String(prompt.match(PROMPT_BAN)?.[0])}). Describe a plain scene.`, 400);
+  let alt = String(body?.alt || '').replace(/\s+/g, ' ').trim();
+  if (!alt) { alt = 'Illustrative photo: ' + prompt; if (alt.length > 125) alt = alt.slice(0, 125).replace(/\s+\S*$/, ''); }
+  if (alt.length < 20 || alt.length > 125) throw new BridgeError('alt must be 20-125 characters', 400);
+  if (!alt.toLowerCase().startsWith('illustrative')) throw new BridgeError('alt must start with "Illustrative" (AI picture on a real business site)', 400);
+  if (CLAIM_ALT.test(alt)) throw new BridgeError('alt must not claim a real job, client or team', 400);
+
+  const key = `hero:${site}:runner:${folder}:${slug}`;
+  const prev = await readState(base44, key);
+  if (prev?.stage === 'done') return { ...prev.result, cached: true };
+
+  let gatewayUrl = prev?.stage === 'generated' ? String(prev.gateway_url || '') : '';
+  if (!gatewayUrl) {
+    const c = await counts(base44, now.date, site);
+    if (c.total >= LIMIT_TOTAL_PER_DAY || c.perSite >= LIMIT_PER_SITE_PER_DAY) throw new BridgeError(`daily article image limit reached (${c.perSite} for ${site}, ${c.total} in total today)`, 429);
+    gatewayUrl = await base44Image(base44, `${STYLE} Scene: ${prompt}. Photorealistic, natural light, high detail. ${NO_TEXT}`, body?.landscape !== false);
+    // Saved at once so a retry after a hosting failure does not pay for a second image.
+    await writeState(base44, key, prev, { stage: 'generated', gateway_url: gatewayUrl, generated_on: now.date, scene: prompt });
+  }
+  const img = await fetchImage(gatewayUrl);
+  const { files, warning } = await variants(img.bytes, folder + '/' + slug, img.ext);
+  const placed: Record<string, any> = {};
+  for (const f of files) {
+    const r: any = await writeFile(site, f.rel, f.bytes, undefined);
+    if (!r?.saved && !r?.unchanged) throw new BridgeError('could not write ' + f.rel, 502);
+    placed[f.kind] = { url: await publicUrl(site, f.rel), path: '/' + f.rel, width: f.w || img.w || null, height: f.h || img.h || null, format: f.format, bytes: f.bytes.length };
+  }
+  if (!placed.card) placed.card = placed.hero;
+  if (!placed.og) placed.og = placed.hero;
+  const result = { site, folder, slug, alt, hero_url: placed.hero.url, card_url: placed.card.url, og_image_url: placed.og.url,
+    files: placed, generated_on: now.date, model: 'Base44 GenerateImage', warnings: warning ? [warning] : [] };
+  await writeState(base44, key, await readState(base44, key), { stage: 'done', gateway_url: gatewayUrl, generated_on: now.date, scene: prompt, result });
+  return { ...result, cached: false };
+}
