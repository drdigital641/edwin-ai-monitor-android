+import sitesFn from '../base44/functions/bridgeSites/entry.ts';
+import guideFn from '../base44/functions/bridgeGuide/entry.ts';
+import noteFn from '../base44/functions/bridgeNote/entry.ts';
+import claimFn from '../base44/functions/bridgeClaim/entry.ts';
+import syncFn from '../base44/functions/bridgeSync/entry.ts';
+import backupsFn from '../base44/functions/bridgeBackups/entry.ts';
+import htaccessFn from '../base44/functions/bridgeHtaccess/entry.ts';
+import heroFn from '../base44/functions/bridgeHeroImage/entry.ts';
+import gateFn from '../base44/functions/bridgeImageGate/entry.ts';
+import needsFn from '../base44/functions/bridgeNeedsYou/entry.ts';
+import needsListFn from '../base44/functions/bridgeNeedsList/entry.ts';
+import dropPutFn from '../base44/functions/bridgeDropPut/entry.ts';
+import dropPublishFn from '../base44/functions/bridgeDropPublish/entry.ts';
+import crawlerFn from '../base44/functions/bridgeCrawlerLogs/entry.ts';
+import sitemapFn from '../base44/functions/bridgeRunnerSitemap/entry.ts';
+import indexNowFn from '../base44/functions/bridgeRunnerIndexNow/entry.ts';
+import controllerFn from '../base44/functions/bridgeRunnerController/entry.ts';
+import imageFn from '../base44/functions/generateArticleImage/entry.ts';
+import { Image } from 'npm:imagescript@1.3.0';
+
+const HOME = '/home3/sgmodde1', ROOT = HOME + '/public_html', PAGEONE = ROOT + '/pageone', PRIV = HOME + '/bluehost-bridge-private';
+const MAISON = PAGEONE + '/preview/maison-interior-design';
+const files = new Map<string, Uint8Array>();
+const dirs = new Set<string>([HOME, ROOT, PAGEONE, PAGEONE + '/preview', MAISON, MAISON + '/images', ROOT + '/cleanic', PRIV, PRIV + '/backups', HOME + '/backups-private']);
+const latin1 = (b: Uint8Array) => { let s = ''; for (const c of b) s += String.fromCharCode(c); return s; };
+const ok = (data: any) => Response.json({ result: { status: 1, errors: null, data } });
+const parentOf = (p: string) => p.slice(0, p.lastIndexOf('/'));
+const uploads: string[] = [];
+globalThis.fetch = (async (input: any, init: any = {}) => {
+  const url = new URL(String(input));
+  if (url.pathname.startsWith('/execute/')) {
+    const fn = url.pathname.slice(9), q = url.searchParams;
+    if (fn === 'DomainInfo/domains_data') return ok({ main_domain: { domain: 'sggarage.com', documentroot: ROOT },
+      addon_domains: [{ domain: 'pageonesingapore.com', documentroot: PAGEONE }, { domain: 'cleanicdetailing.com', documentroot: ROOT + '/cleanic' }], sub_domains: [], parked_domains: [] });
+    if (fn === 'Fileman/get_file_information') {
+      const p = q.get('path')!;
+      if (files.has(p)) return ok({ exists: 1, mode: 0o100644, size: files.get(p)!.length, mtime: 1 });
+      if (dirs.has(p)) return ok({ exists: 1, mode: 0o040755, size: 4096, mtime: 1 });
+      return Response.json({ result: { status: 0, errors: ['The file is not available'] } });
+    }
+    if (fn === 'Fileman/list_files') {
+      const d = q.get('dir')!; if (!dirs.has(d)) return Response.json({ result: { status: 0, errors: ['No such directory'] } });
+      const rows: any[] = [];
+      for (const f of files.keys()) if (parentOf(f) === d) rows.push({ file: f.slice(d.length + 1), type: 'file', size: files.get(f)!.length });
+      for (const x of dirs) if (x !== d && parentOf(x) === d) rows.push({ file: x.slice(d.length + 1), type: 'dir' });
+      return ok(rows);
+    }
+    if (fn === 'Fileman/get_file_content') {
+      const b = files.get(q.get('dir') + '/' + q.get('file'));
+      return b ? ok({ content: latin1(b) }) : Response.json({ result: { status: 0, errors: ['No such file'] } });
+    }
+    if (fn === 'Fileman/upload_files') {
+      const form = init.body as FormData; const dir = String(form.get('dir')); const f = form.get('file-1') as File;
+      if (!dirs.has(dir)) return Response.json({ result: { status: 0, errors: ['no dir'] } });
+      files.set(dir + '/' + f.name, new Uint8Array(await f.arrayBuffer())); uploads.push(dir + '/' + f.name);
+      return ok({ succeeded: 1 });
+    }
+  }
+  if (url.pathname === '/json-api/cpanel') {
+    const p = new URLSearchParams(String(init.body)); const fn = p.get('cpanel_jsonapi_func')!;
+    const res = (data: any[]) => Response.json({ cpanelresult: { event: { result: 1 }, data } });
+    if (fn === 'mkdir') { const d = p.get('path') + '/' + p.get('name'); if (!dirs.has(p.get('path')!)) return res([{ result: 0, reason: 'no parent' }]); dirs.add(d); return res([{ result: 1 }]); }
+    if (fn === 'fileop' && p.get('op') === 'copy') { files.set(p.get('destfiles')!, files.get(p.get('sourcefiles')!)!.slice()); return res([{ result: 1 }]); }
+    if (fn === 'fileop' && p.get('op') === 'chmod') return res([{ result: 1 }]);
+  }
+  return new Response('unexpected ' + url, { status: 500 });
+}) as typeof fetch;
+
+// ---- fake Base44 entities (equality filter, newest first) ----
+const tables: Record<string, any[]> = {};
+let seq = 0;
+const table = (name: string) => (tables[name] ??= []);
+const match = (r: any, q: any) => Object.entries(q).every(([k, v]) => r[k] === v);
+const entity = (name: string) => ({
