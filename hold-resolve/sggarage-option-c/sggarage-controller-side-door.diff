+export const ROLLBACK_REMOVES = new Set<string>();
+
+export function sideDoorMessage(what: string, path: string, why = '') {
+  return 'SG GARAGE SIDE DOOR CLOSED: ' + what + ' ' + path + ' refused on this FTP controller' + (why ? ' (' + why + ')' : '')
+    + '. Nothing was changed. Deletes, renames, folder removal, SITE commands and protected HTML changes on sggarage.com go through the Bluehost Bridge.';
+}
