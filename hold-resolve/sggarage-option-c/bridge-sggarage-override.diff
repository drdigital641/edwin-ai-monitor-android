+  await ok('sitemap.xml with xhtml:link alternates', g('sggarage', 'sitemap.xml', XML(), XML('<url><loc>https://www.sggarage.com/b/</loc><xhtml:link xmlns:xhtml="http://www.w3.org/1999/xhtml" rel="alternate" hreflang="en" href="https://www.sggarage.com/b/"/></url>')));
+  await ok('sitemap.txt', g('sggarage', 'sitemap.txt', 'https://www.sggarage.com/\n', 'https://www.sggarage.com/\nhttps://www.sggarage.com/articles/c.html\n'));
+  await ok('llms.txt', g('sggarage', 'llms.txt', '# SG Garage\n', '# SG Garage\n- Featured: /articles/c.html\n'));
+  await ok('article-cards.json (card added at the top, one title edited)', g('sggarage', 'article-cards.json', LIVE_CARDS, NEW_CARDS));
+});
+
+Deno.test('sggarage publisher: sitemap.xml with active content or no URLs refused (d1f0dbf3d hardening)', async () => {
+  await no('sitemap.xml <script>', g('sggarage', 'sitemap.xml', XML(), XML('<script>x</script>')), /element <script> is not allowed/);
+  await no('sitemap.xml <xhtml:iframe>', g('sggarage', 'sitemap.xml', XML(), XML('<xhtml:iframe/>')), /element <xhtml:iframe> is not allowed/);
