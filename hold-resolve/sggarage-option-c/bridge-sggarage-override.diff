+Deno.test('sggarage publisher: article-cards.json strict shape', async () => {
+  const bad: [string, string, RegExp][] = [
+    ['not JSON', '[{"href":', /not valid JSON/],
+    ['object, not array', '{"cards":[]}', /must be a JSON array/],
+    ['empty array', '[]', /1 to 5000 cards/],
+    ['extra key', JSON.stringify([{ ...card('a'), img: 'x.jpg' }, card('b')]), /exactly href, cat and title/],
+    ['missing key', JSON.stringify([{ href: '/articles/a.html', title: 't' }, card('b')]), /exactly href, cat and title/],
+    ['__proto__ key', '[{"href":"/articles/a.html","cat":"c","title":"t","__proto__":{"x":1}},' + JSON.stringify(card('b')) + ']', /exactly href, cat and title/],
+    ['number title', JSON.stringify([{ href: '/articles/a.html', cat: 'c', title: 5 }, card('b')]), /must be strings/],
+    ['card is a string', JSON.stringify(['x', card('a'), card('b')]), /is not an object/],
+    ['href off-site', JSON.stringify([{ ...card('a'), href: 'https://evil.example/a.html' }, card('b')]), /is not \/articles\/<slug>.html/],
+    ['href ../', JSON.stringify([{ ...card('a'), href: '/articles/../index.html' }, card('b')]), /is not \/articles\/<slug>.html/],
+    ['href javascript:', JSON.stringify([{ ...card('a'), href: 'javascript:alert(1)' }, card('b')]), /javascript: is not allowed/],
+    ['javascript: hidden with \\u escapes', '[{"href":"/articles/a.html","cat":"c","title":"\\u006aavascript:x"},' + JSON.stringify(card('b')) + ']', /javascript: is not allowed/],
+    ['title with HTML', JSON.stringify([{ ...card('a'), title: '<img src=x onerror=alert(1)>' }, card('b')]), /no < > or control/],
+    ['cat with control character', JSON.stringify([{ ...card('a'), cat: 'a\u0007' }, card('b')]), /no < > or control/],
+    ['empty title', JSON.stringify([{ ...card('a'), title: ' ' }, card('b')]), /title must be 1-300/],
+    ['duplicate href', JSON.stringify([card('a'), card('a'), card('b')]), /appears twice/],
+    ['drops a live card', JSON.stringify([card('a'), card('c')]), /would drop 1 live card/],
+  ];
+  for (const [label, text, m] of bad) await no('article-cards.json ' + label, g('sggarage', 'article-cards.json', LIVE_CARDS, text), m);
+  if (articleCardsProblem(enc(JSON.stringify([card('a')])), undefined) !== null) throw new Error('a clean list with no live file should pass');
+  if (articleCardsProblem(enc(new Array(5001).fill(0).map((_, i) => card('s' + i)).length ? JSON.stringify(new Array(5001).fill(0).map((_, i) => card('s' + i))) : '')) === null) throw new Error('5001 cards should fail');
+  console.log('ok       clean list without a live file passes; 5001 cards refused');
+});
