+  await no('sitemap.xml wrong root', g('sggarage', 'sitemap.xml', XML(), '<html><loc>https://x.sg/</loc></html>'), /not <urlset>/);
+  await no('sitemap.txt non-URL line', g('sggarage', 'sitemap.txt', 'https://www.sggarage.com/\n', 'https://www.sggarage.com/\n<script>\n'), /not an https URL/);
+  await no('sitemap.txt empty', g('sggarage', 'sitemap.txt', 'https://www.sggarage.com/\n', '\n'), /0 URLs/);
+  await no('llms.txt empty', g('sggarage', 'llms.txt', '# a\n', '  \n'), /llms.txt is empty/);
