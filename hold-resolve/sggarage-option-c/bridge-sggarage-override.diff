+// SG Garage generated-file override (DRAFT, "SG GARAGE OPTION C 1114-2335"). Run:
+// deno test --no-check -A --import-map tests/importmap.json tests/sggGeneratedOverride.test.ts
+// Pure guard calls with fake live states: never touches a live site.
+import { liveGuard, articleCardsProblem, SGG_OVERRIDE_WRITERS, SGG_GENERATED_PATH, GENERATED_OVERRIDE_SITES } from '../base44/shared/liveGuard.ts';
+import { writeBlockedReason, SITE_HOLDS } from '../base44/shared/bridgeConfig.ts';
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const sha256 = async (b: Uint8Array) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', b))).map((x) => x.toString(16).padStart(2, '0')).join('');
+const present = (s: string) => ({ state: 'present' as const, bytes: enc(s) });
+const g = (site: string, rel: string, liveText: string, newText: string, publisher = true) =>
+  liveGuard({ site, rel, op: 'write', live: present(liveText), newBytes: enc(newText), overrides: [], sha256, publisher });
+const ok = async (label: string, p: Promise<string | null>) => { const r = await p; if (r !== null) throw new Error(label + ': expected allowed, got: ' + r); console.log('allowed  ' + label); };
+const no = async (label: string, p: Promise<string | null>, m: RegExp) => { const r = await p; if (r === null || !m.test(r)) throw new Error(label + ': expected refusal ' + m + ', got: ' + r); console.log('refused  ' + label); };
+
+const NS = 'xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"';
+const XML = (extra = '') => `<?xml version="1.0" encoding="UTF-8"?>\n<urlset ${NS}><url><loc>https://www.sggarage.com/</loc></url>${extra}</urlset>\n`;
+const card = (slug: string, cat = 'Car Servicing', title = 'Title ' + slug) => ({ href: '/articles/' + slug + '.html', cat, title });
+const LIVE_CARDS = JSON.stringify([card('a'), card('b', 'BMW', 'BMW X3 Brake Service: Cost, Interval & What Gets Checked')], null, 4);
+const NEW_CARDS = JSON.stringify([card('c', 'Maintenance', 'Car Engine Knocking Noise? “What” it means – €'), card('a'), card('b', 'BMW', 'BMW X3 brake service (edited)')], null, 4);
+
+Deno.test('settings: publisher-only, exact four root paths, Page One override list unchanged, flags unchanged', () => {
+  if (JSON.stringify(SGG_OVERRIDE_WRITERS) !== '["publisher"]') throw new Error('writers must be ["publisher"]');
+  if (JSON.stringify(GENERATED_OVERRIDE_SITES) !== '["pageone"]') throw new Error('Page One override list changed');
+  for (const p of ['sitemap.xml', 'sitemap.txt', 'llms.txt', 'article-cards.json']) if (!SGG_GENERATED_PATH.test(p)) throw new Error(p);
+  for (const p of ['articles/sitemap.xml', 'x/llms.txt', 'llms-full.txt', 'sitemap.xml.bak', 'Sitemap.xml', 'article-cards.json.txt', 'articles/article-cards.json', 'robots.txt', 'index.html'])
+    if (SGG_GENERATED_PATH.test(p)) throw new Error('path should not match: ' + p);
+  if (SITE_HOLDS.some((h) => h.on !== false)) throw new Error('flags changed');
+  console.log('ok       writers ["publisher"]; 4 exact root paths; Page One list unchanged; all 7 flags off (unchanged from 33343ea)');
+});
+
+Deno.test('sggarage publisher: the four files are replaced when the content is sane', async () => {
