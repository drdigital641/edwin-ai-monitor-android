+const MYKAR_FB_KEYS = ['date', 'image', 'width', 'height', 'caption', 'permalink', 'type'];
+const MYKAR_FB_PRICE = /\bRM\s?\d|\$\s?\d|\bonly\b|\brebates?\b|\bmonthly\b|\bdeposit\b|\bdown\s?payment\b|\binstal+ments?\b|\bbulanan\b|\bhanya\b|\bdiskaun\b|月供|首付|回扣|仅需|只需|只要|优惠价/i;
+
+export function mykarFbProblem(bytes: Uint8Array): string | null {
+  if (bytes.length > 64 * 1024) return 'fb-posts.json over 64 KB';
+  let text: string;
+  try { text = new TextDecoder('utf-8', { fatal: true }).decode(bytes); } catch { return 'not valid UTF-8 text'; }
+  if (/fbcdn/i.test(text)) return 'fbcdn URLs are not allowed (images must be self-hosted)';
+  if (/<|>|javascript\s*:|\bon[a-z]+\s*=/i.test(text)) return 'markup, javascript: or on*= handler text is not allowed';
+  let d: any;
+  try { d = JSON.parse(text.replace(/^﻿/, '')); } catch (e) { return 'not valid JSON (' + String((e as Error).message).slice(0, 80) + ')'; }
+  if (!d || typeof d !== 'object' || Array.isArray(d)) return 'must be a JSON object';
+  const top = Object.keys(d).sort().join(',');
+  if (top !== 'page,posts,updated') return 'top-level keys must be exactly page, posts, updated (got ' + top.slice(0, 80) + ')';
+  if (typeof d.page !== 'string' || !/^https:\/\/www\.facebook\.com\/[A-Za-z0-9._-]+\/?$/.test(d.page)) return 'page must be a https://www.facebook.com/<page> URL';
+  if (typeof d.updated !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(d.updated)) return 'updated must be YYYY-MM-DD';
+  if (!Array.isArray(d.posts) || d.posts.length < 1 || d.posts.length > 20) return 'posts must be an array of 1 to 20 posts';
+  for (let i = 0; i < d.posts.length; i++) {
+    const p = d.posts[i]; const n = 'post ' + (i + 1) + ': ';
+    if (!p || typeof p !== 'object' || Array.isArray(p)) return n + 'must be an object';
+    const extra = Object.keys(p).filter((k) => !MYKAR_FB_KEYS.includes(k));
+    if (extra.length) return n + 'unknown key ' + extra[0].slice(0, 40);
+    if (typeof p.date !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(p.date)) return n + 'date must be YYYY-MM-DD';
+    if (typeof p.image !== 'string' || !/^\/images\/fb\/[a-z0-9-]{1,80}\.webp$/.test(p.image)) return n + 'image must be a self-hosted /images/fb/<name>.webp path';
+    for (const k of ['width', 'height']) if (!Number.isInteger(p[k]) || p[k] < 1 || p[k] > 4000) return n + k + ' must be a whole number 1-4000';
+    if (typeof p.caption !== 'string' || p.caption.length > 400) return n + 'caption must be text of at most 400 characters';
+    if (/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/.test(p.caption)) return n + 'caption has a control character';
+    if (MYKAR_FB_PRICE.test(p.caption)) return n + 'caption quotes a price, payment or "only" (must be empty)';
+    if (typeof p.permalink !== 'string' || !/^https:\/\/www\.facebook\.com\/[A-Za-z0-9/_.?=&%-]{1,300}$/.test(p.permalink)) return n + 'permalink must be a https://www.facebook.com/ link';
+    if (!['photo', 'video', 'link'].includes(p.type)) return n + 'type must be photo, video or link';
+  }
+  return null;
+}
