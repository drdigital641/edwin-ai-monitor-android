+// MyKar weekly carousel rule (Edwin 16 Nov 2026). Pure guard calls on inline bytes; never touches a live site.
+// Run from a /tmp copy: deno test -A tests/mykarFbRule.test.ts
+import { liveGuard } from '../base44/shared/liveGuard.ts';
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const sha256 = async (b: Uint8Array) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', b as BufferSource))).map((x) => x.toString(16).padStart(2, '0')).join('');
+const g = (site: string, rel: string, next: Uint8Array, publisher = false) =>
+  liveGuard({ site, rel, op: 'write', live: { state: 'present', bytes: enc('{"page":"x","posts":[]}') }, newBytes: next, overrides: [], sha256, publisher });
+const ok = (name: string, r: string | null) => { if (r !== null) throw new Error(name + ' should pass: ' + r); };
+const no = (name: string, r: string | null, re?: RegExp) => { if (r === null) throw new Error(name + ' should be refused'); if (re && !re.test(r)) throw new Error(name + ' wrong reason: ' + r); };
+const P = 'preview/dongfeng-jb/data/fb-posts.json';
+const post = (o: Record<string, unknown> = {}) => ({ date: '2026-11-15', image: '/images/fb/mykar-fb-w20261116-1.webp', width: 809, height: 1080, caption: '',
+  permalink: 'https://www.facebook.com/reel/1685162066337170', type: 'photo', ...o });
+const doc = (posts: unknown[], o: Record<string, unknown> = {}) => enc(JSON.stringify({ page: 'https://www.facebook.com/dongfengjohorbahru/', updated: '2026-11-16', posts, ...o }, null, 2));
+
+Deno.test('mykar fb-posts.json: weekly file passes', async () => {
+  ok('basic', await g('pageone', P, doc([post(), post({ type: 'video', caption: '想问你一个有趣的问题 😊 如果两辆车的预算差不多，你会选择哪一种？ 其实…' }),
+    post({ type: 'link', caption: '🪔✨ Happy Deepavali! Selamat Menyambut Hari Deepavali! May the light of Deepavali bring hap…',
+      permalink: 'https://www.facebook.com/dongfengjohorbahru/posts/pfbid0fMPGjAwsLxTLZCp12WY48NhndtrL8gK6yrMSZbveSy2SsgvDQAEKhx3CYUjBMrd9l' })])));
+});
+
+Deno.test('mykar fb-posts.json: bad content refused', async () => {
+  no('fbcdn image', await g('pageone', P, doc([post({ image: 'https://scontent.fbcdn.net/x.jpg' })])), /fbcdn/);
+  no('remote image', await g('pageone', P, doc([post({ image: 'https://example.com/x.webp' })])), /self-hosted/);
+  no('jpg image', await g('pageone', P, doc([post({ image: '/images/fb/x.jpg' })])), /self-hosted/);
+  no('price RM', await g('pageone', P, doc([post({ caption: 'Now RM 129,800' })])), /price/);
+  no('price $', await g('pageone', P, doc([post({ caption: 'from $99' })])), /price/);
+  no('only', await g('pageone', P, doc([post({ caption: 'Only this week' })])), /price/);
+  no('monthly', await g('pageone', P, doc([post({ caption: 'low monthly payment' })])), /price/);
+  no('月供', await g('pageone', P, doc([post({ caption: '月供超低' })])), /price/);
+  no('markup', await g('pageone', P, doc([post({ caption: '<img src=x onerror=alert(1)>' })])), /markup/);
+  no('javascript permalink', await g('pageone', P, doc([post({ permalink: 'javascript:alert(1)' })])), /javascript|permalink/);
+  no('other host permalink', await g('pageone', P, doc([post({ permalink: 'https://evil.example/x' })])), /permalink/);
+  no('extra key', await g('pageone', P, doc([post({ html: 'x' })])), /unknown key/);
+  no('extra top key', await g('pageone', P, doc([post()], { script: 'x' })), /top-level/);
+  no('empty posts', await g('pageone', P, doc([])), /1 to 20/);
+  no('bad type', await g('pageone', P, doc([post({ type: 'iframe' })])), /type/);
+  no('not json', await g('pageone', P, enc('{"page":')), /not valid JSON/);
+});
+
+Deno.test('mykar rule is scoped to that one file and site', async () => {
+  const good = doc([post()]);
+  no('other json in dongfeng-jb', await g('pageone', 'preview/dongfeng-jb/data/other.json', good), /needs an override/);
+  no('same name other folder', await g('pageone', 'preview/exn-lube/data/fb-posts.json', good), /needs an override/);
+  no('same path other site', await g('sggarage', P, good), /needs an override/);
+  no('root fb-posts.json', await g('pageone', 'data/fb-posts.json', good), /needs an override/);
+  no('publisher route', await g('pageone', P, good, true), /needs an override/);
+  no('htaccess still never', await g('pageone', 'preview/dongfeng-jb/.htaccess', good), /never written/);
+});
