diff -ruN -x node_modules mk-base/tests/mykarFbRule.test.ts mk/tests/mykarFbRule.test.ts
--- mk-base/tests/mykarFbRule.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ mk/tests/mykarFbRule.test.ts	2026-11-16 04:07:11.873599273 +0000
