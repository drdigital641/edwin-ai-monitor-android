+// HERO DETECTION (22 Nov 2026 fix, Plan with Ben block): templates put the hero in different places (Page One
+// article-hero inside the prose, Ben's phero-bg BEFORE the H1, AutoSEO photo heroes), and pages end with "Related
+// pages" cards that carry OTHER articles' photos. The old rule (first <img> after the H1) skipped Ben's phero, skipped
+// the badge photos and then read the first related card (9fa8a9b970b6.webp) as the hero, so every runner article on
+// that template was refused. Order now, so the gate and every template agree:
+//   1. the <img fetchpriority="high"> outside header/nav/footer (the page's LCP hero; every template marks it),
+//   2. the first <img> with "hero" in its own class or in the class of the element that holds it,
+//   3. the old rule, but only inside the main content: header, nav, footer, aside and everything from the first
+//      related/cards block or "Related" heading onwards are ignored.
+const SKIP_IMG = /logo|icon|avatar|portrait|badge|favicon|author/i;
+function stripChrome(html: string): string {
+  return html.replace(/<(header|nav|footer|aside)\b[\s\S]*?<\/\1>/gi, ' ');
+}
+function cutRelated(html: string): string {
+  const m = html.search(/<[a-z]+\b[^>]*\bclass\s*=\s*["'][^"']*\b(acards?|related[a-z-]*|more-articles|card-grid)\b|<h[2-4]\b[^>]*>\s*(related|more articles|you may also|read next)/i);
+  return m >= 0 ? html.slice(0, m) : html;
+}
+function usable(t: string): string {
