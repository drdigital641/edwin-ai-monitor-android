+// RUNNER ARTICLE RECORDS (Edwin 22 Nov 2026, PERMANENT): some sites are rendered every hour from Base44 Article records
+// (SofaCare: autoPublishSofaCareStage at :17 in the Alicia app). A page file written straight to Bluehost is dropped from
+// the hub and sitemap by the next rebuild. For those sites the runner sends the article HERE and the Bridge creates the
+// record in the site's own Base44 app, signed with the Bridge's pinned key (the target app holds only the public key;
+// the apps share no secret). The site's next hourly publish renders the page, hub card, sitemap, llms.txt and IndexNow.
+//   POST https://blue-bridge-pilot.base44.app/functions/bridgeRunnerArticle
+//   body { site, article: {...}, hero_path?, request_id?, dry_run? }
+// The hero: send article.hero_image = an existing https://media.base44.com/... URL, OR hero_path = the JPEG that
+// generateArticleImage wrote for this slug (images/articles/<slug>.jpg); the Bridge reads it from Bluehost and the target
+// app uploads it to its own Base44 storage (media URL). All content checks run in the target app (one source of truth)
+// and come back as 422 with the list of problems; nothing is created unless every check passes.
+import { BridgeError, readLiveFile } from './bridgeOps.ts';
+import { signedAppCall } from './crawlerLogs.ts';
+
+export const ARTICLE_RECORD_SITES: Readonly<Record<string, { appId: string; fn: string; domain: string; urlOf: (slug: string) => string }>> = Object.freeze({
+  sofacare: { appId: '6a9c4351b2a32e6fb4dc814c', fn: 'runnerArticleIngest', domain: 'sofacaresg.com', urlOf: (s: string) => `https://sofacaresg.com/articles/${s}.html` },
+});
+
+const FIELDS = ['title', 'slug', 'keyword', 'h1', 'meta_description', 'excerpt', 'content', 'faqs', 'hero_image', 'hero_image_alt', 'related_service', 'published_date'];
+const clip = (v: unknown, n: number) => String(v ?? '').replace(/[\u0000-\u001f\u007f]/g, '').trim().slice(0, n);
+
+export async function runnerArticle(body: any, ctx: { base44: any }) {
+  const site = String(body?.site || '');
+  const target = ARTICLE_RECORD_SITES[site];
+  if (!target) throw new BridgeError('Article records are made only for: ' + Object.keys(ARTICLE_RECORD_SITES).join(', ') + '. For other sites write the page with bridgeWrite.', 400);
+  const a = body?.article;
+  if (!a || typeof a !== 'object' || Array.isArray(a)) throw new BridgeError('article must be an object with the Article fields', 400);
+  const article: Record<string, unknown> = {};
+  for (const f of FIELDS) if (a[f] !== undefined) article[f] = typeof a[f] === 'string' ? String(a[f]).slice(0, 60_000) : a[f];
+  const slug = String(article.slug || '');
+  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug) || slug.length > 60) throw new BridgeError('article.slug must be lowercase-hyphen, at most 60 characters', 400);
+  let hero_b64: string | undefined, hero_name: string | undefined;
+  if (body?.hero_path !== undefined && body?.hero_path !== null && body?.hero_path !== '') {
+    const rel = String(body.hero_path).replace(/^\/+/, '');
+    if (!new RegExp(`^images/articles/${slug}\\.(jpg|jpeg|png|webp)$`).test(rel)) throw new BridgeError(`hero_path must be images/articles/${slug}.jpg (the file generateArticleImage made for this slug)`, 400);
+    const f: any = await readLiveFile(site, rel);
+    if (!f?.content_base64) throw new BridgeError('hero_path is not an image file', 400);
+    if (f.content_base64.length > 2_800_000) throw new BridgeError('hero image over 2 MB', 400);
+    hero_b64 = f.content_base64; hero_name = rel.split('/').pop();
+  } else if (!/^https:\/\/media\.base44\.com\//.test(String(article.hero_image || ''))) {
+    throw new BridgeError('send hero_path (images/articles/<slug>.jpg from generateArticleImage) or article.hero_image (an https://media.base44.com/ URL)', 400);
+  }
+  const payload: Record<string, unknown> = {
+    purpose: 'runner_article', site, request_id: clip(body?.request_id, 80) || crypto.randomUUID(),
+    dry_run: body?.dry_run === true, article, ...(hero_b64 ? { hero_b64, hero_name } : {}),
+  };
+  let r: { status: number; json: any };
+  try { r = await signedAppCall(ctx.base44, target.appId, target.fn, payload, 90_000); }
+  catch (e) { throw new BridgeError('Site app not reachable: ' + String(e instanceof Error ? e.message : e).slice(0, 200), 502); }
+  const j = r.json || {};
+  if (r.status >= 400 || j.ok !== true) {
+    const err = new BridgeError(String(j.error || 'refused').slice(0, 300) + (Array.isArray(j.problems) && j.problems.length ? ': ' + j.problems.slice(0, 12).join('; ').slice(0, 1500) : ''), r.status >= 400 && r.status < 500 ? r.status : 502);
+    throw err;
+  }
+  const { ok: _ok, ...rest } = j;
+  return { site, slug, url: target.urlOf(slug), ...rest };
+}
