+// RUNNER ARTICLE RECORDS (22 Nov 2026): the same pinned-key signature, sent to another of Edwin's Base44 apps
+// (e.g. SofaCare SG) whose function verifies it with the public key only. Returns the HTTP status and JSON, so the
+// caller can pass a 4xx validation answer straight back to the runner.
+export async function signedAppCall(base44: any, appId: string, fn: string, payload: Record<string, unknown>, timeoutMs = 60_000): Promise<{ status: number; json: any }> {
+  if (!/^[a-f0-9]{24}$/.test(appId) || !/^[A-Za-z0-9_]+$/.test(fn)) throw new Error('bad app or function name');
+  const { key, kid } = await signingKey(base44);
+  const body = JSON.stringify({ ...payload, sent_at: new Date().toISOString() });
+  const sig = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, key, new TextEncoder().encode(body));
+  const res = await fetch('https://base44.app/api/apps/' + appId + '/functions/' + fn, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ payload: body, sig: b64u(sig), kid }), signal: AbortSignal.timeout(timeoutMs),
+  });
+  const text = await res.text();
+  let json: any = null; try { json = JSON.parse(text); } catch { json = { ok: false, error: text.slice(0, 200) }; }
+  return { status: res.status, json };
+}
