diff -ruN a/tests/sggNoLiveGuard.test.ts b/tests/sggNoLiveGuard.test.ts
--- a/tests/sggNoLiveGuard.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/sggNoLiveGuard.test.ts	2026-11-14 15:38:04.946212510 +0000
@@ -0,0 +1,63 @@
+// SG Garage live guard OFF ("SG GARAGE UNLOCK DIFF UPDATE 1114-2325", 14 Nov 2026). Run:
+// deno test --no-check -A --import-map tests/importmap.json tests/sggNoLiveGuard.test.ts
+// Pure guard calls with fake live states: never touches a live site.
+import { liveGuard, NO_LIVE_GUARD_SITES } from '../base44/shared/liveGuard.ts';
+import { writeBlockedReason, SITE_HOLDS } from '../base44/shared/bridgeConfig.ts';
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const sha256 = async (b: Uint8Array) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', b))).map((x) => x.toString(16).padStart(2, '0')).join('');
+const present = (s: string) => ({ state: 'present' as const, bytes: enc(s) });
+const g = (site: string, rel: unknown, live: any, newText: string, publisher = false) =>
+  liveGuard({ site, rel, op: 'write', live, newBytes: enc(newText), overrides: [], sha256, publisher });
+const ok = async (label: string, p: Promise<string | null>) => { const r = await p; if (r !== null) throw new Error(label + ': expected allowed, got: ' + r); console.log('allowed  ' + label); };
+const no = async (label: string, p: Promise<string | null>, m: RegExp) => { const r = await p; if (r === null || !m.test(r)) throw new Error(label + ': expected refusal ' + m + ', got: ' + r); console.log('refused  ' + label); };
+
+const PAGE = (title: string, faq: string, ld: string) => `<!doctype html><html><head><title>${title}</title><meta name="description" content="d">`
+  + `<script type="application/ld+json">{"@type":"AutoRepair","telephone":"${ld}"}</script></head><body><h1>H</h1>`
+  + `<div class="faq"><h3>${faq}</h3></div><footer><a href="https://g.page/r/x/review">Leave us a Google review</a></footer></body></html>`;
+const OLD = PAGE('SG Garage', 'How long does a service take?', '+65 1111 1111');
+const NEW = PAGE('SG Garage | Car Servicing', 'How long does a car service take?', '+65 2222 2222');
+const XML = '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"><url><loc>https://www.sggarage.com/</loc></url></urlset>\n';
+
+Deno.test('flags: sggarage HOLD OFF in SITE_HOLDS, and sggarage is the only site without the live guard', () => {
+  const h = SITE_HOLDS.find((x) => x.key === 'sggarage');
+  if (!h || h.on !== false) throw new Error('sggarage hold should be OFF');
+  for (const x of SITE_HOLDS) if (x.key !== 'sggarage' && x.on !== false) throw new Error(x.key + ' changed');
+  if (JSON.stringify(NO_LIVE_GUARD_SITES) !== '["sggarage"]') throw new Error('NO_LIVE_GUARD_SITES must be exactly ["sggarage"]');
+  console.log('ok       sggarage HOLD off; other 6 flags unchanged (off); NO_LIVE_GUARD_SITES = ["sggarage"]');
+});
+
+Deno.test('sggarage: edits the live guard used to refuse now go through', async () => {
+  await ok('sggarage index.html: title + FAQ question + JSON-LD value changed', g('sggarage', 'index.html', present(OLD), NEW));
+  await ok('sggarage article: review footer removed', g('sggarage', 'articles/a.html', present(OLD), OLD.replace(/<footer>.*<\/footer>/, '')));
+  await ok('sggarage sitemap.xml replace', g('sggarage', 'sitemap.xml', present(XML), XML.replace('</urlset>', '<url><loc>https://www.sggarage.com/b/</loc></url></urlset>')));
+  await ok('sggarage article-cards.json replace', g('sggarage', 'articles/article-cards.json', present('[]'), '[{"t":"x"}]'));
+  await ok('sggarage robots.txt replace', g('sggarage', 'robots.txt', present('User-agent: *\n'), 'User-agent: *\nSitemap: https://www.sggarage.com/sitemap.xml\n'));
+  await ok('sggarage llms.txt replace', g('sggarage', 'llms.txt', present('# a\n'), '# b\n'));
+  await ok('sggarage live state unknown (no live compare at all)', g('sggarage', 'index.html', { state: 'unknown', error: 'timeout' }, NEW));
+  await ok('sggarage new page', g('sggarage', 'new/index.html', { state: 'absent' }, NEW));
+});
+
+Deno.test('sggarage: path check and the config/code rule still apply (guard + bridgeConfig file-type blocks)', async () => {
+  for (const p of ['.htaccess', 'sub/.htaccess', '.user.ini', 'php.ini', 'x.php', 'a.cgi', 'a.pl', 'a.py', 'a.sh']) {
+    await no('sggarage ' + p + ' (liveGuard NEVER)', g('sggarage', p, present('x'), 'y'), /never written/);
+    if (!writeBlockedReason(p) && !p.endsWith('.ini')) throw new Error('bridgeConfig no longer blocks ' + p);
+  }
+  for (const p of ['.htaccess', 'x.php', 'a.cgi', 'a.sh']) if (!writeBlockedReason(p)) throw new Error('bridgeConfig block missing for ' + p);
+  console.log('ok       bridgeConfig writeBlockedReason still blocks .htaccess / .php / .cgi / .sh (every site, unchanged)');
+  await no('sggarage ../ path', g('sggarage', '../x.html', present('x'), 'y'), /refused/);
+  await no('sggarage absolute path', g('sggarage', '/etc/x.html', present('x'), 'y'), /refused/);
+  const del = await liveGuard({ site: 'sggarage', rel: 'index.html', op: 'delete' as any, live: present(OLD), overrides: [], sha256 });
+  if (del === null) throw new Error('delete through the guard should still be refused (no delete tool uses it)');
+  console.log('refused  sggarage delete through the guard (unchanged)');
+});
+
+Deno.test('every other site keeps the live guard exactly as before', async () => {
+  await no('pageone index.html FAQ/JSON-LD change', g('pageone', 'index.html', present(OLD), NEW), /LIVE GUARD refused/);
+  await no('star preview page title change', g('pageone', 'preview/star-performance/index.html', present(OLD), NEW), /LIVE GUARD refused/);
+  await no('cleanic sitemap.xml (not publisher)', g('cleanic', 'sitemap.xml', present(XML), XML + ' '), /needs an override/);
+  await no('contiexpert robots.txt', g('contiexpert', 'robots.txt', present('a'), 'b'), /needs an override/);
+  await no('pageone live unknown', g('pageone', 'index.html', { state: 'unknown', error: 'timeout' }, NEW), /could not be confirmed/);
+  await no('pageone sitemap.xml without publisher flag', g('pageone', 'sitemap.xml', present(XML), XML + ' '), /needs an override/);
+  await no('site key SGGARAGE (wrong case) is not exempt', g('SGGARAGE', 'index.html', present(OLD), NEW), /LIVE GUARD refused/);
+});
