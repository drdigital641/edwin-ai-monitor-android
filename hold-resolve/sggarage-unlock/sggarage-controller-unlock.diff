diff -ruN sgu0/tests/sggUnlocked.test.ts sgu/tests/sggUnlocked.test.ts
--- a/tests/sggUnlocked.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/sggUnlocked.test.ts	2026-11-14 15:11:19.143214732 +0000
@@ -0,0 +1,85 @@
+// SG Garage UNLOCKED state for the SgGarage Controller ("SG GARAGE UNLOCK 1114-2245", 14 Nov 2026).
+// Fake in-memory FTP server, fake Base44 SDK: no network, nothing saved anywhere.
+// Run: deno test --no-check=remote --import-map tests/importmap.json tests/sggUnlocked.test.ts
+// With the sggarage flag OFF: normal SG Garage writes go through every path, while the file-type rule that applies
+// to every site (server config / server code never written) still refuses before any byte is sent.
+import { reset, state } from './fakeFtp.ts';
+import { audit, cmds } from './fakeSdk.ts';
+import { withFtp } from '../base44/shared/ftpClient.ts';
+import { safeWriteRemoteText, sha256 } from '../base44/shared/ftpFileOps.ts';
+import { holdOn } from '../base44/shared/siteHold.ts';
+import ftpWriteFile from '../base44/functions/ftpWriteFile/entry.ts';
+import ftpHealthCheck from '../base44/functions/ftpHealthCheck/entry.ts';
+import websiteCommandWorker from '../base44/functions/websiteCommandWorker/entry.ts';
+
+const MARK = 'adba3d204db0f9cd2fb386bf0cc497ce.txt';
+const req = (body: any) => new Request('http://x/', { method: 'POST', body: JSON.stringify(body) });
+const snap = () => JSON.stringify([...state.files.entries()].map(([k, v]) => [k, sha256(Buffer.from(v))]).sort());
+const docroot = () => reset({ ['/' + MARK]: 'k', '/index.html': '<h1>SGG</h1>', '/articles/a.html': 'a', '/old.html': 'o', '/robots.txt': 'User-agent: *' }, { dirs: ['/articles', '/_chatgpt_backups', '/_cleanic_control/validation'] });
+const skip = () => { if (!holdOn()) return false; console.log('EXPECTED while the SG Garage HOLD is ON: unlocked-state test skipped'); return true; };
+
+Deno.test('flag is OFF in SITE_HOLDS', () => {
+  if (holdOn()) { console.log('EXPECTED while the SG Garage HOLD is ON: flag check skipped'); return; }
+  console.log('ok       sggarage HOLD flag is OFF');
+});
+
+Deno.test('unlocked: normal writes to the SG Garage docroot go through on every path', async () => {
+  if (skip()) return;
+  docroot();
+  const w1 = await safeWriteRemoteText('/new-article.html', '<h1>new</h1>');
+  if (!w1.verified || !state.files.has('/new-article.html')) throw new Error('new file not written');
+  const w2 = await safeWriteRemoteText('/index.html', '<h1>SGG v2</h1>', { expectedSha256: sha256(Buffer.from('<h1>SGG</h1>')) });
+  if (!w2.verified) throw new Error('overwrite not verified');
+  await withFtp((c: any) => c.uploadFrom(new Blob(['x']).stream(), '/articles/b.html'));
+  await withFtp((c: any) => c.rename('/old.html', '/renamed.html'));
+  await withFtp((c: any) => c.ensureDir('/newdir'));
+  await withFtp((c: any) => c.send('SITE CHMOD 644 /index.html'));
+  for (const f of ['/articles/b.html', '/renamed.html']) if (!state.files.has(f)) throw new Error('missing ' + f);
+  const r1 = await ftpWriteFile(req({ path: '/articles/a.html', content: 'a2', expected_sha256: sha256(Buffer.from('a')) }));
+  if (r1.status !== 200) throw new Error('ftpWriteFile status ' + r1.status + ' ' + JSON.stringify(await r1.json()));
+  cmds['u1'] = { id: 'u1', action: 'write', path: '/articles/c.html', content: 'c', status: 'pending', attempts: 0 };
+  const r2 = await websiteCommandWorker(req({ id: 'u1' }));
+  if (r2.status !== 200 || cmds['u1'].status === 'failed') throw new Error('worker status ' + r2.status + ' / ' + cmds['u1'].status);
+  if (!state.files.has('/articles/c.html')) throw new Error('worker write missing');
+  docroot();  // fresh server for the probe (write + read back + remove)
+  const h = await ftpHealthCheck(req({}));
+  if (h.status !== 200) throw new Error('health check (probe write + remove) ' + h.status + ' ' + JSON.stringify(await h.json()).slice(0, 600));
+  console.log('allowed  new file, overwrite with sha, upload, rename, mkdir, SITE CHMOD, ftpWriteFile 200, worker 200, health probe 200');
+});
+
+Deno.test('unlocked: server config and server code are still never written (every-site rule), 403 + audit', async () => {
+  if (skip()) return;
+  docroot();
+  audit.length = 0;
+  const before = snap();
+  const BAD = ['/.htaccess', '/.htpasswd', '/.user.ini', '/php.ini', '/x.php', '/shell.php.jpg', '/run.cgi', '/a.pl', '/a.py', '/a.sh', '/page.shtml', '/X.PHP '];
+  for (const p of BAD) {
+    const r = await ftpWriteFile(req({ path: p, content: 'x' }));
+    if (r.status !== 403) throw new Error(p + ': expected 403, got ' + r.status);
+  }
+  let err: any = null;
+  try { await withFtp((c: any) => c.uploadFromDir('/tmp', '/')); } catch (e) { err = e; }
+  if (err?.name !== 'NeverWriteError') throw new Error('folder upload should be refused');
+  if (snap() !== before) throw new Error('server changed');
+  const rows = audit.filter((a) => a.stage === 'never-write-refused');
+  if (rows.length !== BAD.length) throw new Error('expected ' + BAD.length + ' never-write rows, got ' + rows.length);
+  console.log('refused  ' + BAD.length + ' config/code names (403, ' + rows.length + ' audit rows) + folder upload; server unchanged');
+});
+
+Deno.test('unlocked: raw FTP commands and unsafe paths still refused, with messages that do not claim the HOLD is ON', async () => {
+  if (skip()) return;
+  docroot();
+  const before = snap();
+  for (const fn of [
+    () => withFtp(async (c: any) => c.ftp.request('STOR /index.html')),
+    () => withFtp((c: any) => c.remove('~/index.html')),
+    () => withFtp((c: any) => c.remove('\\index.html')),
+  ]) {
+    let err: any = null;
+    try { await fn(); } catch (e) { err = e; }
+    if (!err) throw new Error('expected a refusal');
+    if (/HOLD is ON/.test(String(err.message))) throw new Error('misleading message: ' + err.message);
+  }
+  if (snap() !== before) throw new Error('server changed');
+  console.log('refused  raw ftp.request, ~ path, backslash path (neutral messages)');
+});
