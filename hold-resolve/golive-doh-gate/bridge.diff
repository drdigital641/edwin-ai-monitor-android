-export type DomainStatus = { domain: string; dns_ok: boolean; https_ok: boolean; ips: string[]; can_go_live: boolean; detail: string };
+export type DomainStatus = { domain: string; dns_ok: boolean; https_ok: boolean; ips: string[]; can_go_live: boolean; detail: string; resolver?: string };
+// DNS gate over several resolvers (23 Nov 2026, autoseo.sg stale cache). A resolver returns the final A/AAAA addresses for a host
+// (CNAMEs followed by the resolver) and throws when it cannot answer. The LAST resolver in the list (the runtime's own lookup) is
+// asked only when none of the others answered. Pass = one resolver gives apex only SERVER_IP, www only SERVER_IP and no AAAA.
+export type Resolver = { name: string; lookup: (host: string, type: 'A' | 'AAAA') => Promise<string[]> };
+export type GateResult = { ok: boolean; failed: boolean; ips: string[]; resolver: string; detail: string };
+export async function resolveGate(domain: string, resolvers: Resolver[]): Promise<GateResult> {
+  const notes: string[] = []; let first: { ips: string[]; detail: string } | null = null;
+  for (let i = 0; i < resolvers.length; i++) {
+    const res = resolvers[i];
+    if (i === resolvers.length - 1 && i > 0 && first) break;   // last-resort lookup only when no other resolver answered
+    try {
+      const [apex, www, aaaa] = await Promise.all([res.lookup(domain, 'A'), res.lookup('www.' + domain, 'A'), res.lookup(domain, 'AAAA')]);
+      const v = dnsVerdict(apex), w = dnsVerdict(www);
+      const detail = [!v.ok && 'apex: ' + v.detail, !w.ok && 'www: ' + w.detail, aaaa.length && 'AAAA record present (' + aaaa.join(',') + '), remove it'].filter(Boolean).join('; ');
+      if (v.ok && w.ok && !aaaa.length) return { ok: true, failed: false, ips: [...new Set(apex)], resolver: res.name, detail: '' };
+      if (!first) first = { ips: [...new Set(apex)], detail };
+      notes.push(res.name + (detail === first.detail ? ' same' : ': ' + detail));
+    } catch (e) { notes.push(res.name + ': lookup failed (' + String((e as Error)?.message || e).slice(0, 80) + ')'); }
+  }
+  if (!first) return { ok: false, failed: true, ips: [], resolver: '', detail: 'DNS lookup failed on every resolver [' + notes.join(' | ') + ']' };
+  return { ok: false, failed: false, ips: first.ips, resolver: notes.map((n) => n.split(/[ :]/)[0]).join(','), detail: first.detail + ' [resolvers: ' + notes.join(' | ') + ']' };
+}
