+
+// ---------- LIVE GUARD v2: live state from the FTP server (14 Nov 2026) ----------
+// absent  = the parent folder's MLSD listing was read and has no entry with that name (or the parent folder is itself
+//           confirmed absent the same way, up to the FTP root); never judged from HTTP.
+// present = MLSD lists a regular file (type=file) and RETR of that exact path returned its bytes.
+// unknown = anything else (550 on a listed file, listing error, symlink, folder): the guard refuses it.
+async function probeLiveFtp(ftp: any, rel: string): Promise<LiveState> {
+  try {
+    const i = rel.lastIndexOf('/');
+    const type = await ftpListedType(ftp, i < 0 ? '' : rel.slice(0, i), rel.slice(i + 1));
+    if (type === 'absent') return { state: 'absent' };
+    if (type !== 'file') return { state: 'unknown', error: 'not a regular file on the server (' + type + ')' };
+    const bytes = await ftp.download(rel);
+    if (!bytes) return { state: 'unknown', error: 'listed on the server but could not be read' };
+    return { state: 'present', bytes };
+  } catch (e) {
+    return { state: 'unknown', error: String(e?.message || e).slice(0, 200) };
+  }
+}
+
+async function ftpListedType(ftp, dir, name) {
+  const rows = await ftp.listAll(dir);
+  if (rows === null) {
+    if (!dir) throw new Error('the site folder listing failed');
+    const j = dir.lastIndexOf('/');
+    if (await ftpListedType(ftp, j < 0 ? '' : dir.slice(0, j), dir.slice(j + 1)) === 'absent') return 'absent';
+    throw new Error('listing of ' + dir + ' failed');
+  }
+  const hit = rows.find((r) => r.name === name);
+  return hit ? hit.type : 'absent';
+}
