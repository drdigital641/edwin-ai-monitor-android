+// LIVE only (21 Nov 2026, sgcaraccident.sg): any root-relative /preview/<slug>/ path left after the attribute pass, in any
+// text file (data-* attributes, JSON data files, inline JSON, CSS url(), JS strings), becomes /. Absolute preview URLs are
+// already swapped to the live domain by retargetText first, so what remains here is root-relative. Only matches the
+// prefix when it starts a path (after a quote, ( , = or whitespace), so a longer name like /preview/<slug>-x is left alone.
+export function stripPreviewPaths(text: string, previewPath: string): string {
+  const pre = esc(previewPath.replace(/\/$/, ''));
+  return text.replace(new RegExp('(["\'(=\\s,])' + pre + '(?:/|(?=["\')?#]))', 'g'), '$1/');
+}
+// Text assets inside the site folder (CSS, JS, JSON, webmanifest): swap absolute preview URLs, then root-relative paths.
+export function retargetAsset(text: string, m: Mk): string {
+  const t = retargetText(text, m);
+  return m.live ? stripPreviewPaths(t, m.previewPath) : t;
+}
+
 export function robotsTxt(m: Mk) { return `User-agent: *\nAllow: /\n\nSitemap: ${m.canonicalBase}sitemap.xml\n`; }
 
 // Rewrites loc/hreflang URLs inside an EXISTING sitemap.xml (keeps lastmod and the page list the site already has).
