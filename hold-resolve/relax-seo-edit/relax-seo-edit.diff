+// APPROVED SEO EDIT RULE (Edwin 16 Nov 2026, thread "Relax Bridge live guard for approved edits": "Let Claude's approved
+// jobs edit titles, meta, H1 and content without asking me, keep auto-backups"). For a Bridge TOOL edit of a live HTML page
+// (write_file, edit_file, write_files, restore_backup: writeFile opts.seoEdit, set only on those routes and only for Claude's
+// signed-in Bridge session: agent 'claude' with no API key; the ChatGPT key, site keys and drop keys never get it), a change to the
+// page's <title>, meta description or <h1> text is no longer a refusal and needs no GUARD_OVERRIDES entry. Body content
+// edits already pass when they keep the checks below. The new page must still be sane: the same number of <title> and
+// <h1> elements as live, each 1-200 / 1-250 characters of text, and a non-empty meta description (max 400) whenever live
+// has one. NOT relaxed (still refused exactly as before): older-than-live source, JSON-LD loss or change, FAQ question
+// loss, removal of the "Leave us a Google review" footer, every non-HTML file type, every path rule, the never-write list
+// (.htaccess, .user.ini, php.ini, PHP/CGI/shell code), unknown live state, deletes / moves / renames, the hourly publisher
+// and auto-sitemap routes, sync_from_github and drop_publish (they never pass seoEdit), and the SG Car Workshop directory
+// pages (preview/sgcarworkshop/ keeps its own rule). The BRIDGE HOLD (frozen sites), the blocked-name / secret checks,
+// the base-sha256 compare-and-swap, the verified private backup before every replace and the byte-exact readback all
+// run in writeFile around this guard and are unchanged. SEO_EDIT_ON = false switches the rule off (Base44 code is live on
+// save: changing this needs security review AND Edwin's own written yes before saving).
+export const SEO_EDIT_ON = true;
+const SEO_EDIT_RELAXED = /^(title would change|meta description would change|H1 would change)/;
+
+export function seoEditProblems(liveBytes: Uint8Array, newBytes: Uint8Array, problems: string[]): string[] {
+  const kept = problems.filter((p) => !SEO_EDIT_RELAXED.test(p));
+  if (kept.length === problems.length) return problems;
+  const live = dec(liveBytes), next = dec(newBytes);
+  const t = (h: string) => all(/<title\b[^>]*>([\s\S]*?)<\/title>/gi, h).map(strip);
+  const h1 = (h: string) => all(/<h1\b[^>]*>([\s\S]*?)<\/h1>/gi, h).map(strip);
+  const lt = t(live), nt = t(next), lh = h1(live), nh = h1(next);
+  if (nt.length !== lt.length) kept.push('approved SEO edit: the page must keep ' + lt.length + ' <title> element(s) (has ' + nt.length + ')');
+  else if (nt.some((x) => !x || x.length > 200)) kept.push('approved SEO edit: a title must be 1-200 characters of text');
+  if (nh.length !== lh.length) kept.push('approved SEO edit: the page must keep ' + lh.length + ' <h1> element(s) (has ' + nh.length + ')');
+  else if (nh.some((x) => !x || x.length > 250)) kept.push('approved SEO edit: an H1 must be 1-250 characters of text');
+  const lm = metaDescription(live), nm = metaDescription(next);
+  if (lm !== null && nm === null) kept.push('approved SEO edit: the meta description would be removed');
+  else if (lm && nm !== null && (!nm || nm.length > 400)) kept.push('approved SEO edit: the meta description must be 1-400 characters');
+  return kept;
+}
