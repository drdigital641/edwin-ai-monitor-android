diff -ruN -x openapi.ts spo2-base/tests/sitesView.test.ts spo2/tests/sitesView.test.ts
--- spo2-base/tests/sitesView.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ spo2/tests/sitesView.test.ts	2026-11-16 01:29:10.910629579 +0000
@@ -0,0 +1,22 @@
+// SITES VIEW self-test (SPO review 16 Nov 2026): account_domains goes only to the all-sites caller.
+// Run: deno test --no-check -A --import-map tests/importmap.json tests/sitesView.test.ts
+import { sitesView } from '../base44/shared/sitesView.ts';
+
+const SITES = [{ site: 'ktech', folder: 'public_html/ktech.my' }, { site: 'urbaneco', folder: 'public_html/urbanecosolutions.com' }];
+const DOMAINS = [{ domain: 'sgmodder.com', folder: 'public_html' }, { domain: 'ktech.my', folder: 'public_html/ktech.my' }];
+
+Deno.test('sites: all-sites caller gets account_domains; a site key only its own site; other keys no domains', async () => {
+  let asked = 0;
+  const domains = async () => { asked++; return DOMAINS; };
+  const all: any = await sitesView({ siteOnly: null, allSites: true }, SITES, domains);
+  if (all.sites.length !== 2 || JSON.stringify(all.account_domains) !== JSON.stringify(DOMAINS) || asked !== 1) throw new Error('all-sites view');
+  const own: any = await sitesView({ siteOnly: 'ktech', allSites: false }, SITES, domains);
+  if ('account_domains' in own || own.sites.length !== 1 || own.sites[0].site !== 'ktech') throw new Error('site key view: ' + JSON.stringify(own));
+  // A site key is never treated as all-sites, even if both flags were set by mistake.
+  const both: any = await sitesView({ siteOnly: 'urbaneco', allSites: true }, SITES, domains);
+  if ('account_domains' in both || both.sites.length !== 1 || both.sites[0].site !== 'urbaneco') throw new Error('site key wins');
+  const other: any = await sitesView({ siteOnly: null, allSites: false }, SITES, domains);
+  if ('account_domains' in other || other.sites.length !== 2) throw new Error('other key view');
+  if (asked !== 1) throw new Error('cPanel domain list fetched for a caller that may not see it');
+  console.log('ok       account_domains: all-sites only; site key sees only its own row; overview/needs/drop: no domains, never fetched');
+});
