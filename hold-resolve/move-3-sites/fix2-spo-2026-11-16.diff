diff -ruN -x openapi.ts spo2-base/base44/shared/sitesView.ts spo2/base44/shared/sitesView.ts
--- spo2-base/base44/shared/sitesView.ts	1970-01-01 00:00:00.000000000 +0000
+++ spo2/base44/shared/sitesView.ts	2026-11-16 01:28:35.020714673 +0000
@@ -0,0 +1,10 @@
+// SITES VIEW (SPO review 16 Nov 2026): what the sites tool shows each caller.
+// account_domains lists every cPanel domain and folder on the account, so only the all-sites caller (the full key or
+// Claude's signed-in admin session) gets it. A site key sees only its own site row and never account_domains; any other
+// caller gets the site rows only. Today a site key cannot run the sites tool at all (SITE_KEY_ACTIONS); this keeps the
+// answer safe if that list ever grows.
+export function sitesView<S extends { site: string }, D>(caller: { siteOnly: string | null; allSites: boolean }, sites: S[], domains: () => Promise<D[]>) {
+  if (caller.siteOnly) return Promise.resolve({ sites: sites.filter((s) => s.site === caller.siteOnly) });
+  if (!caller.allSites) return Promise.resolve({ sites });
+  return domains().then((account_domains) => ({ sites, account_domains }));
+}
