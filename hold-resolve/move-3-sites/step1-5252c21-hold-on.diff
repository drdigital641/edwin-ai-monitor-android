diff --git a/tests/move3Sites.test.ts b/tests/move3Sites.test.ts
new file mode 100644
index 0000000..a07f320
--- /dev/null
+++ b/tests/move3Sites.test.ts
@@ -0,0 +1,88 @@
+// MOVE 3 SITES (K Tech, Benz World, Li Lian). Run:
+// deno test --no-check -A --import-map tests/importmap.json tests/move3Sites.test.ts
+// Pure config + guard calls with fake live states: never touches a live site.
+import { liveGuard, MOVED_GENERATED_SITES, MOVED_GENERATED_PATH, GENERATED_OVERRIDE_SITES, GENERATED_OVERRIDE_PATH } from '../base44/shared/liveGuard.ts';
+import { SITES, SITE_HOLDS, holdReason, writeBlockedReason } from '../base44/shared/bridgeConfig.ts';
+import { dropSharedRoots } from '../base44/shared/bridgeOps.ts';
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const sha256 = async (b: Uint8Array) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', b))).map((x) => x.toString(16).padStart(2, '0')).join('');
+const present = (s: string) => ({ state: 'present' as const, bytes: enc(s) });
+const g = (site: string, rel: string, liveText: string, newText: string, publisher = false) =>
+  liveGuard({ site, rel, op: 'write', live: present(liveText), newBytes: enc(newText), overrides: [], sha256, publisher });
+const ok = async (label: string, p: Promise<string | null>) => { const r = await p; if (r !== null) throw new Error(label + ': expected allowed, got: ' + r); console.log('allowed  ' + label); };
+const no = async (label: string, p: Promise<string | null>, m: RegExp) => { const r = await p; if (r === null || !m.test(r)) throw new Error(label + ': expected refusal ' + m + ', got: ' + r); console.log('refused  ' + label); };
+const NS = 'xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"';
+const XML = (d: string, extra = '') => `<?xml version="1.0" encoding="UTF-8"?>\n<urlset ${NS}><url><loc>https://${d}/</loc></url>${extra}</urlset>\n`;
+const NEW3: [string, string][] = [['ktech', 'ktech.my'], ['benzworld', 'benzworld.my'], ['lilian', 'lilianproperties.com']];
+const PAGE = (title: string) => `<!doctype html><html><head><title>${title}</title><meta name="description" content="d"></head><body><h1>H</h1></body></html>`;
+
+Deno.test('config: 3 sites added with their domains, old 6 unchanged, HOLD ON for the 3 (step 1), old 7 flags unchanged', () => {
+  const keys = Object.keys(SITES).join(',');
+  if (keys !== 'sggarage,cleanic,alicia,danny,sofacare,pageone,ktech,benzworld,lilian') throw new Error('site keys: ' + keys);
+  for (const [k, d] of NEW3) if ((SITES as any)[k].domain !== d) throw new Error(k + ' domain');
+  for (const [k] of NEW3) { const h = SITE_HOLDS.find((x) => x.key === k)!; if (!h || h.site !== k || h.prefix !== '' || h.on !== true) throw new Error(k + ' hold'); }
+  if (SITE_HOLDS.filter((h) => !NEW3.some(([k]) => k === h.key)).some((h) => h.on !== false)) throw new Error('old flags changed');
+  if (SITE_HOLDS.length !== 10) throw new Error('hold count');
+  console.log('ok       9 sites; ktech/benzworld/lilian HOLD ON; other 7 flags off');
+});
+
+Deno.test('HOLD ON blocks every path of the 3 sites and nothing else', () => {
+  for (const [k] of NEW3) for (const p of ['index.html', 'sitemap.xml', 'services/index.html', 'ms/zh/x.css']) if (!holdReason(k, p)) throw new Error(k + ':' + p + ' not held');
+  for (const [s, p] of [['pageone', 'index.html'], ['pageone', 'preview/lilian-properties/index.html'], ['sggarage', 'index.html'], ['cleanic', 'a.html']]) if (holdReason(s, p)) throw new Error(s + ':' + p + ' held');
+  console.log('ok       hold covers only the 3 new sites');
+});
+
+Deno.test('override list: exactly 3 root files, only the 3 new sites, Page One list unchanged', () => {
+  if (JSON.stringify(MOVED_GENERATED_SITES) !== '["ktech","benzworld","lilian"]') throw new Error('sites');
+  if (JSON.stringify(GENERATED_OVERRIDE_SITES) !== '["pageone"]') throw new Error('Page One list changed');
+  if (GENERATED_OVERRIDE_PATH.source !== '^(preview\\/(star-performance|klar-details|cska-auto|dmts|benjamin-poon)\\/)?(sitemap\\.xml|sitemap\\.txt|llms\\.txt)$') throw new Error('Page One path changed');
+  for (const p of ['sitemap.xml', 'sitemap.txt', 'llms.txt']) if (!MOVED_GENERATED_PATH.test(p)) throw new Error(p);
+  for (const p of ['ms/sitemap.xml', 'zh/llms.txt', 'llms-full.txt', 'sitemap.xml.bak', 'Sitemap.xml', 'robots.txt', 'article-cards.json', 'index.html', '.htaccess'])
+    if (MOVED_GENERATED_PATH.test(p)) throw new Error('should not match ' + p);
+  console.log('ok       3 exact root paths');
+});
+
+Deno.test('3 sites: sitemap.xml/sitemap.txt/llms.txt replace allowed (tools and publisher) when sane', async () => {
+  for (const [k, d] of NEW3) for (const pub of [false, true]) {
+    await ok(k + ' sitemap.xml pub=' + pub, g(k, 'sitemap.xml', XML(d), XML(d, `<url><loc>https://${d}/services/x/</loc></url>`), pub));
+    await ok(k + ' sitemap.txt pub=' + pub, g(k, 'sitemap.txt', `https://${d}/\n`, `https://${d}/\nhttps://${d}/a/\n`, pub));
+    await ok(k + ' llms.txt pub=' + pub, g(k, 'llms.txt', '# x\n', '# x\n- a\n', pub));
+  }
+});
+
+Deno.test('3 sites: bad generated content refused; other guarded files still refused', async () => {
+  for (const [k, d] of NEW3) {
+    await no(k + ' sitemap <script>', g(k, 'sitemap.xml', XML(d), XML(d, '<script>x</script>')), /element <script> is not allowed/);
+    await no(k + ' sitemap onload', g(k, 'sitemap.xml', XML(d), XML(d, `<url><loc onload="x">https://${d}/z</loc></url>`)), /attribute onload is not allowed/);
+    await no(k + ' sitemap javascript:', g(k, 'sitemap.xml', XML(d), XML(d, '<url><loc>&#106;avascript&#58;alert(1)</loc></url>')), /javascript: is not allowed/);
+    await no(k + ' sitemap 0 URLs', g(k, 'sitemap.xml', XML(d), `<urlset ${NS}></urlset>`), /0 URLs/);
+    await no(k + ' sitemap.txt non-URL', g(k, 'sitemap.txt', `https://${d}/\n`, `https://${d}/\n<script>\n`), /not an https URL/);
+    await no(k + ' llms empty', g(k, 'llms.txt', '# a\n', ' \n'), /llms.txt is empty/);
+    await no(k + ' robots.txt', g(k, 'robots.txt', 'User-agent: *\nAllow: /\n', 'User-agent: *\nDisallow: /\n'), /needs an override/);
+    await no(k + ' ms/sitemap.xml', g(k, 'ms/sitemap.xml', XML(d), XML(d, `<url><loc>https://${d}/b/</loc></url>`)), /needs an override/);
+    await no(k + ' title change', g(k, 'index.html', PAGE('A'), PAGE('B')), /title/i);
+    await no(k + ' .htaccess', g(k, '.htaccess', 'x', 'y'), /never written/);
+    if (!writeBlockedReason('x.php') || !writeBlockedReason('.htaccess')) throw new Error('write block');
+  }
+});
+
+Deno.test('Page One and SG Garage behaviour unchanged for these files', async () => {
+  await no('pageone preview/lilian-properties/sitemap.xml (tools)', g('pageone', 'preview/lilian-properties/sitemap.xml', XML('x.sg'), XML('x.sg', '<url><loc>https://x.sg/b/</loc></url>')), /needs an override/);
+  await no('pageone root sitemap.xml (tools, not publisher)', g('pageone', 'sitemap.xml', XML('x.sg'), XML('x.sg', '<url><loc>https://x.sg/b/</loc></url>')), /needs an override/);
+  await no('cleanic sitemap.xml', g('cleanic', 'sitemap.xml', XML('x.sg'), XML('x.sg', '<url><loc>https://x.sg/b/</loc></url>')), /needs an override/);
+});
+
+Deno.test('own folder: a new site sharing or containing another site\'s root is dropped (fails closed)', () => {
+  const H = '/home3/sgmodde1/public_html';
+  const base = { sggarage: H + '/carbonfibre', pageone: H + '/website_b1ec45f5', cleanic: H + '/website_02a02bac' };
+  const good = dropSharedRoots({ ...base, ktech: H + '/ktech.my', benzworld: H + '/benzworld.my', lilian: H + '/lilianproperties.com' });
+  if (!good.ktech || !good.benzworld || !good.lilian || !good.pageone) throw new Error('distinct roots must stay');
+  const parked = dropSharedRoots({ ...base, ktech: H + '/website_b1ec45f5', benzworld: H, lilian: H + '/website_b1ec45f5/preview/lilian-properties' });
+  if (parked.ktech || parked.benzworld) throw new Error('equal / containing root must be dropped');
+  if (!parked.pageone || !parked.sggarage || !parked.cleanic) throw new Error('existing sites must stay');
+  if (!parked.lilian) throw new Error('a root nested inside another site is kept (resolvePath already blocks the other way)');
+  const twins = dropSharedRoots({ ...base, ktech: H + '/x', benzworld: H + '/x' });
+  if (twins.ktech || twins.benzworld) throw new Error('two new sites on one folder: both dropped');
+  console.log('ok       equal/containing roots dropped; distinct and existing roots kept');
+});
