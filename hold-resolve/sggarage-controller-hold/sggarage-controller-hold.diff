diff -ruN a/base44/shared/siteHold.ts b/base44/shared/siteHold.ts
--- a/base44/shared/siteHold.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/base44/shared/siteHold.ts	2026-11-14 02:46:11.076472403 +0000
@@ -0,0 +1,42 @@
+// SG GARAGE HOLD for this FTP controller (14 Nov 2026, "SGG CONTROLLER HOLD 1114-1040").
+// Mirrors the Page One Controller / Bluehost Bridge SITE_HOLDS pattern. Base44 backend code is LIVE AS SOON AS IT
+// IS SAVED, so changing `on` here is live the moment it is saved: only Edwin lifts this hold.
+// Fail closed: the hold counts as ON unless the entry exists, is well formed and says on === false.
+export const SITE_HOLDS = Object.freeze([
+  Object.freeze({ key: 'sggarage', name: 'SG Garage (sggarage.com)', on: true, docroot: '/home3/sgmodde1/public_html/carbonfibre' }),
+]);
+
+// Any path with a segment of this name is treated as SG Garage, at any FTP root depth
+// (/carbonfibre, /public_html/carbonfibre, /home3/sgmodde1/public_html/carbonfibre, /www/carbonfibre ...).
+export const SGG_DIR_SEGMENT = 'carbonfibre';
+// Files that only SG Garage's docroot has. If the FTP root (or the login folder) lists either one, that folder IS
+// the SG Garage docroot and every path inside it is held.
+export const SGG_ROOT_MARKERS = Object.freeze(['site-renderer.php', 'adba3d204db0f9cd2fb386bf0cc497ce.txt']);
+
+export class HoldError extends Error {
+  status = 423;
+  constructor(message: string) { super(message); this.name = 'HoldError'; }
+}
+
+export function holdOn(key = 'sggarage', holds: any = SITE_HOLDS): boolean {
+  try {
+    const h = Array.isArray(holds) ? holds.find((x: any) => x && x.key === key) : null;
+    if (!h || typeof h !== 'object') return true;      // missing flag -> ON
+    return h.on !== false;                              // anything but an explicit false -> ON
+  } catch {
+    return true;                                        // flag could not be read -> ON
+  }
+}
+
+export function holdMessage(what: string, path: string) {
+  return 'SG GARAGE HOLD is ON (flag "sggarage"): ' + what + ' ' + path + ' refused; nothing was changed. Only Edwin lifts this hold.';
+}
+
+export async function logHoldRefusal(base44: any, source: string, error: unknown) {
+  try {
+    await base44.asServiceRole.entities.ConnectionAudit.create({
+      checked_at: new Date().toISOString(), stage: 'hold-refused', status: 'fail',
+      detail: (source + ': ' + String((error as any)?.message || error)).slice(0, 1000),
+    });
+  } catch { /* logging must never hide the refusal */ }
+}
