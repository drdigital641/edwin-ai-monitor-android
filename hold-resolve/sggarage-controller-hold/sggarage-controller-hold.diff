+  for (const seg of ((s.startsWith('/') ? '' : cwd + '/') + s).split('/')) {
+    if (!seg || seg === '.') continue;
+    if (seg === '..') parts.pop(); else parts.push(seg);
+  }
+  return '/' + parts.join('/');
+}
