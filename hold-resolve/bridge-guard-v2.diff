 function errText(e: unknown) { return e instanceof Error ? e.message : e ? String(e) : 'content mismatch after upload'; }
+
+// ---------- LIVE GUARD v2: live state from the server (14 Nov 2026) ----------
+// absent  = the parent folder's cPanel listing was read and has no entry with that name (or the parent folder is
+//           itself confirmed absent the same way, up to the site root); never judged from HTTP.
+// present = the listing shows a regular file and its bytes were read from that exact path (get_file_content).
+// unknown = listing/read error, symlink, folder or any other type. The guard refuses unknown.
+export async function probeLive(site: string, rel: string): Promise<LiveState> {
+  try {
+    const { root, abs } = await resolvePath(site, rel);
+    const type = await listedType(abs, root);
+    if (type === 'absent') return { state: 'absent' };
+    if (type !== 'file') return { state: 'unknown', error: 'not a regular file on the server (' + type + ')' };
+    const f = await readBytes(abs);
+    if (!f) return { state: 'unknown', error: 'listed on the server but could not be read' };
+    return { state: 'present', bytes: f.bytes };
+  } catch (e) {
+    return { state: 'unknown', error: errText(e) };
+  }
+}
+
+async function listedType(abs: string, root: string): Promise<string> {
+  const { dir, file } = splitAbs(abs);
+  if (!(dir === root || dir.startsWith(root + '/'))) throw new Error('outside the site folder');
+  let rows: any[];
+  try {
+    rows = checkResult(await uapi('Fileman', 'list_files', {
+      dir, types: 'file|dir|link|char|block|fifo|socket', show_hidden: '1', include_mime: '0', include_permissions: '0',
+    }), 'list_files') || [];
+  } catch (e) {
+    if (dir === root) throw e;                                   // never look above the site root
+    if (await listedType(dir, root) === 'absent') return 'absent'; // parent folder confirmed missing
+    throw e;
+  }
+  const hit = rows.find((r: any) => String(r.file) === file);
+  return hit ? String(hit.type) : 'absent';
+}
