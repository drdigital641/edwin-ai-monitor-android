+
+// IndexNow key (21 Nov 2026, Overseas Tyre 422): which key a live site serves at <key>.txt in its root. First found wins:
+// the client's own key sent by the Controller (its own IndexNow submits use that key, so its file must exist even when the folder holds another key),
+// then a valid key file the site folder already has, then the standard key of the parent site.
+export const INDEXNOW_KEY_RE = /^[0-9a-f]{32}$/;
+export function pickIndexNowKey(own: string | null, given: unknown, standard: string | null): { key: string; write: boolean; from: 'site' | 'client' | 'standard' } | null {
+  const g = String(given ?? '').trim().toLowerCase();
+  if (INDEXNOW_KEY_RE.test(g)) return { key: g, write: own !== g, from: 'client' };
+  if (own && INDEXNOW_KEY_RE.test(own)) return { key: own, write: false, from: 'site' };
+  if (standard && INDEXNOW_KEY_RE.test(standard)) return { key: standard, write: true, from: 'standard' };
+  return null;
+}
