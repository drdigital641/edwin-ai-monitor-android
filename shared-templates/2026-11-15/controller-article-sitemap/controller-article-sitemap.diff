+// Article follow-up tests (15 Nov 2026). Run: deno test -A tests/articleSeo.test.ts. Fakes only: no FTP, no network, no real IndexNow.
+import { assertEquals, assert, assertStringIncludes } from 'jsr:@std/assert@1';
+import { addToSitemapXml, sitemapTxtFromXml, addToLlmsTxt, addToCards, articleFollowUp, articleFollowUpProblem, xmlProblem, sitemapLocs, type FollowUpIO } from '../base44/shared/articleSeo.ts';
+import { liveGuard } from '../base44/shared/liveGuard.ts';
+
+const enc = new TextEncoder(), dec = new TextDecoder();
+const B = 'https://acme.sg/';
+const XML = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n  <url><loc>${B}</loc><lastmod>2026-11-01</lastmod></url>\n  <url><loc>${B}about/</loc><lastmod>2026-11-01</lastmod></url>\n  <url><loc>${B}articles/old-one/</loc><lastmod>2026-11-05</lastmod></url>\n</urlset>\n`;
+const LLMS = `# Acme\n\n> Plumber\n\n## Services\n- [Leaks](${B}leaks/)\n\n## Articles\n- [Old one](${B}articles/old-one/)\n\n## Contact\n- WhatsApp\n`;
+const CARDS = `[\n  {"href": "/articles/old.html", "cat": "Care", "title": "Old"}\n]\n`;
+const ART = { slug: 'new-one', title: 'New one', published: '2026-11-15T01:00:00.000Z' };
+const SITE = { root: 'preview/acme/', domain: 'acme.sg', indexnowKey: 'abc123', live: true };
+
+// A fake server that applies the real live guard (with the follow-up override) exactly like safeWrite does.
+function fake(files: Record<string, string>, opts: { refuse?: string[] } = {}) {
+  const store = new Map<string, Uint8Array>(Object.entries(files).map(([k, v]) => [k, enc.encode(v)]));
+  const writes: string[] = [], pings: any[] = [];
+  const io: FollowUpIO = {
+    read: async (rel) => store.get(rel) ?? null,
+    write: async (rel, bytes) => {
+      if (opts.refuse?.includes(rel)) throw new Error('LIVE GUARD refused (fake)');
+      const live = store.has(rel) ? { state: 'present' as const, bytes: store.get(rel)! } : { state: 'absent' as const };
+      const generatedOk = live.state === 'present' && articleFollowUpProblem(rel, bytes, live.bytes) === null;
+      const g = await liveGuard({ site: 'pageone', rel, op: 'write', live, newBytes: bytes, overrides: [], sha256: async () => 'x', generatedOk });
+      if (g) throw new Error(g);
+      store.set(rel, bytes); writes.push(rel);
+    },
+    indexnow: async (body) => { pings.push(body); return 200; },
+  };
+  return { io, store, writes, pings };
+}
+const F = { 'preview/acme/sitemap.xml': XML, 'preview/acme/sitemap.txt': `${B}\n${B}about/\n${B}articles/old-one/\n`, 'preview/acme/llms.txt': LLMS };
+
+Deno.test('sitemap: adds index + article, keeps every old entry in order, passes xmlProblem', () => {
+  const out = addToSitemapXml(XML, [{ loc: B + 'articles/', lastmod: '2026-11-15' }, { loc: B + 'articles/new-one/', lastmod: '2026-11-15' }])!;
+  assertEquals(xmlProblem(out), null);
+  assertEquals(sitemapLocs(out), [B, B + 'about/', B + 'articles/old-one/', B + 'articles/', B + 'articles/new-one/']);
+  assertStringIncludes(out, '<url><loc>https://acme.sg/articles/new-one/</loc><lastmod>2026-11-15</lastmod></url>');
+  assert(out.startsWith(XML.slice(0, XML.indexOf('</urlset>'))));
+});
+Deno.test('sitemap: URL already there -> identical text; sitemapindex -> null; & escaped', () => {
+  assertEquals(addToSitemapXml(XML, [{ loc: B + 'about/', lastmod: '2026-11-15' }]), XML);
+  assertEquals(addToSitemapXml('<sitemapindex><sitemap><loc>https://a.sg/s.xml</loc></sitemap></sitemapindex>', [{ loc: B, lastmod: '2026-11-15' }]), null);
+  assertStringIncludes(addToSitemapXml(XML, [{ loc: B + 'a?x=1&y=2', lastmod: '2026-11-15' }])!, 'x=1&amp;y=2');
+});
+Deno.test('sitemap.txt rebuilt from locs (decoded)', () => {
+  assertEquals(sitemapTxtFromXml(addToSitemapXml(XML, [{ loc: B + 'q?a=1&b=2', lastmod: '2026-11-15' }])!).split('\n').pop(), '');
+  assertStringIncludes(sitemapTxtFromXml(addToSitemapXml(XML, [{ loc: B + 'q?a=1&b=2', lastmod: '2026-11-15' }])!), 'q?a=1&b=2\n');
+});
+Deno.test('llms.txt: one line at the end of the Articles section, nothing else touched; none when URL present', () => {
+  const line = `- [New one](${B}articles/new-one/)`;
+  const out = addToLlmsTxt(LLMS, line, B + 'articles/new-one/');
+  assertEquals(out.replace(line + '\n', ''), LLMS);
+  assert(out.indexOf(line) > out.indexOf('Old one') && out.indexOf(line) < out.indexOf('## Contact'));
+  assertEquals(addToLlmsTxt(out, line, B + 'articles/new-one/'), out);
+  assertEquals(addToLlmsTxt('# A\n\n## Services\n- x\n', line, 'u'), '# A\n\n## Services\n- x\n\n## Articles\n' + line + '\n');
+});
+Deno.test('cards: same shape and indent, new first, nothing dropped, duplicate ignored', () => {
+  const out = addToCards(CARDS, { href: '/articles/new-one.html', cat: 'Care', title: 'New one' })!;
+  const arr = JSON.parse(out);
+  assertEquals(arr.map((c: any) => c.href), ['/articles/new-one.html', '/articles/old.html']);
+  assertEquals(Object.keys(arr[0]), ['href', 'cat', 'title']);
+  assertEquals(addToCards(out, { href: '/articles/new-one.html', cat: 'x', title: 'y' }), out);
+  assertEquals(addToCards('{}', { href: '/a', cat: 'c', title: 't' }), null);
+});
+Deno.test('override check: drops, reorders, script, on*, javascript:, bad root, big adds are refused', () => {
