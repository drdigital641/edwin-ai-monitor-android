+  assertStringIncludes(p(XML.replace(/\s*<url><loc>https:\/\/acme.sg\/about\/<\/loc>.*?<\/url>/, ''))!, 'drop');
+  assertStringIncludes(p(XML.replace('<url><loc>https://acme.sg/</loc>', '<script>x</script><url><loc>https://acme.sg/</loc>'))!, 'not allowed');
+  assertStringIncludes(p(XML.replace('<urlset ', '<urlset onload="x" '))!, 'on');
+  assertStringIncludes(p(XML.replace('</urlset>', '<url><loc>javascript:alert(1)</loc></url></urlset>'))!, 'javascript');
+  assert(p(XML.replace('urlset', 'html').replace('urlset', 'html')) !== null);
+  assertStringIncludes(p(addToSitemapXml(XML, [1, 2, 3].map((i) => ({ loc: B + 'n' + i + '/', lastmod: '2026-11-15' })))!)!, 'more than 2');
