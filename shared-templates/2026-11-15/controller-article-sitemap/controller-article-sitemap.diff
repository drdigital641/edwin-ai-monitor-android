+  assertEquals(articleFollowUpProblem('preview/acme/robots.txt', enc.encode('x'), enc.encode('y')), 'not an article follow-up file');
+  assertEquals(articleFollowUpProblem('sitemap.xml', enc.encode(XML), enc.encode(XML)), 'not an article follow-up file');
+  assertEquals(articleFollowUpProblem('preview/acme/llms.txt', enc.encode(LLMS.replace('Plumber', 'Cheater')), enc.encode(LLMS))!.slice(0, 22), 'llms.txt would rewrite');
+  assertStringIncludes(articleFollowUpProblem('preview/acme/article-cards.json', enc.encode('[{"href":"/articles/z.html","cat":"c","title":"t"}]'), enc.encode(CARDS))!, 'drop');
+});
+Deno.test('guard: without the flag, replacing sitemap/llms/robots is still refused (the bug this fixes)', async () => {
+  for (const rel of ['preview/acme/sitemap.xml', 'preview/acme/llms.txt', 'preview/acme/robots.txt']) {
+    const g = await liveGuard({ site: 'pageone', rel, op: 'write', live: { state: 'present', bytes: enc.encode('old') }, newBytes: enc.encode('new'), overrides: [], sha256: async () => 'x' });
+    assert(g && g.includes('needs an override'), rel);
+  }
+  // flag set but path not allowlisted: still refused
+  const g2 = await liveGuard({ site: 'pageone', rel: 'preview/acme/robots.txt', op: 'write', live: { state: 'present', bytes: enc.encode('old') }, newBytes: enc.encode('new'), overrides: [], sha256: async () => 'x', generatedOk: true });
+  assert(g2 && g2.includes('needs an override'));
+  const g3 = await liveGuard({ site: 'pageone', rel: '.htaccess', op: 'write', live: { state: 'absent' }, newBytes: enc.encode('x'), overrides: [], sha256: async () => 'x', generatedOk: true });
+  assert(g3 && g3.includes('never written'));
+});
+Deno.test('full follow-up: sitemap.xml, sitemap.txt, llms.txt updated; IndexNow = article + index only, with the site key', async () => {
+  const f = fake(F);
+  const r = await articleFollowUp(f.io, SITE, ART);
+  assertEquals([r.sitemap_xml, r.sitemap_txt, r.llms_txt, r.cards, r.indexnow], ['updated', 'updated', 'updated', 'skipped: no card file', 'sent: 200']);
+  assertEquals(f.writes, ['preview/acme/sitemap.xml', 'preview/acme/sitemap.txt', 'preview/acme/llms.txt']);
+  assertEquals(f.pings, [{ host: 'acme.sg', key: 'abc123', keyLocation: 'https://acme.sg/abc123.txt', urlList: [B + 'articles/new-one/', B + 'articles/'] }]);
+  assertStringIncludes(dec.decode(f.store.get('preview/acme/sitemap.txt')!), B + 'articles/new-one/');
+  assertStringIncludes(dec.decode(f.store.get('preview/acme/llms.txt')!), `- [New one](${B}articles/new-one/)`);
+  // second run for the same article changes nothing
+  const again = await articleFollowUp(f.io, SITE, ART);
+  assertEquals([again.sitemap_xml, again.sitemap_txt, again.llms_txt], ['unchanged', 'unchanged', 'unchanged']);
+});
+Deno.test('cards: updated when the site has a card file', async () => {
+  const f = fake({ ...F, 'preview/acme/article-cards.json': CARDS });
+  const r = await articleFollowUp(f.io, SITE, { ...ART, cat: 'Care' });
+  assertEquals(r.cards, 'updated');
+  assertEquals(JSON.parse(dec.decode(f.store.get('preview/acme/article-cards.json')!)).length, 2);
+});
+Deno.test('hold / refusal on one file does not stop the others or IndexNow', async () => {
+  const f = fake(F, { refuse: ['preview/acme/sitemap.xml'] });
+  const r = await articleFollowUp(f.io, SITE, ART);
+  assertStringIncludes(r.sitemap_xml, 'error: LIVE GUARD refused');
+  assertEquals(r.sitemap_txt, 'skipped: no sitemap.xml');
+  assertEquals(r.llms_txt, 'updated');
+  assertEquals(r.indexnow, 'sent: 200');
+});
+Deno.test('site not live or no key -> no IndexNow; missing files are not created', async () => {
+  const f = fake({});
+  assertEquals((await articleFollowUp(f.io, { ...SITE, live: false }, ART)).indexnow, 'skipped: site not live yet');
+  assertEquals((await articleFollowUp(f.io, { ...SITE, indexnowKey: '' }, ART)).indexnow, 'skipped: no IndexNow key');
+  assertEquals(f.writes, []); assertEquals(f.pings, []);
+});
+Deno.test('bad existing sitemap -> not written (content check), reported', async () => {
+  const f = fake({ 'preview/acme/sitemap.xml': XML.replace('</urlset>', '<script>x</script></urlset>') });
+  const r = await articleFollowUp(f.io, SITE, ART);
+  assertStringIncludes(r.sitemap_xml, 'not written');
+  assertEquals(f.writes, []);
+});
