+// ARTICLE FOLLOW-UP (DRAFT for review, 15 Nov 2026, Edwin: "each new article: add it to the sitemap and article-cards,
+// then send IndexNow"). ONE module used by every Controller path that writes a new article onto a client site.
+// Nothing here is saved live yet: Base44 backend code is live on save, so saving needs security review + Edwin's yes.
+//
+// After an article page is published it does, in this order, each step on its own (one failing never blocks the others):
+//   1. sitemap.xml    : add <url><loc>+<lastmod> for the articles index and the article, only when missing. Existing entries are never
+//                       dropped, changed or reordered. Output must pass the same checks as the Bridge's xmlProblem (copied below).
+//   2. sitemap.txt    : rebuilt from the sitemap.xml locs (one https URL per line).
+//   3. llms.txt       : ONE line for the article, only when its URL is missing; inserted at the end of the "## Articles" section
+//                       (or a new "## Articles" section at the end). No existing line is rewritten.
+//   4. article-cards.json : only if the site has one. One card added with exactly the live card shape; no live card dropped.
+//   5. IndexNow       : the article URL plus the articles index URL only, with the site's own key (Client.indexnow_key).
+// Writes go through safeWrite with { articleFollowUp: true }: the live guard then lets exactly these files be REPLACED
+// (see articleFollowUpProblem), and still runs every other check (HOLD flags, path rules, unknown live state).
+// Pure TypeScript, no imports, so it can be tested with fakes.
+
+// ---- checks copied VERBATIM from the Bluehost Bridge base44/shared/liveGuard.ts (xmlProblem, generatedFileProblem, articleCardsProblem) ----
+const JS_RE = /j[\s\x00-\x1f]*a[\s\x00-\x1f]*v[\s\x00-\x1f]*a[\s\x00-\x1f]*s[\s\x00-\x1f]*c[\s\x00-\x1f]*r[\s\x00-\x1f]*i[\s\x00-\x1f]*p[\s\x00-\x1f]*t[\s\x00-\x1f]*:/i;
+export const XML_ACTIVE_ELEMENTS = Object.freeze(['script', 'iframe', 'object', 'embed']);
+const decodeRefs = (t: string) => t
+  .replace(/&#x([0-9a-fA-F]+);?/g, (_, h) => { const n = parseInt(h, 16); return n <= 0x10ffff ? String.fromCodePoint(n) : ''; })
+  .replace(/&#(\d+);?/g, (_, d) => { const n = parseInt(d, 10); return n <= 0x10ffff ? String.fromCodePoint(n) : ''; })
+  .replace(/&colon;/gi, ':').replace(/&tab;/gi, '\t').replace(/&newline;/gi, '\n');
+export function xmlProblem(text: string): string | null {
+  if (JS_RE.test(text) || JS_RE.test(decodeRefs(text))) return 'javascript: is not allowed in a sitemap';
+  let s = text.replace(/^\uFEFF/, '');
+  s = s.replace(/^\s*<\?xml\b[^?]*\?>/, '');
+  const stack: string[] = []; let root = '', closedRoot = false, i = 0;
+  const textOk = (t: string) => !/&(?!(amp|lt|gt|quot|apos|#\d+|#x[0-9a-fA-F]+);)/.test(t) && !t.includes('<');
+  while (i < s.length) {
+    const lt = s.indexOf('<', i);
+    const chunk = s.slice(i, lt < 0 ? s.length : lt);
+    if (!textOk(chunk)) return 'bad character or entity in text';
+    if (chunk.trim() && (!stack.length)) return 'text outside the root element';
+    if (lt < 0) break;
+    if (s.startsWith('<!--', lt)) { const e = s.indexOf('-->', lt + 4); if (e < 0) return 'unclosed comment'; i = e + 3; continue; }
+    if (s.startsWith('<?', lt)) { const e = s.indexOf('?>', lt + 2); if (e < 0) return 'unclosed processing instruction'; i = e + 2; continue; }
+    if (s.startsWith('<![CDATA[', lt)) { if (!stack.length) return 'CDATA outside the root'; const e = s.indexOf(']]>', lt); if (e < 0) return 'unclosed CDATA'; i = e + 3; continue; }
+    if (s.startsWith('<!', lt)) return 'DOCTYPE/DTD is not allowed in a sitemap';
+    const gt = s.indexOf('>', lt); if (gt < 0) return 'unclosed tag';
+    const tag = s.slice(lt + 1, gt);
+    let m: RegExpExecArray | null;
+    if ((m = /^\/([A-Za-z_][\w:.-]*)\s*$/.exec(tag))) {
+      if (stack.pop() !== m[1]) return 'closing tag </' + m[1] + '> does not match';
+      if (!stack.length) closedRoot = true;
+    } else if ((m = /^([A-Za-z_][\w:.-]*)((?:\s+[A-Za-z_][\w:.-]*\s*=\s*(?:"[^"<]*"|'[^'<]*'))*)\s*(\/?)$/.exec(tag))) {
+      const local = m[1].replace(/^.*:/, '').toLowerCase();
+      if (XML_ACTIVE_ELEMENTS.includes(local)) return 'element <' + m[1] + '> is not allowed in a sitemap';
+      for (const a of m[2].matchAll(/\s+([A-Za-z_][\w:.-]*)\s*=\s*(?:"[^"<]*"|'[^'<]*')/g)) {
+        if (!/^xmlns(:|$)/i.test(a[1]) && /^on/i.test(a[1].replace(/^.*:/, ''))) return 'attribute ' + a[1] + ' is not allowed in a sitemap';
+      }
+      if (closedRoot) return 'more than one root element';
+      if (!stack.length && !root) root = m[1];
+      if (!m[3]) stack.push(m[1]); else if (!stack.length) closedRoot = true;
+    } else return 'malformed tag <' + tag.slice(0, 40) + '>';
+    i = gt + 1;
+  }
+  if (stack.length) return 'element <' + stack[stack.length - 1] + '> is not closed';
+  if (!root) return 'no root element';
+  if (!/^(urlset|sitemapindex)$/.test(root.replace(/^.*:/, ''))) return 'root element is <' + root + '>, not <urlset> or <sitemapindex>';
+  return null;
+}
+
+export function generatedFileProblem(rel: string, bytes: Uint8Array): string | null {
+  let text: string;
+  try { text = new TextDecoder('utf-8', { fatal: true }).decode(bytes); } catch { return 'not valid UTF-8 text'; }
+  const name = rel.split('/').pop();
+  if (name === 'llms.txt') return text.trim() ? null : 'llms.txt is empty';
+  if (name === 'sitemap.txt') {
+    const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
+    if (!lines.length) return 'sitemap.txt has 0 URLs';
+    const bad = lines.find((l) => !/^https:\/\/[^\s<>"]+$/.test(l));
+    return bad ? 'sitemap.txt has a line that is not an https URL: ' + JSON.stringify(bad.slice(0, 80)) : null;
+  }
+  const x = xmlProblem(text);
+  if (x) return 'sitemap.xml is not well-formed XML (' + x + ')';
+  const locs = [...text.matchAll(/<(?:\w+:)?loc>\s*(https?:\/\/[^<\s]+)\s*<\/(?:\w+:)?loc>/g)].length;
+  return locs ? null : 'sitemap.xml has 0 URLs';
+}
+
+export function articleCardsProblem(bytes: Uint8Array, liveBytes?: Uint8Array): string | null {
+  let text: string;
+  try { text = new TextDecoder('utf-8', { fatal: true }).decode(bytes); } catch { return 'not valid UTF-8 text'; }
+  if (JS_RE.test(text)) return 'javascript: is not allowed in article-cards.json';
+  let data: unknown;
+  try { data = JSON.parse(text.replace(/^\uFEFF/, '')); } catch (e) { return 'article-cards.json is not valid JSON (' + String((e as Error).message).slice(0, 80) + ')'; }
+  if (!Array.isArray(data)) return 'article-cards.json must be a JSON array';
+  if (data.length < 1 || data.length > 5000) return 'article-cards.json must have 1 to 5000 cards (has ' + data.length + ')';
+  const seen = new Set<string>();
+  const bad = /[<>\x00-\x1f\x7f]/;
+  for (let i = 0; i < data.length; i++) {
+    const c = data[i] as Record<string, unknown>;
+    if (!c || typeof c !== 'object' || Array.isArray(c) || Object.getPrototypeOf(c) !== Object.prototype) return 'card ' + i + ' is not an object';
+    const keys = Object.keys(c).sort().join(',');
+    if (keys !== 'cat,href,title') return 'card ' + i + ' must have exactly href, cat and title (has ' + keys.slice(0, 80) + ')';
+    const { href, cat, title } = c;
+    if (typeof href !== 'string' || typeof cat !== 'string' || typeof title !== 'string') return 'card ' + i + ': href, cat and title must be strings';
+    if (href.length > 200 || !/^\/articles\/[a-z0-9][a-z0-9-]*\.html$/.test(href)) return 'card ' + i + ': href ' + JSON.stringify(href.slice(0, 80)) + ' is not /articles/<slug>.html';
+    if (JS_RE.test(href) || JS_RE.test(cat) || JS_RE.test(title)) return 'card ' + i + ': javascript: is not allowed in article-cards.json';
+    if (seen.has(href)) return 'card ' + i + ': href ' + href + ' appears twice';
+    seen.add(href);
+    if (!title.trim() || title.length > 300 || bad.test(title)) return 'card ' + i + ': title must be 1-300 characters with no < > or control characters';
+    if (!cat.trim() || cat.length > 60 || bad.test(cat)) return 'card ' + i + ': cat must be 1-60 characters with no < > or control characters';
+  }
+  if (liveBytes) {
+    let live: unknown = null;
+    try { live = JSON.parse(new TextDecoder('utf-8').decode(liveBytes).replace(/^\uFEFF/, '')); } catch { live = null; }
+    if (Array.isArray(live)) {
+      const lost = live.map((x: any) => x && typeof x.href === 'string' ? x.href : null).filter((h): h is string => !!h && !seen.has(h));
+      if (lost.length) return 'article-cards.json would drop ' + lost.length + ' live card(s), e.g. ' + lost[0].slice(0, 120);
+    }
+  }
+  return null;
+}
+
+// ---- pure text edits (all additive) ----
+const enc = new TextEncoder();
+const dec = (b: Uint8Array) => new TextDecoder('utf-8').decode(b);
+const xmlEsc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+const xmlUnesc = (s: string) => s.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&amp;/g, '&');
+
+export const sitemapLocs = (xml: string): string[] =>
+  [...xml.matchAll(/<(?:\w+:)?loc>\s*([^<\s][^<]*?)\s*<\/(?:\w+:)?loc>/g)].map((m) => xmlUnesc(m[1]));
+
+// Adds <url><loc><lastmod> before the closing </urlset> for each url not already listed. Returns the same text when nothing is missing.
+// A sitemapindex (or anything without </urlset>) is left alone: returns null.
+export function addToSitemapXml(xml: string, urls: { loc: string; lastmod: string }[]): string | null {
+  const have = new Set(sitemapLocs(xml));
+  const add = urls.filter((u) => !have.has(u.loc));
+  if (!add.length) return xml;
+  const end = xml.lastIndexOf('</urlset>');
+  if (end < 0) return null;
+  const head = xml.slice(0, end).replace(/[ \t]*$/, '');
+  const rows = add.map((u) => `  <url><loc>${xmlEsc(u.loc)}</loc><lastmod>${u.lastmod}</lastmod></url>\n`).join('');
+  return head + (head.endsWith('\n') ? '' : '\n') + rows + xml.slice(end);
+}
+
+export const sitemapTxtFromXml = (xml: string): string => sitemapLocs(xml).join('\n') + '\n';
+
+// One line, only if the URL is missing. Goes at the end of the "## Articles" section, or a new section at the end of the file.
+export function addToLlmsTxt(txt: string, line: string, url: string): string {
+  if (txt.includes(url)) return txt;
+  const h = /^## Articles[ \t]*$/m.exec(txt);
+  if (!h) return txt.replace(/\s*$/, '') + '\n\n## Articles\n' + line + '\n';
+  const afterHead = h.index + h[0].length;
+  const next = /^## /m.exec(txt.slice(afterHead + 1));
+  const end = next ? afterHead + 1 + next.index : txt.length;
+  const section = txt.slice(afterHead, end);
+  const trimmed = section.replace(/\s*$/, '');
+  return txt.slice(0, afterHead) + trimmed + '\n' + line + '\n' + (next ? '\n' : '') + txt.slice(end);
+}
+
+// Adds one card in the live shape (same keys, same key order, 2-space indent if the live file uses it). New card goes first (newest first).
+export function addToCards(json: string, card: { href: string; cat: string; title: string }): string | null {
+  let data: any;
+  try { data = JSON.parse(json.replace(/^\uFEFF/, '')); } catch { return null; }
+  if (!Array.isArray(data)) return null;
+  if (data.some((c: any) => c && c.href === card.href)) return json;
+  const order = data[0] && typeof data[0] === 'object' ? Object.keys(data[0]) : ['href', 'cat', 'title'];
+  const shaped: Record<string, string> = {};
+  for (const k of order) shaped[k] = (card as any)[k];
+  const indent = /^\[\s*\n(\s+)\S/.exec(json)?.[1] ?? '';
+  const out = JSON.stringify([shaped, ...data], null, indent ? indent.length : undefined);
+  return out + (json.endsWith('\n') ? '\n' : '');
+}
+
+// ---- the narrow guard override ----
+// Mirrors the Bridge's GENERATED_OVERRIDE. Only a write that carries { articleFollowUp: true } may REPLACE these files, only inside a
+// Controller client-site folder, and only when the new bytes pass these checks against the live bytes. liveGuard() re-checks the path.
+export const FOLLOWUP_PATH = /^preview\/[a-z0-9][a-z0-9-]*\/(sitemap\.xml|sitemap\.txt|llms\.txt|article-cards\.json)$/;
+const lineSet = (t: string) => t.split(/\r?\n/);
+
+export function articleFollowUpProblem(rel: string, next: Uint8Array, live: Uint8Array): string | null {
+  if (!FOLLOWUP_PATH.test(rel)) return 'not an article follow-up file';
+  const name = rel.split('/').pop()!;
+  if (name === 'article-cards.json') {
+    const p = articleCardsProblem(next, live);
+    if (p) return p;
+    const a = JSON.parse(dec(next).replace(/^\uFEFF/, '')), b = JSON.parse(dec(live).replace(/^\uFEFF/, ''));
+    if (Array.isArray(b) && a.length - b.length > 1) return 'more than 1 new card';
+    return null;
+  }
+  const p = generatedFileProblem(rel, next);
+  if (p) return p;
+  const n = dec(next), l = dec(live);
+  if (name === 'sitemap.xml') {
+    const nl = sitemapLocs(n), ll = sitemapLocs(l);
+    const set = new Set(nl);
+    const lost = ll.filter((u) => !set.has(u));
+    if (lost.length) return 'sitemap.xml would drop ' + lost.length + ' live URL(s), e.g. ' + lost[0].slice(0, 120);
+    if (nl.length - ll.length > 2) return 'sitemap.xml would add more than 2 URLs';
+    // existing entries keep their order
+    const keep = nl.filter((u) => ll.includes(u));
+    if (JSON.stringify(keep) !== JSON.stringify(ll)) return 'sitemap.xml would reorder or duplicate live URLs';
+    return null;
+  }
+  if (name === 'sitemap.txt') {
+    const nl = lineSet(n).map((x) => x.trim()).filter(Boolean), ll = lineSet(l).map((x) => x.trim()).filter(Boolean);
+    const set = new Set(nl);
+    const lost = ll.filter((u) => !set.has(u));
+    if (lost.length) return 'sitemap.txt would drop ' + lost.length + ' live URL(s)';
+    if (nl.length - ll.length > 20) return 'sitemap.txt would add more than 20 URLs';
+    return null;
+  }
+  // llms.txt: every live line stays, in order; at most 2 new non-empty lines (the article line and a heading).
+  const nl = lineSet(n), ll = lineSet(l);
+  let j = 0;
+  for (const line of ll) { while (j < nl.length && nl[j] !== line) j++; if (j >= nl.length) return 'llms.txt would rewrite or drop a live line: ' + JSON.stringify(line.slice(0, 80)); j++; }
+  const liveCount = new Map<string, number>();
+  for (const x of ll) liveCount.set(x, (liveCount.get(x) || 0) + 1);
+  const added = nl.filter((x) => { const c = liveCount.get(x) || 0; if (c > 0) { liveCount.set(x, c - 1); return false; } return x.trim() !== ''; });
+  if (added.length > 2) return 'llms.txt would add more than 2 lines';
+  return null;
+}
+
+// ---- the follow-up itself ----
+export type FollowUpIO = {
+  read(rel: string): Promise<Uint8Array | null>;               // exact live bytes, or null when the file does not exist
+  write(rel: string, bytes: Uint8Array): Promise<unknown>;     // must be safeWrite(..., { articleFollowUp: true }); throws when refused
+  indexnow(body: Record<string, unknown>): Promise<number | string>;
+};
+export type FollowUpSite = {
+  root: string;            // folder prefix on the server, e.g. 'preview/acme-plumbing/'
+  domain: string;          // acme.sg
+  indexnowKey?: string;    // Client.indexnow_key
+  live: boolean;           // true once the domain answers on https (Client.live_at); IndexNow is only sent then
+  cardsFile?: string;      // default 'article-cards.json'
+};
+export type FollowUpArticle = { slug: string; title: string; published: string; cat?: string; cardHref?: string };
+export type FollowUpReport = Record<'sitemap_xml' | 'sitemap_txt' | 'llms_txt' | 'cards' | 'indexnow', string>;
+
+export async function articleFollowUp(io: FollowUpIO, site: FollowUpSite, a: FollowUpArticle): Promise<FollowUpReport> {
+  const base = `https://${site.domain}/`;
+  const articleUrl = `${base}articles/${a.slug}/`, indexUrl = `${base}articles/`;
+  const lastmod = /^\d{4}-\d{2}-\d{2}/.test(a.published) ? a.published.slice(0, 10) : new Date().toISOString().slice(0, 10);
+  const rep: FollowUpReport = { sitemap_xml: 'skipped', sitemap_txt: 'skipped', llms_txt: 'skipped', cards: 'skipped: no card file', indexnow: 'skipped' };
+  const err = (e: unknown) => 'error: ' + String((e as Error)?.message || e).slice(0, 200);
+
+  // Writes one file if the new text differs and passes its checks. Returns a status word.
+  const put = async (name: string, make: (live: string) => string | null, check: (bytes: Uint8Array, live: Uint8Array) => string | null) => {
+    const rel = site.root + name;
+    const live = await io.read(rel);
+    if (!live) return 'skipped: file not on the server';
+    const next = make(dec(live));
+    if (next === null) return 'skipped: not a plain urlset/list';
+    if (next === dec(live)) return 'unchanged';
+    const bytes = enc.encode(next);
+    const bad = check(bytes, live);
+    if (bad) return 'not written: ' + bad;
+    await io.write(rel, bytes);
+    return 'updated';
+  };
+
+  let xmlAfter = '', candidate = '';
+  try {
+    rep.sitemap_xml = await put('sitemap.xml',
+      (t) => { const r = addToSitemapXml(t, [{ loc: indexUrl, lastmod }, { loc: articleUrl, lastmod }]); if (r !== null) candidate = r; return r; },
+      (b, l) => articleFollowUpProblem(site.root + 'sitemap.xml', b, l));
+    if (rep.sitemap_xml === 'updated' || rep.sitemap_xml === 'unchanged') xmlAfter = candidate;   // sitemap.txt follows only what is really live
+  } catch (e) { rep.sitemap_xml = err(e); }
+  try {
+    if (!xmlAfter) rep.sitemap_txt = 'skipped: no sitemap.xml';
+    else rep.sitemap_txt = await put('sitemap.txt', () => sitemapTxtFromXml(xmlAfter), (b, l) => articleFollowUpProblem(site.root + 'sitemap.txt', b, l));
+  } catch (e) { rep.sitemap_txt = err(e); }
+  try {
+    rep.llms_txt = await put('llms.txt', (t) => addToLlmsTxt(t, `- [${a.title.replace(/[\[\]\r\n]/g, ' ').trim()}](${articleUrl})`, articleUrl),
+      (b, l) => articleFollowUpProblem(site.root + 'llms.txt', b, l));
+  } catch (e) { rep.llms_txt = err(e); }
+  try {
+    const cards = site.root + (site.cardsFile || 'article-cards.json');
+    if (await io.read(cards)) {
+      rep.cards = await put(site.cardsFile || 'article-cards.json',
+        (t) => addToCards(t, { href: a.cardHref || `/articles/${a.slug}.html`, cat: a.cat || 'Article', title: a.title }),
+        (b, l) => articleFollowUpProblem(cards, b, l));
+    }
+  } catch (e) { rep.cards = err(e); }
+  try {
+    if (!site.live || !site.indexnowKey) rep.indexnow = 'skipped: ' + (!site.live ? 'site not live yet' : 'no IndexNow key');
+    else {
+      const r = await io.indexnow({ host: site.domain, key: site.indexnowKey, keyLocation: `${base}${site.indexnowKey}.txt`, urlList: [articleUrl, indexUrl] });
+      rep.indexnow = 'sent: ' + r;
+    }
+  } catch (e) { rep.indexnow = err(e); }
+  return rep;
+}
