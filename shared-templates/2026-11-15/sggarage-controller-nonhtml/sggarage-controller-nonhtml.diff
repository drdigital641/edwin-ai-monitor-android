+    if (!raw || raw.startsWith('#')) continue;
+    const m = DIRECTIVE.exec(raw);
+    if (!m && lenient) continue;   // live file only: skip lines we do not understand
+    if (!m) { out.problem = 'line ' + (i + 1) + ' is not a comment or a known directive: ' + JSON.stringify(raw.slice(0, 60)); return out; }
+    const key = m[1].toLowerCase();
+    const value = m[2].replace(/\s+#.*$/, '').trim();
+    // Allow: and Disallow: with an empty value are standard ("allow everything"); every other directive needs a value.
+    if (!value && key !== 'allow' && key !== 'disallow' && !lenient) { out.problem = 'line ' + (i + 1) + ' has ' + m[1] + ' with no value'; return out; }
+    if (key === 'user-agent') {
+      if (!inAgents) group = [];
+      group.push(value.toLowerCase()); inAgents = true;
+    } else {
+      inAgents = false;
+      if (key === 'sitemap') out.sitemaps.add(value);
+      else if (key === 'disallow' && value) for (const a of group) { if (!out.disallow.has(a)) out.disallow.set(a, new Set()); out.disallow.get(a)!.add(value); }
+    }
+  }
+  return out;
+}
+// Does a robots.txt Disallow value (prefix match, * wildcard, trailing $) cover this path?
+function covers(rule: string, path: string): boolean {
+  const anchored = rule.endsWith('$');
+  const body = anchored ? rule.slice(0, -1) : rule;
+  const re = new RegExp('^' + body.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*') + (anchored ? '$' : ''));
+  return re.test(path);
+}
+
+export function robotsProblem(bytes: Uint8Array, liveBytes?: Uint8Array | null): string | null {
+  if (bytes.length === 0) return 'robots.txt is empty';
+  if (bytes.length > ROBOTS_MAX) return 'robots.txt is over 64 KB';
+  let text: string;
+  try { text = dec(bytes); } catch { return 'robots.txt is not valid UTF-8 text'; }
+  if (!stripBom(text).trim()) return 'robots.txt is empty';
+  if (text.includes('<')) return 'robots.txt contains "<"';
+  if (/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/.test(text)) return 'robots.txt contains a NUL or control character';
+  const next = parseRobots(text);
+  if (next.problem) return 'robots.txt ' + next.problem;
+  let live: Robots | null = null;
+  if (liveBytes) { try { live = parseRobots(new TextDecoder('utf-8').decode(liveBytes), true); } catch { live = null; } }
+  // The live file is read leniently (lines it does not understand are skipped), so an odd live file never lowers the bar.
+  for (const agent of PROTECTED_AGENTS) {
+    for (const rule of next.disallow.get(agent) ?? []) {
+      if (live?.disallow.get(agent)?.has(rule)) continue;       // the live file already has this exact rule
+      const hit = PROTECTED_PATHS.find((p) => covers(rule, p));
+      if (hit) return 'new "Disallow: ' + rule + '" for ' + (agent === '*' ? 'User-agent: *' : agent) + ' would block ' + hit + ' (the live file does not)';
+    }
+  }
+  for (const s of next.sitemaps) if (!SGG_URL.test(s)) return 'Sitemap: ' + JSON.stringify(s.slice(0, 80)) + ' is not an https URL on sggarage.com or www.sggarage.com';
+  if (live) for (const s of live.sitemaps) if (!next.sitemaps.has(s)) return 'would drop the live line "Sitemap: ' + s.slice(0, 80) + '"';
+  return null;
+}
+
+// ---------- sitemap.xml / sitemap.txt / llms.txt / article-cards.json / other JSON ----------
+const locs = (t: string) => [...t.matchAll(/<(?:\w+:)?loc>\s*([^<]*?)\s*<\/(?:\w+:)?loc>/g)].map((m) => m[1]);
+
+function sitemapXmlProblem(bytes: Uint8Array, liveBytes?: Uint8Array | null): string | null {
+  let text: string;
+  try { text = dec(bytes); } catch { return 'not valid UTF-8 text'; }
+  const x = xmlProblem(text);
+  if (x) return 'sitemap.xml is not well-formed XML (' + x + ')';
+  const now = new Set(locs(text));
+  if (!now.size) return 'sitemap.xml has 0 URLs';
+  if (liveBytes) {
+    let liveText: string;
+    try { liveText = new TextDecoder('utf-8').decode(liveBytes); } catch { return 'live sitemap.xml cannot be read'; }
+    const lost = locs(liveText).filter((l) => !now.has(l));
+    if (lost.length) return 'sitemap.xml would drop ' + lost.length + ' live <loc> URL(s), e.g. ' + lost[0].slice(0, 120);
+  }
+  return null;
+}
+
+function sitemapTxtProblem(bytes: Uint8Array, liveBytes?: Uint8Array | null): string | null {
+  let text: string;
+  try { text = dec(bytes); } catch { return 'not valid UTF-8 text'; }
+  const ls = lines(stripBom(text));
+  if (!ls.length) return 'sitemap.txt has 0 URLs';
+  const bad = ls.find((l) => !SGG_URL.test(l));
+  if (bad) return 'sitemap.txt has a line that is not an https URL on sggarage.com or www.sggarage.com: ' + JSON.stringify(bad.slice(0, 80));
+  if (liveBytes) {
+    const now = new Set(ls);
+    const lost = lines(stripBom(new TextDecoder('utf-8').decode(liveBytes))).filter((l) => !now.has(l));
+    if (lost.length) return 'sitemap.txt would drop ' + lost.length + ' live line(s), e.g. ' + lost[0].slice(0, 120);
+  }
+  return null;
+}
+
+function llmsProblem(bytes: Uint8Array, liveBytes?: Uint8Array | null): string | null {
+  let text: string;
+  try { text = dec(bytes); } catch { return 'not valid UTF-8 text'; }
+  if (!text.trim()) return 'llms.txt is empty';
+  if (text.includes('\0')) return 'llms.txt contains a NUL character';
+  if (/<\s*script/i.test(text)) return 'llms.txt contains "<script"';
+  if (liveBytes) {
+    const now = new Set(lines(text));
+    const lost = lines(new TextDecoder('utf-8').decode(liveBytes)).filter((l) => !now.has(l));
+    if (lost.length) return 'llms.txt would drop ' + lost.length + ' live line(s), e.g. ' + lost[0].slice(0, 120);
+  }
+  return null;
+}
+
+function jsonProblem(bytes: Uint8Array): string | null {
+  let text: string;
+  try { text = dec(bytes); } catch { return 'not valid UTF-8 text'; }
+  try { JSON.parse(stripBom(text)); } catch (e) { return 'not valid JSON (' + String((e as Error).message).slice(0, 80) + ')'; }
+  return null;
+}
+
+// Returns the reason a non-HTML overwrite must be refused, or null. liveBytes = the live file (null/undefined = a new file).
+export function nonHtmlProblem(path: string, bytes: Uint8Array, liveBytes?: Uint8Array | null): string | null {
+  const name = path.split('/').pop()!.toLowerCase();
+  if (name === 'robots.txt') return robotsProblem(bytes, liveBytes);
+  if (name === 'sitemap.xml') return sitemapXmlProblem(bytes, liveBytes);
+  if (name === 'sitemap.txt') return sitemapTxtProblem(bytes, liveBytes);
+  if (name === 'llms.txt') return llmsProblem(bytes, liveBytes);
+  if (name === 'article-cards.json') return articleCardsProblem(bytes, liveBytes ?? undefined);
+  if (/\.json$/i.test(name)) return jsonProblem(bytes);
+  return null;
+}
