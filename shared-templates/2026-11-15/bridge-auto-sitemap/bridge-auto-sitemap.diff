+// Auto sitemap tests (draft 15 Nov 2026). Run from the repo root:
+//   deno test --no-check -A --import-map tests/importmap.json base44/tests/autoSitemap.test.ts
+// Pure functions, guard calls with fake live states, and the whole hook against an in-memory fake cPanel and a fake
+// IndexNow endpoint (fetch is replaced; no network, no live site, no real IndexNow request).
+import { indexable, mergeLlms, mergeSitemap, mergeSitemapTxt, pageUrl, sitemapTxtFrom, AUTO_SITEMAP_ENABLED, AUTO_SITEMAP_EXCLUDE } from '../shared/autoSitemap.ts';
+import { autoSitemapAfter, subsiteFor } from '../shared/autoSitemapRun.ts';
+import { liveGuard, xmlProblem } from '../shared/liveGuard.ts';
+import { SITE_HOLDS } from '../shared/bridgeConfig.ts';
+import { writeFile } from '../shared/bridgeOps.ts';
+import { writeMany } from '../shared/bulkWrite.ts';
+
+const enc = (s: string) => new TextEncoder().encode(s);
+function eq(a: unknown, b: unknown, m: string) { if (JSON.stringify(a) !== JSON.stringify(b)) throw new Error(m + ': expected ' + JSON.stringify(b) + ' got ' + JSON.stringify(a)); }
+function yes(c: unknown, m: string) { if (!c) throw new Error(m); }
+
