diff -ruN -x deno.lock qul5nf-bridge-base/base44/shared/autoSitemap.ts qul5nf-bridge/base44/shared/autoSitemap.ts
--- qul5nf-bridge-base/base44/shared/autoSitemap.ts	1970-01-01 00:00:00.000000000 +0000
+++ qul5nf-bridge/base44/shared/autoSitemap.ts	2026-11-14 16:45:45.973343874 +0000
@@ -0,0 +1,214 @@
+// AUTO SITEMAP (draft, 15 Nov 2026): pure helpers used after every Bridge publish to keep a site's sitemap.xml,
+// sitemap.txt and llms.txt up to date. No I/O here. The run step is in autoSitemapRun.ts, the write rule in
+// liveGuard.ts (opts.autoSitemap). Nothing in this file ever drops or reorders an existing entry.
+import { xmlProblem } from './liveGuard.ts';
+
+// Global kill switch. false = the auto step does nothing anywhere (page writes are not affected).
+export const AUTO_SITEMAP_ENABLED = true;
+// Excluded from the auto step. "pageone" = Page One's own root (its hourly publisher rebuilds those three files).
+// "<site>:<prefix>" excludes one client folder (for example "pageone:preview/star-performance/").
+export const AUTO_SITEMAP_EXCLUDE: readonly string[] = Object.freeze(['pageone']);
+export const INDEXNOW_MAX_URLS = 1000;
+
+export type Change = { url: string; lastmod: string };
+export type LlmsPage = { url: string; title: string; desc?: string };
+
+const bare = (h: string) => h.toLowerCase().replace(/^www\./, '');
+const ctrl = /[\x00-\x1f\x7f]/g;
+const JS_SRC = 'j[\\s\\x00-\\x1f]*a[\\s\\x00-\\x1f]*v[\\s\\x00-\\x1f]*a[\\s\\x00-\\x1f]*s[\\s\\x00-\\x1f]*c[\\s\\x00-\\x1f]*r[\\s\\x00-\\x1f]*i[\\s\\x00-\\x1f]*p[\\s\\x00-\\x1f]*t[\\s\\x00-\\x1f]*:';
+const hasJs = (s: string) => new RegExp(JS_SRC, 'i').test(s);
+const unent = (s: string) => s.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&apos;|&#39;|&#x27;/g, "'").replace(/&amp;/g, '&');
+const xmlEsc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+
+// ---------- page facts ----------
+
+export function pageMeta(html: string): { title: string; desc: string } {
+  const strip = (s: string) => unent(s.replace(/<[^>]*>/g, ' ')).replace(/\s+/g, ' ').trim();
+  const t = /<title\b[^>]*>([\s\S]*?)<\/title>/i.exec(html);
+  const h1 = /<h1\b[^>]*>([\s\S]*?)<\/h1>/i.exec(html);
+  let desc = '';
+  for (const m of html.matchAll(/<meta\b[^>]*>/gi)) {
+    if (/\bname\s*=\s*["']description["']/i.test(m[0])) {
+      const c = /\bcontent\s*=\s*"([^"]*)"|\bcontent\s*=\s*'([^']*)'/i.exec(m[0]);
+      desc = c ? strip(c[1] ?? c[2] ?? '') : '';
+      break;
+    }
+  }
+  return { title: strip((t ? t[1] : '') || (h1 ? h1[1] : '')), desc };
+}
+
+function encodePath(rel: string): string {
+  return rel.split('/').map((s) => encodeURI(s)).join('/');
+}
+
+// Canonical href when it is on the same site (www or not), else the file path as a URL.
+export function pageUrl(host: string, rel: string, html: string): string {
+  for (const m of html.matchAll(/<link\b[^>]*>/gi)) {
+    if (!/\brel\s*=\s*["']?canonical["']?/i.test(m[0])) continue;
+    const h = /\bhref\s*=\s*"([^"]*)"|\bhref\s*=\s*'([^']*)'/i.exec(m[0]);
+    if (!h) continue;
+    try {
+      const u = new URL(unent((h[1] ?? h[2] ?? '').trim()));
+      if ((u.protocol === 'https:' || u.protocol === 'http:') && bare(u.hostname) === bare(host) && !u.username && !u.password) {
+        return 'https://' + u.host + u.pathname + u.search;
+      }
+    } catch { /* fall back to the file path */ }
+    break;
+  }
+  const clean = rel.replace(/^\/+/, '');
+  const path = /(^|\/)index\.html?$/i.test(clean) ? clean.replace(/index\.html?$/i, '') : clean;
+  return 'https://' + host + '/' + encodePath(path);
+}
+
+// true only for a normal public .html/.htm page.
+export function indexable(rel: string, html: string): boolean {
+  if (!/\.html?$/i.test(rel)) return false;
+  const parts = rel.split('/');
+  const name = parts[parts.length - 1].toLowerCase();
+  if (name === '404.html' || name === '404.htm') return false;
+  if (/review/i.test(name)) return false;                       // Google review helper pages and the like
+  if (/^google[0-9a-f]+\.html$/.test(name)) return false;        // Search Console verification file
+  if (rel.startsWith('preview/')) return false;                  // a preview folder is only indexable as its own client docroot (caller strips that prefix)
+  if (parts.some((p) => p.startsWith('_') || p.startsWith('.'))) return false;
+  if (!/<html\b|<title\b/i.test(html)) return false;             // a fragment, not a page
+  for (const m of html.matchAll(/<meta\b[^>]*>/gi)) {
+    const tag = m[0];
+    if (/\bname\s*=\s*["'](robots|googlebot|bingbot)["']/i.test(tag) && /\bcontent\s*=\s*["'][^"']*\b(noindex|none)\b/i.test(tag)) return false;
+    if (/\bhttp-equiv\s*=\s*["']?refresh/i.test(tag)) return false; // redirect stub
+  }
+  return true;
+}
+
+// ---------- sitemap.xml ----------
+
+const URL_BLOCK = /<(?:\w+:)?url\b[^>]*>[\s\S]*?<\/(?:\w+:)?url>/g;
+const LOC = /<loc>\s*([^<]*?)\s*<\/loc>/;
+
+// Page URLs only (plain <loc>); image:loc, video:loc and similar are kept by the merge but never listed as pages.
+export function sitemapLocs(xml: string): string[] {
+  return [...xml.matchAll(new RegExp(LOC.source, 'g'))].map((m) => unent(m[1]));
+}
+const allLocs = (xml: string) => [...xml.matchAll(/<(?:\w+:)?loc>\s*([^<]*?)\s*<\/(?:\w+:)?loc>/g)].map((m) => unent(m[1]));
+
+const okUrl = (u: string) => /^https:\/\/[^\s<>"'\\]+$/.test(u) && !hasJs(u);
+const okDate = (d: string) => /^\d{4}-\d{2}-\d{2}$/.test(d);
+
+export type MergeResult = { xml: string; changedUrls: string[]; added: string[]; bumped: string[]; rejected: string[]; error?: string };
+
+// Bumps <lastmod> of a URL that is already listed, appends a new <url> for a new one. Never removes, reorders or
+// rewrites anything else. Returns the live text untouched (with error) if the result would not pass xmlProblem.
+export function mergeSitemap(liveXml: string, changes: Change[]): MergeResult {
+  const out: MergeResult = { xml: liveXml, changedUrls: [], added: [], bumped: [], rejected: [] };
+  const live = xmlProblem(liveXml);
+  if (live) return { ...out, error: 'live sitemap.xml is not usable (' + live + ')' };
+  if (!/<(?:\w+:)?urlset\b/.test(liveXml)) return { ...out, error: 'live sitemap.xml is not a <urlset> (sitemap index files are not merged)' };
+  const byUrl = new Map<string, string>();
+  for (const c of changes) {
+    if (!okUrl(c.url) || !okDate(c.lastmod)) { out.rejected.push(c.url); continue; }
+    const prev = byUrl.get(c.url);
+    if (!prev || c.lastmod > prev) byUrl.set(c.url, c.lastmod);
+  }
+  const eol = liveXml.includes('\r\n') ? '\r\n' : '\n';
+  let xml = liveXml;
+  const fresh: [string, string][] = [];
+  for (const [url, date] of byUrl) {
+    let found = false;
+    xml = xml.replace(URL_BLOCK, (block) => {
+      if (found) return block;
+      const m = LOC.exec(block);
+      if (!m || unent(m[1]) !== url) return block;
+      found = true;
+      const lm = /<((?:\w+:)?lastmod)>\s*([^<]*?)\s*<\/(?:\w+:)?lastmod>/.exec(block);
+      if (lm) {
+        if (lm[2].slice(0, 10) >= date) return block;                         // already as new or newer
+        out.bumped.push(url);
+        return block.replace(lm[0], '<' + lm[1] + '>' + date + '</' + lm[1] + '>');
+      }
+      out.bumped.push(url);
+      return block.replace(/(<\/()loc>)(\s*)/, (_all, close, ns, ws) => close + ws + '<' + ns + 'lastmod>' + date + '</' + ns + 'lastmod>' + ws);
+    });
+    if (!found) fresh.push([url, date]);
+  }
+  if (fresh.length) {
+    const close = /<\/(?:\w+:)?urlset\s*>\s*$/.exec(xml);
+    if (!close) return { ...out, xml: liveXml, bumped: [], added: [], error: 'sitemap.xml has no closing </urlset>' };
+    const blocks = [...xml.matchAll(URL_BLOCK)];
+    const last = blocks.length ? blocks[blocks.length - 1] : null;
+    let bi = '  ', ci = '    ', multi = true;
+    if (last) {
+      const before = xml.slice(0, last.index!);
+      const nl = before.lastIndexOf('\n');
+      const pad = before.slice(nl + 1);
+      if (/^[ \t]*$/.test(pad) && nl >= 0) bi = pad; else multi = false;
+      const lp = /\n([ \t]*)<loc>/.exec(last[0]);
+      if (lp) ci = lp[1]; else if (!/\n/.test(last[0])) multi = false;
+    }
+    const mk = ([url, date]: [string, string]) => multi
+      ? bi + '<url>' + eol + ci + '<loc>' + xmlEsc(url) + '</loc>' + eol + ci + '<lastmod>' + date + '</lastmod>' + eol + bi + '</url>'
+      : '<url><loc>' + xmlEsc(url) + '</loc><lastmod>' + date + '</lastmod></url>';
+    const head = xml.slice(0, close.index);
+    const trail = /\s*$/.exec(head)![0];
+    xml = head.slice(0, head.length - trail.length) + eol + fresh.map(mk).join(eol) + (trail || eol) + xml.slice(close.index);
+    out.added.push(...fresh.map((f) => f[0]));
+  }
+  if (xml === liveXml) return out;
+  const bad = xmlProblem(xml);
+  if (bad) return { ...out, xml: liveXml, added: [], bumped: [], error: 'merged sitemap.xml failed the safety check (' + bad + ')' };
+  const locsAfter = new Set(allLocs(xml));
+  if (allLocs(liveXml).some((l) => !locsAfter.has(l))) return { ...out, xml: liveXml, added: [], bumped: [], error: 'merge would drop a live URL (refused)' };
+  return { ...out, xml, changedUrls: [...out.added, ...out.bumped] };
+}
+
+// Every <loc>, one per line.
+export function sitemapTxtFrom(xml: string): string {
+  const seen = new Set<string>();
+  const lines = sitemapLocs(xml).filter((u) => okUrl(u) && !seen.has(u) && seen.add(u));
+  return lines.length ? lines.join('\n') + '\n' : '';
+}
+
+// Keeps every live line in place and appends the sitemap URLs that are missing.
+export function mergeSitemapTxt(liveTxt: string, xml: string): { text: string; added: string[] } {
+  const eol = liveTxt.includes('\r\n') ? '\r\n' : '\n';
+  const have = new Set(liveTxt.split(/\r?\n/).map((l) => l.trim()).filter(Boolean));
+  const add = sitemapTxtFrom(xml).split('\n').filter((u) => u && !have.has(u));
+  if (!add.length) return { text: liveTxt, added: [] };
+  const base = liveTxt.length && !/\n$/.test(liveTxt) ? liveTxt + eol : liveTxt;
+  return { text: base + add.join(eol) + eol, added: add };
+}
+
+// ---------- llms.txt ----------
+
+export function cleanLlmsText(s: string, max: number): string {
+  let t = String(s ?? '').replace(ctrl, ' ').replace(/[<>\[\]]/g, '');
+  for (let i = 0; i < 5 && hasJs(t); i++) t = t.replace(new RegExp(JS_SRC, 'gi'), '');
+  return t.replace(/\s+/g, ' ').trim().slice(0, max);
+}
+
+// Adds "- [title](url): desc" for URLs not yet in the file. Never removes or rewrites a line.
+export function mergeLlms(liveText: string, pages: LlmsPage[]): { text: string; added: string[] } {
+  const eol = liveText.includes('\r\n') ? '\r\n' : '\n';
+  const lines = liveText.split(/\r?\n/);
+  const fresh: { url: string; line: string }[] = [];
+  const seen = new Set<string>();
+  for (const p of pages) {
+    if (!okUrl(p.url) || seen.has(p.url) || liveText.includes(p.url)) continue;
+    seen.add(p.url);
+    const title = cleanLlmsText(p.title, 200) || p.url.replace(/^https:\/\//, '');
+    const desc = cleanLlmsText(p.desc || '', 300);
+    fresh.push({ url: p.url, line: '- [' + title + '](' + p.url + ')' + (desc ? ': ' + desc : '') });
+  }
+  if (!fresh.length) return { text: liveText, added: [] };
+  const add = fresh.map((f) => f.line);
+  for (const name of ['Articles', 'Pages', 'Recent pages']) {
+    const head = lines.findIndex((l) => new RegExp('^##\\s+' + name + '\\s*$', 'i').test(l));
+    if (head < 0) continue;
+    let end = lines.length;
+    for (let i = head + 1; i < lines.length; i++) if (/^#{1,6}\s/.test(lines[i])) { end = i; break; }
+    let at = end;
+    while (at > head + 1 && lines[at - 1].trim() === '') at--;
+    lines.splice(at, 0, ...add);
+    return { text: lines.join(eol), added: fresh.map((f) => f.url) };
+  }
+  const base = liveText.length && !/\n$/.test(liveText) ? liveText + eol : liveText;
+  return { text: base + (base.trim() ? eol : '') + '## Recent pages' + eol + add.join(eol) + eol, added: fresh.map((f) => f.url) };
+}
diff -ruN -x deno.lock qul5nf-bridge-base/base44/shared/autoSitemapRun.ts qul5nf-bridge/base44/shared/autoSitemapRun.ts
--- qul5nf-bridge-base/base44/shared/autoSitemapRun.ts	1970-01-01 00:00:00.000000000 +0000
+++ qul5nf-bridge/base44/shared/autoSitemapRun.ts	2026-11-14 16:54:58.451935981 +0000
@@ -0,0 +1,194 @@
+// AUTO SITEMAP RUN STEP (draft, 15 Nov 2026). After a successful publish (sync_from_github, write_files, write_file,
+// edit_file) this rebuilds the site's sitemap.xml, sitemap.txt and llms.txt from what was just written, then sends
+// IndexNow for the pages that changed. It runs AFTER the page writes and can never fail or undo them: every problem
+// is returned in the tool result as `autoSitemap`. The three files are written through writeFile() with
+// opts.autoSitemap, so the live guard (AUTO SITEMAP RULE in liveGuard.ts) and the BRIDGE HOLD both still apply.
+import { SITES, SITE_HOLDS, holdReason } from './bridgeConfig.ts';
+import { BridgeError, readFile, writeFile, listDir, sha256 } from './bridgeOps.ts';
+import { CLIENT_PINNED_ASSETS } from './clientAssets.ts';
+import {
+  AUTO_SITEMAP_ENABLED, AUTO_SITEMAP_EXCLUDE, INDEXNOW_MAX_URLS, indexable, mergeLlms, mergeSitemap, mergeSitemapTxt,
+  pageMeta, pageUrl, sitemapLocs, type LlmsPage,
+} from './autoSitemap.ts';
+
+export type Written = { path: string; bytes?: Uint8Array };
+type Sub = { prefix: string; domain: string };
+type Text = { text: string; sha: string };
+
+// The hourly publisher rewrites a pinned file whenever its live sha differs from the pin, so a write to a pinned path
+// would be reverted at the next run. Pinned = listed in CLIENT_PINNED_ASSETS (clientAssets.ts), keyed by the path from the
+// docroot of the 'pageone' site. The pins in pageoneArticles.ts cover Page One's own root, which this step never writes.
+const isPinned = (site: string, rel: string) => site === 'pageone' && CLIENT_PINNED_ASSETS.some((a) => a.rel === rel);
+
+const bareHost = (h: string) => h.toLowerCase().replace(/^www\./, '');
+
+// Which client folder (or the site root) a written path belongs to; null = not covered.
+export function subsiteFor(site: string, path: string): Sub | null {
+  if (!(site in SITES)) return null;
+  if (site === 'pageone') {
+    for (const h of SITE_HOLDS) {
+      if (h.site !== site || !h.prefix) continue;
+      const domain = /\(([^)]+)\)/.exec(h.name)?.[1];
+      if (domain && path.startsWith(h.prefix)) return AUTO_SITEMAP_EXCLUDE.includes(site + ':' + h.prefix) ? null : { prefix: h.prefix, domain };
+    }
+    return AUTO_SITEMAP_EXCLUDE.includes(site) ? null : { prefix: '', domain: SITES.pageone.domain };
+  }
+  if (AUTO_SITEMAP_EXCLUDE.includes(site)) return null;
+  return { prefix: '', domain: SITES[site as keyof typeof SITES].domain };
+}
+
+async function readText(site: string, rel: string): Promise<Text | null | 'unreadable'> {
+  try {
+    const r: any = await readFile(site, rel);
+    return typeof r.content === 'string' ? { text: r.content, sha: r.sha256 } : 'unreadable';
+  } catch (e) {
+    return e instanceof BridgeError && e.status === 404 ? null : 'unreadable';
+  }
+}
+
+const sgDate = () => new Date(Date.now() + 8 * 3600_000).toISOString().slice(0, 10);
+
+async function findIndexNowKey(site: string, prefix: string): Promise<string | null> {
+  try {
+    const listing = await listDir(site, prefix.replace(/\/$/, ''));
+    const names = (listing.entries as any[]).filter((e) => e.type === 'file' && /^[0-9a-f]{32}\.txt$/.test(e.name)).map((e) => e.name as string).slice(0, 3);
+    for (const n of names) {
+      const t = await readText(site, prefix + n);
+      if (t && t !== 'unreadable' && t.text.trim() === n.slice(0, -4)) return n.slice(0, -4);
+    }
+  } catch { /* no key */ }
+  return null;
+}
+
+async function sendIndexNow(host: string, key: string, urls: string[]) {
+  const urlList = urls.slice(0, INDEXNOW_MAX_URLS);
+  try {
+    const res = await fetch('https://api.indexnow.org/indexnow', {
+      method: 'POST', headers: { 'Content-Type': 'application/json; charset=utf-8' }, signal: AbortSignal.timeout(15_000),
+      body: JSON.stringify({ host, key, keyLocation: 'https://' + host + '/' + key + '.txt', urlList }),
+    });
+    return { status: res.status === 200 || res.status === 202 ? 'sent' : 'error', http: res.status, urls: urlList.length };
+  } catch (e) {
+    return { status: 'error', error: (e instanceof Error ? e.message : String(e)).slice(0, 100), urls: urlList.length };
+  }
+}
+
+async function runGroup(site: string, sub: Sub, items: Written[], dryRun: boolean, today: string) {
+  const { prefix } = sub;
+  const g: any = { prefix: prefix || '/', host: null, status: 'skipped', pages: 0, added: [], bumped: [], files: {}, indexnow: { status: 'skipped' } };
+  const pages: { rel: string; html: string }[] = [];
+  for (const it of items) {
+    const rel = it.path.slice(prefix.length);
+    let bytes = it.bytes;
+    if (!bytes && /\.html?$/i.test(rel)) { const t = await readText(site, it.path); bytes = t && t !== 'unreadable' ? new TextEncoder().encode(t.text) : undefined; }
+    if (!bytes) continue;
+    const html = new TextDecoder('utf-8').decode(bytes);
+    if (indexable(rel, html)) pages.push({ rel, html });
+  }
+  g.pages = pages.length;
+  if (!pages.length) { g.reason = 'no indexable .html page was written'; return g; }
+
+  const held = holdReason(site, prefix + 'sitemap.xml');
+  if (held) { g.status = 'held'; g.reason = held; return g; }
+  const xml = await readText(site, prefix + 'sitemap.xml');
+  if (!xml) { g.reason = 'sitemap.xml not found on the site (never created from nothing)'; return g; }
+  if (xml === 'unreadable') { g.reason = 'sitemap.xml could not be read from the server'; return g; }
+
+  // The site host is the one the live sitemap already uses for this domain (www or not).
+  const hosts = sitemapLocs(xml.text).map((l) => { try { return new URL(l).host; } catch { return ''; } }).filter((h) => h && bareHost(h) === bareHost(sub.domain));
+  const host = hosts.sort((a, b) => hosts.filter((x) => x === b).length - hosts.filter((x) => x === a).length)[0];
+  if (!host) { g.reason = 'no URL of ' + sub.domain + ' in the live sitemap.xml'; return g; }
+  g.host = host;
+
+  const meta = pages.map((p) => ({ url: pageUrl(host, p.rel, p.html), ...pageMeta(p.html) }));
+  const merged = mergeSitemap(xml.text, meta.map((m) => ({ url: m.url, lastmod: today })));
+  if (merged.error) { g.status = 'error'; g.reason = merged.error; return g; }
+  g.added = merged.added; g.bumped = merged.bumped;
+  const todo: { rel: string; text: string; sha: string }[] = [];
+  if (merged.xml !== xml.text) todo.push({ rel: 'sitemap.xml', text: merged.xml, sha: xml.sha });
+  else g.files['sitemap.xml'] = 'unchanged';
+
+  const txt = await readText(site, prefix + 'sitemap.txt');
+  if (!txt || txt === 'unreadable') g.files['sitemap.txt'] = 'skipped: ' + (txt ? 'unreadable' : 'not on the site');
+  else {
+    const t = mergeSitemapTxt(txt.text, merged.xml);
+    if (t.text !== txt.text) todo.push({ rel: 'sitemap.txt', text: t.text, sha: txt.sha }); else g.files['sitemap.txt'] = 'unchanged';
+  }
+  const llms = await readText(site, prefix + 'llms.txt');
+  if (!llms || llms === 'unreadable') g.files['llms.txt'] = 'skipped: ' + (llms ? 'unreadable' : 'not on the site');
+  else {
+    const l = mergeLlms(llms.text, meta.map((m): LlmsPage => ({ url: m.url, title: m.title, desc: m.desc })));
+    if (l.text !== llms.text) todo.push({ rel: 'llms.txt', text: l.text, sha: llms.sha }); else g.files['llms.txt'] = 'unchanged';
+  }
+
+  const sameHost = (u: string) => { try { return bareHost(new URL(u).hostname) === bareHost(sub.domain); } catch { return false; } };
+  const nowUrls = [...new Set(meta.map((m) => m.url).filter(sameHost))];
+  const key = await findIndexNowKey(site, prefix);
+
+  // Pinned generated files are not written: report them with the sha the pin would need.
+  const pinned: typeof todo = [];
+  for (const t of [...todo]) {
+    if (!isPinned(site, prefix + t.rel)) continue;
+    pinned.push(t); todo.splice(todo.indexOf(t), 1);
+    g.files[t.rel] = { file: prefix + t.rel, skipped: 'pinned: re-pin to new sha needed', newSha: await sha256(new TextEncoder().encode(t.text)) };
+  }
+  if (pinned.length) g.pinned = pinned.map((t) => prefix + t.rel);
+
+  if (dryRun) {
+    for (const t of todo) g.files[t.rel] = 'would update';
+    g.status = 'dry_run';
+    g.indexnow = key ? { status: 'would send', urls: nowUrls.slice(0, INDEXNOW_MAX_URLS) } : { status: 'skipped', reason: 'no IndexNow key file in the site folder' };
+    return g;
+  }
+
+  let failed = 0, xmlFailed = false;
+  for (const t of todo) {
+    if (t.rel === 'sitemap.txt' && xmlFailed) { g.files[t.rel] = 'skipped: sitemap.xml was not written'; continue; }
+    try {
+      const r: any = await writeFile(site, prefix + t.rel, new TextEncoder().encode(t.text), t.sha, { autoSitemap: true });
+      g.files[t.rel] = r.unchanged ? 'unchanged' : 'written';
+    } catch (e) {
+      failed++; if (t.rel === 'sitemap.xml') xmlFailed = true;
+      g.files[t.rel] = 'error: ' + (e instanceof Error ? e.message : String(e)).slice(0, 300);
+    }
+  }
+  g.status = failed ? (failed === todo.length ? 'error' : 'partial') : 'ok';
+  if (!key) g.indexnow = { status: 'skipped', reason: 'no IndexNow key file in the site folder' };
+  else if (!nowUrls.length) g.indexnow = { status: 'skipped', reason: 'no URL on the site host' };
+  else g.indexnow = await sendIndexNow(host, key, nowUrls);
+  return g;
+}
+
+// `written`: the files this publish created or changed (or, with dryRun, would). Never throws.
+export async function autoSitemapAfter(args: { site: string; written: Written[]; dryRun?: boolean; today?: string }) {
+  try {
+    if (!AUTO_SITEMAP_ENABLED) return { status: 'disabled' };
+    const groups = new Map<string, { sub: Sub; items: Written[] }>();
+    for (const w of args.written) {
+      if (!/\.html?$/i.test(w.path)) continue;
+      const sub = subsiteFor(args.site, w.path);
+      if (!sub) continue;
+      const g = groups.get(sub.prefix) || { sub, items: [] };
+      g.items.push(w); groups.set(sub.prefix, g);
+    }
+    if (!groups.size) return { status: 'nothing', reason: 'no .html page of a covered site was written' };
+    const today = args.today || sgDate();
+    const out: any[] = [];
+    for (const { sub, items } of groups.values()) {
+      try { out.push(await runGroup(args.site, sub, items, args.dryRun === true, today)); }
+      catch (e) { out.push({ prefix: sub.prefix || '/', status: 'error', reason: (e instanceof Error ? e.message : String(e)).slice(0, 300) }); }
+    }
+    const st = (s: string) => out.some((g: any) => g.status === s);
+    const status = st('error') ? 'error' : st('partial') ? 'partial' : st('held') ? 'held' : st('dry_run') ? 'dry_run' : st('ok') ? 'ok' : 'skipped';
+    return { status, added: out.flatMap((g: any) => g.added || []), bumped: out.flatMap((g: any) => g.bumped || []),
+      indexnow: out.length === 1 ? (out[0] as any).indexnow : out.map((g: any) => g.indexnow), groups: out };
+  } catch (e) {
+    return { status: 'error', reason: (e instanceof Error ? e.message : String(e)).slice(0, 300) };
+  }
+}
+
+// For the single-file tools: adds `autoSitemap` to a successful, changed write result. A failure here never changes `result`.
+export async function attachAutoSitemap<T extends Record<string, any>>(site: string, result: T, written: Written[]): Promise<T & { autoSitemap?: unknown }> {
+  if (!result || result.saved !== true) return result;
+  return { ...result, autoSitemap: await autoSitemapAfter({ site, written }) };
+}
