+  yes(indexable('a.html', PAGE().replace('</head>', '<meta name="robots" content="index,follow"></head>')), 'index,follow is fine');
+});
+
+Deno.test('mergeSitemap: bump, add, never drop or reorder, keep other tags byte for byte, idempotent', () => {
+  const extra = '\n  <url>\n    <loc>https://www.cleanicdetailing.com/g/</loc>\n    <xhtml:link rel="alternate" hreflang="en" href="https://www.cleanicdetailing.com/g/"/>\n    <image:image><image:loc>https://cdn.example/a.jpg</image:loc></image:image>\n  </url>';
+  const live = SM([H + '/', H + '/a/', H + '/b/'], extra);
+  const r = mergeSitemap(live, [{ url: H + '/a/', lastmod: '2026-11-15' }, { url: H + '/new/', lastmod: '2026-11-15' }, { url: H + '/g/', lastmod: '2026-11-15' }]);
+  eq(r.error, undefined, 'no error');
+  eq(r.added, [H + '/new/'], 'added'); eq(r.bumped, [H + '/a/', H + '/g/'], 'bumped (also a block with no lastmod)');
+  eq(r.changedUrls, [H + '/new/', H + '/a/', H + '/g/'], 'changedUrls');
+  eq(xmlProblem(r.xml), null, 'passes xmlProblem');
+  const order = (x: string) => [...x.matchAll(/<loc>([^<]+)<\/loc>/g)].map((m) => m[1]);
