+  + urls.map((u) => `  <url>\n    <loc>${u}</loc>\n    <lastmod>2026-01-01</lastmod>\n  </url>`).join('\n') + extra + '\n</urlset>\n';
+const H = 'https://www.cleanicdetailing.com';
+const PAGE = (title = 'Brake Service', canonical = '') => `<!doctype html><html><head><title>${title}</title><meta name="description" content="About ${title}">${canonical}</head><body><h1>${title}</h1></body></html>`;
+
+// ---------------- pure functions ----------------
+
+Deno.test('pageUrl: canonical on the same host wins, else the file path becomes the URL', () => {
+  const c = (h: string) => `<link rel="canonical" href="${h}">`;
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a', c('https://www.x.sg/x/'))), 'https://www.x.sg/x/', 'canonical');
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a', c('https://x.sg/x/'))), 'https://x.sg/x/', 'canonical apex of same site');
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a', c('http://www.x.sg/x/'))), 'https://www.x.sg/x/', 'http canonical upgraded');
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a', c('https://evil.example/x/'))), 'https://www.x.sg/x/', 'foreign canonical ignored');
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a', c('javascript:alert(1)'))), 'https://www.x.sg/x/', 'javascript canonical ignored');
+  eq(pageUrl('www.x.sg', 'x/index.html', PAGE('a')), 'https://www.x.sg/x/', 'x/index.html');
+  eq(pageUrl('www.x.sg', 'index.html', PAGE('a')), 'https://www.x.sg/', 'index.html');
+  eq(pageUrl('www.x.sg', 'a/b.html', PAGE('a')), 'https://www.x.sg/a/b.html', 'a/b.html');
+  eq(pageUrl('www.x.sg', 'a b/c (1).html', PAGE('a')), 'https://www.x.sg/a%20b/c%20(1).html', 'encoded');
+});
+
+Deno.test('indexable: only real public pages', () => {
+  yes(indexable('a/index.html', PAGE()), 'normal page');
+  yes(indexable('about.htm', PAGE()), '.htm page');
+  for (const [rel, html, why] of [
+    ['a.css', PAGE(), 'not html'], ['404.html', PAGE(), '404'], ['review.html', PAGE(), 'review helper'], ['google-review-helper.html', PAGE(), '*review*'],
+    ['a/Review.html', PAGE(), 'review in a folder'], ['preview/x/index.html', PAGE(), 'preview folder'], ['google1a2b3c.html', PAGE(), 'verification file'],
+    ['n.html', PAGE().replace('</head>', '<meta name="robots" content="noindex, follow"></head>'), 'noindex'],
+    ['n.html', PAGE().replace('</head>', '<meta content="NOINDEX" name="googlebot"></head>'), 'noindex googlebot, content first'],
+    ['r.html', '<html><head><meta http-equiv="refresh" content="0; url=/x/"></head></html>', 'meta refresh stub'],
+    ['inc/part.html', '<div>fragment</div>', 'fragment'], ['_draft/a.html', PAGE(), 'underscore folder'],
