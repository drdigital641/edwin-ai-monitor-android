   const hit = rows.find((r: any) => String(r.file) === file);
   return hit ? String(hit.type) : 'absent';
 }
+
+// ---------- BOT DROP FOLDER (Edwin 15 Nov 2026 10:31am SGT) ----------
+// Bot-prepared files are kept in ~/bluehost-bridge-private/drops/<drop id>/<path>: outside public_html (never served,
+// never indexable) and inside the private folder the cPanel choke point already allows. No site file is touched here;
+// placing a dropped file on a site goes through writeFile() above with every guard (drops.ts dropPublish).
+export const DROP_ROOT = PRIVATE_ROOT + '/drops';
+const DROP_REL = /^[A-Za-z0-9]{6,40}(\/[A-Za-z0-9][A-Za-z0-9_-]{0,99}){0,2}\/[A-Za-z0-9][A-Za-z0-9_-]{0,99}\.[a-z]{2,4}$/;
+function dropAbs(rel: string) {
+  if (typeof rel !== 'string' || !DROP_REL.test(rel)) throw new BridgeError('Bad drop file path', 400);
+  return DROP_ROOT + '/' + rel;
+}
+export async function putDropBytes(rel: string, bytes: Uint8Array) {
+  const abs = dropAbs(rel);
+  await ensureDirTree(splitAbs(abs).dir, '0700', PRIVATE_ROOT);
+  await putBytes(abs, bytes);
+  if ((await contentSha(abs)) !== await sha256(bytes)) throw new BridgeError('The dropped file could not be verified on the server; send it again.', 502);
+}
+export async function readDropBytes(rel: string): Promise<FileBytes> {
+  const f = await readBytes(dropAbs(rel));
+  if (!f) throw new BridgeError('The dropped file is missing on the server', 404);
+  return f;
+}
diff -ruN pbase/base44/shared/drops.ts pnew/base44/shared/drops.ts
--- pbase/base44/shared/drops.ts	1970-01-01 00:00:00.000000000 +0000
+++ pnew/base44/shared/drops.ts	2026-11-15 02:45:33.658885570 +0000
@@ -0,0 +1,343 @@
+// BOT DROP FOLDER (Edwin 15 Nov 2026 10:31am SGT): "add a safe way for my bots to hand files to you through the Bridge,
+// which you then check and publish". Bots hold a separate key (scope 'drop') that can ONLY run drop_put and drop_status.
+// Files land in ~/bluehost-bridge-private/drops/<drop id>/ (outside public_html: never served, never indexable).
+// Claude (signed-in session only, never a key) lists, reads, publishes and clears drops. Publishing a dropped file uses
+// writeFile(): HOLD, blocked names, live guard, compare-and-swap base hash, private backup and byte-exact readback.
+import { BridgeError, sha256, putDropBytes, readDropBytes, writeFile, readFile, normalizeRel } from './bridgeOps.ts';
+import { SITES, secretContentReason } from './bridgeConfig.ts';
+import { AUTO_SITEMAP_CLIENT_FOLDERS } from './liveGuard.ts';
+import { assertNotClaimed } from './sync.ts';
+
+export const DROP_LIMITS = Object.freeze({
+  imageBytes: 1_000_000, // cPanel reads back at most ~1 MB, and every stored file is verified by reading it back
+  jsonBytes: 512_000,
+  textBytes: 256_000,
+  dropBytes: 15_000_000,
+  filesPerDrop: 40,
+  openDropsPerKey: 10,
+  days: 7, // a drop not cleared within 7 days of creation expires and its files are wiped
+  pathChars: 160,
+  publishPerCall: 40,
+});
+const KINDS: Record<string, 'json' | 'image' | 'text'> = Object.freeze({ json: 'json', webp: 'image', jpg: 'image', jpeg: 'image', png: 'image', md: 'text', txt: 'text' });
+export const DROP_TYPES = Object.freeze(Object.keys(KINDS));
+const OPEN_STATES = ['open', 'ready'];
+const db = (base44: any) => base44.asServiceRole.entities;
+const now = () => new Date().toISOString();
+
+// ---------- checks (pure, unit-tested) ----------
+
+export type DropTarget = { target: string; site: string; base: string };
+// A drop names the live website by its domain (or Bridge site key / client folder slug). Page One client sites that are
+// served from pageone preview/<slug> map to site 'pageone' + base 'preview/<slug>'.
+export function dropTarget(input: unknown): DropTarget {
+  if (typeof input !== 'string' || !input.trim()) throw new BridgeError('site is required, e.g. maisoninteriordesign.sg');
+  const v = input.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/+$/, '').replace(/^www\./, '');
+  for (const [key, s] of Object.entries(SITES)) if (v === key || v === s.domain) return { target: s.domain, site: key, base: '' };
+  for (const [slug, domain] of Object.entries(AUTO_SITEMAP_CLIENT_FOLDERS)) if (v === domain || v === slug) return { target: domain, site: 'pageone', base: 'preview/' + slug };
+  throw new BridgeError('Unknown site for a drop. Use the live domain, e.g. maisoninteriordesign.sg', 400);
+}
+
+export function dropJob(input: unknown): string {
+  if (typeof input !== 'string' || !/^[a-z0-9][a-z0-9-]{1,59}$/.test(input)) throw new BridgeError('job must be a short slug: lowercase letters, digits and -, e.g. grand-dunman');
+  return input;
+}
+
+const SEG = /^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$/;
+const NAME = /^[A-Za-z0-9][A-Za-z0-9_-]{0,99}\.([A-Za-z0-9]{1,8})$/;
+const SECRET_NAME = /(secret|passw|credential|token|api[-_]?key|private[-_]?key|id_rsa|id_ed25519|htaccess|htpasswd|wp-config|(^|[^a-z])env([^a-z]|$))/i;
+export type DropPath = { rel: string; ext: string; kind: 'json' | 'image' | 'text' };
+// Paths inside a drop: at most 2 folders deep, letters/digits/-/_ only, exactly one dot (so no a.php.jpg), allowed types only.
+export function dropPath(input: unknown): DropPath {
+  if (typeof input !== 'string' || !input) throw new BridgeError('path is required, e.g. grand-dunman.json or images/hero.webp');
+  if (input.length > DROP_LIMITS.pathChars) throw new BridgeError('path is longer than ' + DROP_LIMITS.pathChars + ' characters');
+  if (/[\0\\%\x00-\x1f\x7f]/.test(input)) throw new BridgeError('Invalid characters in path');
+  if (/^[a-z]+:/i.test(input) || input.startsWith('/') || input.startsWith('~')) throw new BridgeError('path must be relative to the drop, e.g. images/hero.webp');
+  const parts = input.split('/');
+  if (parts.some((p) => p === '..' || p === '.')) throw new BridgeError('Path traversal is not allowed');
+  if (parts.some((p) => p === '')) throw new BridgeError('path has an empty folder name');
+  if (parts.length > 3) throw new BridgeError('path may be at most 2 folders deep');
+  const name = parts[parts.length - 1];
+  for (const p of parts.slice(0, -1)) if (!SEG.test(p)) throw new BridgeError('Folder names may use letters, digits, - and _ only');
+  const m = NAME.exec(name);
+  if (!m) throw new BridgeError('File names must be <name>.<type> using letters, digits, - and _ with exactly one dot (refused: ' + name.slice(0, 60) + ')');
+  const ext = m[1].toLowerCase();
+  if (!Object.hasOwn(KINDS, ext)) throw new BridgeError('File type .' + ext + ' is not allowed in a drop. Allowed: .json .webp .jpg .jpeg .png .md .txt', 415);
+  if (SECRET_NAME.test(input)) throw new BridgeError('File and folder names that look like secrets or server config are refused', 403);
+  return { rel: parts.slice(0, -1).concat(name.slice(0, name.length - m[1].length) + ext).join('/'), ext, kind: KINDS[ext] };
+}
+
+const has = (b: Uint8Array, sig: number[], at = 0) => b.length >= at + sig.length && sig.every((x, i) => b[at + i] === x);
+function magicOk(ext: string, b: Uint8Array) {
+  if (ext === 'png') return has(b, [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+  if (ext === 'jpg' || ext === 'jpeg') return has(b, [0xff, 0xd8, 0xff]);
+  if (ext === 'webp') return has(b, [0x52, 0x49, 0x46, 0x46]) && has(b, [0x57, 0x45, 0x42, 0x50], 8);
+  return false;
+}
+const latin1 = (b: Uint8Array) => { let s = ''; for (let i = 0; i < b.length; i += 32768) s += String.fromCharCode(...b.subarray(i, i + 32768)); return s; };
+const CODE = /<\?php|<\?=|<script[\s>\/]|<%[=@\s]|^#!\s*\//im;
+const BRIDGE_KEY_TEXT = /\bbb_[A-Za-z0-9_-]{40,}/;
+export function sizeLimit(kind: string) { return kind === 'image' ? DROP_LIMITS.imageBytes : kind === 'json' ? DROP_LIMITS.jsonBytes : DROP_LIMITS.textBytes; }
+
+// null = the bytes are acceptable for this file type.
+export function dropContentProblem(p: DropPath, bytes: Uint8Array): string | null {
+  if (!bytes.length) return 'the file is empty';
+  if (bytes.length > sizeLimit(p.kind)) return 'the file is ' + bytes.length + ' bytes; the limit for .' + p.ext + ' is ' + sizeLimit(p.kind) + ' bytes';
+  if (p.kind === 'image') {
+    if (!magicOk(p.ext, bytes)) return 'this is not a real .' + p.ext + ' image (the file header does not match; archives and programs are refused)';
+    if (CODE.test(latin1(bytes))) return 'the image contains script or server code';
+    return null;
+  }
+  let text: string;
+  try { text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: false }).decode(bytes); } catch { return 'the file is not valid UTF-8 text'; }
+  if (/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/.test(text)) return 'the file has control characters (binary data, archive or program)';
+  if (CODE.test(text)) return 'the file contains script tags or server code';
+  if (secretContentReason(text) || BRIDGE_KEY_TEXT.test(text)) return 'the file looks like it contains a password, key or token';
+  if (p.kind === 'json') { try { JSON.parse(text.replace(/^﻿/, '')); } catch { return 'the file is not valid JSON'; } }
+  return null;
+}
+
+export function decodeDropBytes(body: any): Uint8Array {
+  const t = typeof body?.content === 'string', b = typeof body?.content_base64 === 'string';
+  if (t === b) throw new BridgeError('Send exactly one of content (text) or content_base64 (binary)');
+  if (t) return new TextEncoder().encode(body.content);
+  const clean = body.content_base64.replace(/\s+/g, '');
+  if (clean.length > Math.ceil(DROP_LIMITS.imageBytes / 3) * 4 + 8) throw new BridgeError('content_base64 is larger than the 1 MB file limit', 413);
+  let bin: string;
+  try { bin = atob(clean); } catch { throw new BridgeError('content_base64 is not valid base64'); }
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+// Width x height from the image header (for review only; null if not found).
+export function imageSize(ext: string, b: Uint8Array): { width: number; height: number } | null {
+  const u16 = (i: number) => (b[i] << 8) | b[i + 1], l16 = (i: number) => b[i] | (b[i + 1] << 8), l24 = (i: number) => b[i] | (b[i + 1] << 8) | (b[i + 2] << 16);
+  if (ext === 'png' && b.length > 24) return { width: (u16(16) << 16) | u16(18), height: (u16(20) << 16) | u16(22) };
+  if (ext === 'webp' && b.length > 30) {
+    const kind = latin1(b.subarray(12, 16));
+    if (kind === 'VP8X') return { width: l24(24) + 1, height: l24(27) + 1 };
+    if (kind === 'VP8 ') return { width: l16(26) & 0x3fff, height: l16(28) & 0x3fff };
+    if (kind === 'VP8L') { const v = b[21] | (b[22] << 8) | (b[23] << 16) | (b[24] << 24); return { width: (v & 0x3fff) + 1, height: ((v >> 14) & 0x3fff) + 1 }; }
+  }
+  if (ext === 'jpg' || ext === 'jpeg') {
+    let i = 2;
+    while (i + 9 < b.length) {
+      if (b[i] !== 0xff) return null;
+      const m = b[i + 1];
+      if (m >= 0xc0 && m <= 0xcf && m !== 0xc4 && m !== 0xc8 && m !== 0xcc) return { width: u16(i + 7), height: u16(i + 5) };
+      i += 2 + u16(i + 2);
+    }
+  }
+  return null;
+}
+
+// ---------- store ----------
+
+const fileView = (f: any) => ({ path: f.path, type: f.ext, bytes: f.bytes, sha256: f.sha256, state: f.state, dropped_at: f.dropped_at, dropped_by: f.dropped_by,
+  published_to: f.published_to || null, published_at: f.published_at || null });
+const dropView = (d: any) => ({ drop_id: d.id, site: d.target, job: d.job, state: d.state, bridge_site: d.site, base_path: d.base_path || '',
+  created_at: d.created_date || null, created_by: d.created_by_label, last_drop_at: d.last_drop_at || null, ready_at: d.ready_at || null,
+  expires_at: d.expires_at, published_at: d.published_at || null, cleared_at: d.cleared_at || null, bot_note: d.bot_note || null, review_note: d.review_note || null });
+
+async function filesOf(base44: any, dropId: string) {
+  return await db(base44).BridgeDropFile.filter({ drop_id: dropId }, '-created_date', 500);
+}
+const current = (rows: any[]) => rows.filter((f) => f.state === 'stored');
+
+async function openDrop(base44: any, t: DropTarget, job: string) {
+  for (const state of OPEN_STATES) {
+    const rows = await db(base44).BridgeDrop.filter({ target: t.target, job, state }, '-created_date', 1);
+    if (rows[0] && Date.parse(rows[0].expires_at) > Date.now()) return rows[0];
+  }
+  return null;
+}
+
+async function wipe(dropId: string, rel: string) {
+  // The choke point never deletes files; a cleared drop file is overwritten so no content remains.
+  try { await putDropBytes(dropId + '/' + rel, new Uint8Array(0)); } catch { await putDropBytes(dropId + '/' + rel, new TextEncoder().encode('cleared\n')); }
+}
+
+async function clearDrop(base44: any, drop: any, state: 'cleared' | 'expired', by: string, reason: string) {
+  const rows = await filesOf(base44, drop.id);
+  let wiped = 0;
+  const seen = new Set<string>();
+  for (const f of rows) {
+    if (f.state === 'cleared') continue;
+    if (!seen.has(f.path)) { seen.add(f.path); await wipe(drop.id, f.path); wiped++; }
+    await db(base44).BridgeDropFile.update(f.id, { state: 'cleared' });
+  }
+  await db(base44).BridgeDrop.update(drop.id, { state, cleared_at: now(), cleared_by: by, review_note: String(reason || drop.review_note || '').slice(0, 500) || null });
+  return { drop_id: drop.id, state, files_wiped: wiped };
+}
+
+// Expired drops are wiped a few at a time whenever a drop tool runs.
+export async function sweepExpired(base44: any, max = 1) {
+  const done: any[] = [];
+  for (const state of ['open', 'ready', 'published']) {
+    if (done.length >= max) break;
+    const rows = await db(base44).BridgeDrop.filter({ state }, 'expires_at', 5).catch(() => []);
+    for (const d of rows) {
+      if (done.length >= max) break;
+      if (Date.parse(d.expires_at) <= Date.now()) done.push(await clearDrop(base44, d, 'expired', 'bridge (expiry)', 'expired after ' + DROP_LIMITS.days + ' days'));
+    }
+  }
+  return done;
+}
+
+export type DropCtx = { base44: any; email: string | null; keyLabel?: string | null };
+
+// ---------- bot tools (drop key) ----------
+
+// drop_put: store one file (or action "ready" to say the drop is complete). Never touches a website.
+export async function dropPut(body: any, ctx: DropCtx) {
+  const t = dropTarget(body?.site);
+  const job = dropJob(body?.job);
+  const by = (ctx.keyLabel || ctx.email || 'unknown').slice(0, 80);
+  await sweepExpired(ctx.base44, 1).catch(() => {});
+  if (body?.action === 'ready') {
+    const drop = await openDrop(ctx.base44, t, job);
+    if (!drop) throw new BridgeError('No open drop for ' + t.target + ' / ' + job, 404);
+    const note = typeof body.note === 'string' ? body.note.slice(0, 500) : null;
+    if (note && (CODE.test(note) || secretContentReason(note) || BRIDGE_KEY_TEXT.test(note))) throw new BridgeError('note refused (code or secret-looking text)', 422);
+    await db(ctx.base44).BridgeDrop.update(drop.id, { state: 'ready', ready_at: now(), bot_note: note });
+    return { drop_id: drop.id, site: t.target, job, state: 'ready', files: current(await filesOf(ctx.base44, drop.id)).map(fileView) };
+  }
+  if (body?.action !== undefined && body.action !== 'put') throw new BridgeError('action must be put (default) or ready');
+  const p = dropPath(body?.path);
+  const bytes = decodeDropBytes(body);
+  const sha = await sha256(bytes);
+  if (body.sha256 !== undefined && (typeof body.sha256 !== 'string' || body.sha256.toLowerCase() !== sha)) throw new BridgeError('sha256 does not match the bytes that arrived (' + sha + '); send the file again', 422);
+  const problem = dropContentProblem(p, bytes);
+  if (problem) throw new BridgeError(p.rel + ' refused: ' + problem, 422);
+
+  let drop = await openDrop(ctx.base44, t, job);
+  if (!drop) {
+    const mine = (await Promise.all(OPEN_STATES.map((state) => db(ctx.base44).BridgeDrop.filter({ created_by_label: by, state }, '-created_date', 50)))).flat();
+    if (mine.filter((d: any) => Date.parse(d.expires_at) > Date.now()).length >= DROP_LIMITS.openDropsPerKey) throw new BridgeError('This key already has ' + DROP_LIMITS.openDropsPerKey + ' open drops; wait until Claude publishes or clears them', 429);
+    drop = await db(ctx.base44).BridgeDrop.create({ target: t.target, site: t.site, base_path: t.base, job, state: 'open', created_by_label: by,
+      created_by_actor: ctx.email || null, expires_at: new Date(Date.now() + DROP_LIMITS.days * 86400_000).toISOString(), last_drop_at: now() });
+  }
+  const rows = current(await filesOf(ctx.base44, drop.id));
+  const same = rows.find((f) => f.path === p.rel);
+  if (same && same.sha256 === sha) return { drop_id: drop.id, site: t.target, job, path: p.rel, sha256: sha, bytes: bytes.length, stored: false, unchanged: true };
+  if (!same && rows.length >= DROP_LIMITS.filesPerDrop) throw new BridgeError('A drop holds at most ' + DROP_LIMITS.filesPerDrop + ' files', 413);
+  const total = rows.reduce((n, f) => n + (f.path === p.rel ? 0 : Number(f.bytes) || 0), 0) + bytes.length;
+  if (total > DROP_LIMITS.dropBytes) throw new BridgeError('A drop holds at most ' + DROP_LIMITS.dropBytes + ' bytes in total (this file would make it ' + total + ')', 413);
+
+  await putDropBytes(drop.id + '/' + p.rel, bytes);
+  if (same) await db(ctx.base44).BridgeDropFile.update(same.id, { state: 'replaced' });
+  await db(ctx.base44).BridgeDropFile.create({ drop_id: drop.id, path: p.rel, ext: p.ext, kind: p.kind, bytes: bytes.length, sha256: sha,
+    dropped_at: now(), dropped_by: by, state: 'stored' });
+  await db(ctx.base44).BridgeDrop.update(drop.id, { last_drop_at: now(), state: 'open' });
+  return { drop_id: drop.id, site: t.target, job, path: p.rel, sha256: sha, bytes: bytes.length, stored: true, replaced: Boolean(same),
+    files: rows.length + (same ? 0 : 1), total_bytes: total, expires_at: drop.expires_at };
+}
+
+// drop_status: this key's drops (or one site+job) with file names, sizes and hashes. Never returns file content.
+export async function dropStatus(body: any, ctx: DropCtx) {
+  const by = (ctx.keyLabel || ctx.email || 'unknown').slice(0, 80);
+  if (body?.site !== undefined || body?.job !== undefined) {
+    const t = dropTarget(body?.site), job = dropJob(body?.job);
+    const rows = (await db(ctx.base44).BridgeDrop.filter({ target: t.target, job }, '-created_date', 5)).filter((d: any) => !ctx.keyLabel || d.created_by_label === by);
+    return { drops: await Promise.all(rows.map(async (d: any) => ({ ...dropView(d), files: current(await filesOf(ctx.base44, d.id)).map(fileView) }))) };
+  }
+  const rows = ctx.keyLabel ? await db(ctx.base44).BridgeDrop.filter({ created_by_label: by }, '-created_date', 20) : await db(ctx.base44).BridgeDrop.list('-created_date', 20);
+  return { drops: rows.map(dropView), limits: DROP_LIMITS, types: DROP_TYPES };
+}
+
+// ---------- Claude tools (signed-in session only) ----------
+
+async function getDrop(base44: any, id: unknown) {
+  if (typeof id !== 'string' || !/^[A-Za-z0-9]{6,40}$/.test(id)) throw new BridgeError('drop_id is required');
+  const rows = await db(base44).BridgeDrop.filter({ id }, '-created_date', 1);
+  if (!rows[0]) throw new BridgeError('Drop not found: ' + id, 404);
+  return rows[0];
+}
+
+export async function dropList(body: any, ctx: DropCtx) {
+  await sweepExpired(ctx.base44, 2).catch(() => {});
+  const limit = Math.min(Math.max(Number(body?.limit) || 20, 1), 50);
+  const rows = body?.state ? await db(ctx.base44).BridgeDrop.filter({ state: String(body.state) }, '-created_date', limit) : await db(ctx.base44).BridgeDrop.list('-created_date', limit);
+  return { drops: await Promise.all(rows.map(async (d: any) => ({ ...dropView(d), files: current(await filesOf(ctx.base44, d.id)).map(fileView) }))), limits: DROP_LIMITS };
+}
+
+// Reads a dropped file back from the private folder and proves it is the exact file the bot dropped.
+async function loadDropped(base44: any, drop: any, pathInput: unknown) {
+  const p = dropPath(pathInput);
+  const row = current(await filesOf(base44, drop.id)).find((f) => f.path === p.rel);
+  if (!row) throw new BridgeError('No stored file ' + p.rel + ' in this drop', 404);
+  const f = await readDropBytes(drop.id + '/' + p.rel);
+  if (f.sha256 !== row.sha256) throw new BridgeError('TAMPER CHECK: ' + p.rel + ' on the server is not the file that was dropped (sha differs). Nothing was published.', 409);
+  const problem = dropContentProblem(p, f.bytes);
+  if (problem) throw new BridgeError(p.rel + ' refused: ' + problem, 422);
+  return { p, row, bytes: f.bytes };
+}
+
+export async function dropRead(body: any, ctx: DropCtx) {
+  const drop = await getDrop(ctx.base44, body?.drop_id);
+  if (!OPEN_STATES.includes(drop.state) && drop.state !== 'published') throw new BridgeError('This drop is ' + drop.state, 410);
+  const { p, row, bytes } = await loadDropped(ctx.base44, drop, body?.path);
+  const out: any = { drop_id: drop.id, path: p.rel, type: p.ext, bytes: bytes.length, sha256: row.sha256, dropped_by: row.dropped_by, dropped_at: row.dropped_at };
