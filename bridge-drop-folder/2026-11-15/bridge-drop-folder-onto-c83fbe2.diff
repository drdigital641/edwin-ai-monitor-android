+      results.push({ ...strip(x), status: 'error', error: msg });
+      break; // stop at the first failure; the rest are reported as skipped
+    }
+  }
+  for (const x of plan.slice(results.length)) results.push({ ...strip(x), status: 'skipped' });
+  const ok = results.every((r) => r.status !== 'error' && r.status !== 'skipped');
+  if (results.some((r) => r.status === 'created' || r.status === 'updated')) await db(ctx.base44).BridgeDrop.update(drop.id, { state: 'published', published_at: now(), published_by: ctx.email || null });
+  return { drop_id: drop.id, site, ok, files: results, next: 'When the page is live and checked, call drop_clear for this drop.' };
+}
+
+export async function dropClear(body: any, ctx: DropCtx) {
+  const drop = await getDrop(ctx.base44, body?.drop_id);
+  if (drop.state === 'cleared' || drop.state === 'expired') return { drop_id: drop.id, state: drop.state, files_wiped: 0, already: true };
+  return await clearDrop(ctx.base44, drop, 'cleared', ctx.email || 'claude', typeof body?.reason === 'string' ? body.reason : 'cleared after publish');
+}
