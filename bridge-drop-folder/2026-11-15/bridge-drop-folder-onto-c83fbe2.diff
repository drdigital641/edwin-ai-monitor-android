+  else out.content = new TextDecoder().decode(bytes);
+  return out;
+}
+
+// drop_publish: place dropped files on the drop's own site (or another folder of it) through writeFile.
+// files: [{ from: '<drop path>', to: '<path inside base_path>', expected_sha256?: '<live sha when replacing>' }].
+// All files are checked first (type kept, tamper check, base hash for every replace); one problem refuses the batch.
