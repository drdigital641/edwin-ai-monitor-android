+  const targets = new Set<string>();
+  for (const item of list) {
+    const { p, row, bytes } = await loadDropped(ctx.base44, drop, item?.from);
+    const to = normalizeRel(item?.to);
+    const ext = (to.split('/').pop() || '').split('.').pop()?.toLowerCase();
+    if (ext !== p.ext && !((ext === 'jpg' || ext === 'jpeg') && (p.ext === 'jpg' || p.ext === 'jpeg'))) throw new BridgeError(item.to + ': the file type must stay .' + p.ext, 422);
+    const rel = base ? base + '/' + to : to;
+    if (targets.has(rel)) throw new BridgeError('Two files go to ' + rel, 400);
+    targets.add(rel);
+    let liveSha: string | null = null;
+    try { liveSha = (await readFile(site, rel)).sha256; } catch (e) { if (!(e instanceof BridgeError && e.status === 404)) throw e; }
+    const expected = typeof item.expected_sha256 === 'string' ? item.expected_sha256.toLowerCase() : null;
+    const action = liveSha === null ? 'create' : liveSha === row.sha256 ? 'unchanged' : 'update';
+    if (action === 'update' && expected !== liveSha) throw new BridgeError(rel + ' already exists on the live site and differs: pass expected_sha256 = ' + liveSha + ' (from read_live_file) to replace it. Nothing was published.', 409);
