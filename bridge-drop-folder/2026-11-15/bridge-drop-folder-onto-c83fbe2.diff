+  for (const x of plan) {
+    if (x.action === 'unchanged') { results.push({ ...strip(x), status: 'unchanged' }); continue; }
+    try {
+      await assertNotClaimed(ctx.base44, 'claude', site, x.to);
+      const r: any = await writeFile(site, x.to, x.data, x.expected);
+      await db(ctx.base44).BridgeDropFile.update(x.row.id, { published_to: site + ':' + x.to, published_at: now() });
