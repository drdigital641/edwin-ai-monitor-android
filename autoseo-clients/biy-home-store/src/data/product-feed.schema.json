{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIY product record (shared by the vendor push API, the site feed and products.sample.json)",
  "type": "object",
  "required": ["sku", "title", "active", "updated_at"],
  "properties": {
    "sku": {"type": "string", "maxLength": 64, "description": "AutoCount ItemCode. Primary key. Never changes."},
    "slug": {"type": "string", "description": "Site-generated; vendor does not send it."},
    "title": {"type": "string", "maxLength": 200},
    "description": {"type": ["string", "null"], "maxLength": 5000, "description": "Plain text."},
    "short_description": {"type": ["string", "null"], "maxLength": 300},
    "brand": {"type": ["string", "null"], "description": "Shown only for the brand allow-list (Jotun, Nippon Paint, Dong Cheng, Bosch)."},
    "category": {"type": ["string", "null"], "description": "AutoCount item group / category code. Mapped to site category slugs on our side."},
    "model": {"type": ["string", "null"]},
    "barcode": {"type": ["string", "null"], "pattern": "^[0-9]{8,14}$"},
    "unit": {"type": ["string", "null"], "maxLength": 12, "description": "AutoCount UOM, e.g. PCS, L, KG, SET."},
    "group": {"type": ["object", "null"], "properties": {"code": {"type": "string"}, "name": {"type": "string"}, "variant_label": {"type": "string"}}, "description": "Optional. SKUs sharing group.code are shown as sizes/variants of one product page."},
    "prices": {"type": "array", "items": {"type": "object", "required": ["tier", "amount"], "properties": {"tier": {"type": "string"}, "currency": {"type": "string", "default": "MYR"}, "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"}, "tax_inclusive": {"type": "boolean"}}}},
    "stock": {"type": "array", "items": {"type": "object", "required": ["branch", "qty"], "properties": {"branch": {"type": "string", "enum": ["kota-tinggi-hq", "kota-tinggi-jth", "kota-masai", "pontian"]}, "qty": {"type": "number", "minimum": 0}}}},
    "images": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}, "alt": {"type": "string"}, "primary": {"type": "boolean"}}}},
    "specs": {"type": "array", "items": {"type": "object", "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {"type": "string"}, "unit": {"type": "string"}}}},
    "active": {"type": "boolean"},
    "is_sample": {"type": "boolean", "description": "Site-side only. Always false/absent for vendor data."},
    "source_url": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date-time", "description": "UTC, from AutoCount LastModified."}
  }
}
