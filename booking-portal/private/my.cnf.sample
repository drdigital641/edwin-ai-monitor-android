# /home/<account>/booking-clients/<client-slug>/my.cnf  (chmod 600). Used by backup.sh and restores.
[client]
user = <cpanelprefix>_bksga
password = <BOOKING_DB_PASSWORD_SGAUTOBOTS>
host = localhost
database = <cpanelprefix>_bk_sgautobots
[mysqldump]
user = <cpanelprefix>_bksga
password = <BOOKING_DB_PASSWORD_SGAUTOBOTS>
host = localhost
