# Klar Details: upload as .htaccess in the domain root at go-live (Edwin, via cPanel).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://klardetails.com.sg/$1 [L,R=301]

RewriteRule ^about\-us/?$ /about/ [L,R=301]
RewriteRule ^blog/?$ /articles/ [L,R=301]
RewriteRule ^service\-klarcoat/?$ /services/ceramic-coating/ [L,R=301]
RewriteRule ^service\-klarinterior/?$ /services/interior-detailing/ [L,R=301]
RewriteRule ^service\-klarmaintenance/?$ /services/coating-maintenance/ [L,R=301]
RewriteRule ^service/klarcoat\-2/?$ /services/ceramic-coating/ [L,R=301]
RewriteRule ^service/klarinterior\-2/?$ /services/interior-detailing/ [L,R=301]
RewriteRule ^service/klarmaintenance/?$ /services/coating-maintenance/ [L,R=301]
RewriteRule ^prevent\-car\-water\-spots\-singapore/?$ /articles/car-water-spot-removal-singapore/ [L,R=301]
RewriteRule ^protect\-car\-paint\-bird\-droppings\-tree\-sap/?$ /articles/remove-bird-droppings-tree-sap-car-paint/ [L,R=301]
RewriteRule ^top\-5\-automotive\-workshops\-in\-singapore/?$ /about/ [L,R=301]
RewriteRule ^shopcar/?$ / [L,R=301]
RewriteRule ^checkout/?$ / [L,R=301]
RewriteRule ^search\-page/?$ / [L,R=301]
RewriteRule ^category/uncategorized/?$ /articles/ [L,R=301]
RewriteRule ^author/klardetailuser/?$ /articles/ [L,R=301]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^car\-water\-spot\-removal\-singapore/?$ /articles/car-water-spot-removal-singapore/ [L,R=301]
RewriteRule ^remove\-bird\-droppings\-tree\-sap\-car\-paint/?$ /articles/remove-bird-droppings-tree-sap-car-paint/ [L,R=301]
RewriteRule ^car\-polishing\-vs\-waxing\-vs\-ceramic\-coating/?$ /articles/car-polishing-vs-waxing-vs-ceramic-coating/ [L,R=301]
RewriteRule ^car\-paint\-oxidation\-vs\-clear\-coat\-damage/?$ /articles/car-paint-oxidation-vs-clear-coat-damage/ [L,R=301]
RewriteRule ^leather\-car\-seat\-cleaning\-care\-guide/?$ /articles/leather-car-seat-cleaning-care-guide/ [L,R=301]
RewriteRule ^car\-wheel\-cleaning\-remove\-brake\-dust/?$ /articles/car-wheel-cleaning-remove-brake-dust/ [L,R=301]
RewriteRule ^how\-to\-wash\-ceramic\-coated\-car/?$ /articles/how-to-wash-ceramic-coated-car/ [L,R=301]
RewriteRule ^car\-paint\-swirl\-marks\-causes\-prevention/?$ /articles/car-paint-swirl-marks-causes-prevention/ [L,R=301]
RewriteRule ^new\-car\-detailing\-singapore\-guide/?$ /articles/new-car-detailing-singapore-guide/ [L,R=301]
RewriteRule ^interior\-car\-detailing\-singapore\-guide/?$ /articles/interior-car-detailing-singapore-guide/ [L,R=301]
RewriteRule ^how\-regular\-car\-detailing\-protects\-your\-vehicles\-resale\-value\-in\-singapore/?$ /articles/how-regular-car-detailing-protects-your-vehicles-resale-value-in-singapore/ [L,R=301]
RewriteRule ^5\-signs\-your\-car\-needs\-paint\-correction/?$ /articles/5-signs-your-car-needs-paint-correction/ [L,R=301]
RewriteRule ^what\-really\-happens\-during\-a\-professional\-car\-detailing\-session\-and\-why\-it\-takes\-hours/?$ /articles/what-really-happens-during-a-professional-car-detailing-session-and-why-it-takes-hours/ [L,R=301]
RewriteRule ^why\-professional\-car\-detailing\-matters\-in\-singapores\-harsh\-climate/?$ /articles/why-professional-car-detailing-matters-in-singapores-harsh-climate/ [L,R=301]
RewriteRule ^interior\-car\-detailing\-why\-its\-more\-than\-just\-a\-deep\-clean/?$ /articles/interior-car-detailing-why-its-more-than-just-a-deep-clean/ [L,R=301]
RewriteRule ^why\-klar\-details\-is\-the\-go\-to\-choice\-for\-tesla\-and\-ev\-owners\-in\-singapore/?$ /articles/why-klar-details-is-the-go-to-choice-for-tesla-and-ev-owners-in-singapore/ [L,R=301]
RewriteRule ^blog\-pure\-water\-final\-rinse/?$ /articles/blog-pure-water-final-rinse/ [L,R=301]
RewriteRule ^5\-reasons\-your\-car\-needs\-ceramic\-coating\-in\-singapore/?$ /articles/5-reasons-your-car-needs-ceramic-coating-in-singapore/ [L,R=301]
RewriteRule ^ceramic\-coating\-vs\-graphene\-coating\-which\-is\-better\-for\-singapores\-humid\-climate/?$ /articles/ceramic-coating-vs-graphene-coating-which-is-better-for-singapores-humid-climate/ [L,R=301]
RewriteRule ^graphene\-coating\-for\-car\-protect\-in\-singapore/?$ /articles/graphene-coating-for-car-protect-in-singapore/ [L,R=301]

<IfModule mod_headers.c>
<FilesMatch "\.(html)$">
Header set Cache-Control "max-age=3600, public"
</FilesMatch>
<FilesMatch "\.(css|js|svg|png|ico|webp|jpg|jpeg|mp4)$">
Header set Cache-Control "max-age=604800, public"
</FilesMatch>
</IfModule>
