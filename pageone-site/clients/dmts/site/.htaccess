# Jacky Gearbox (jackygearbox.com), formerly Dynamic Motoring (dmts.com.sg). This folder is the document
# root of both domains and also
# pageonesingapore.com/preview/dmts/. Anything here overrides the parent pageonesingapore.com
# .htaccess for this folder; compression, caching and security headers still come from the parent.
#
# RewriteEngine On here switches off the parent's rewrite rules for this folder, because they assume
# pageonesingapore.com's paths (their index.html rule would send jackygearbox.com/about/index.html to
# jackygearbox.com/preview/dmts/about/). So the https / no-www / index.html rules are repeated here.
RewriteEngine On

# One address only: https://jackygearbox.com (no www, always https)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The rules below are for the client's domains only (the preview address keeps its plain folder paths).
# /index.html and /about/index.html -> the clean folder address
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://jackygearbox.com/$1 [L,R=301]

# Old WordPress addresses (dmts.com.sg until Oct 2026) -> the matching new page, so Google and
# old bookmarks keep working.
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^about-us/?$ https://jackygearbox.com/about/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^photo-gallery/?$ https://jackygearbox.com/gallery/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^(price-estimator|cost-estimator)/?$ https://jackygearbox.com/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^faq/?$ https://jackygearbox.com/about/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^site-maintenance/?$ https://jackygearbox.com/services/gearbox-servicing/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^(blog|feed|comments/feed)/?$ https://jackygearbox.com/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^(.+)/feed/?$ https://jackygearbox.com/$1/ [L,R=301]
RewriteCond %{HTTP_HOST} ^(dmts\.com\.sg|jackygearbox\.com)$ [NC]
RewriteRule ^wp-content/uploads/.*\.(jpe?g|png|gif|webp)$ https://jackygearbox.com/gallery/ [NC,L,R=301]

# Everything else on the old domain -> the same page on jackygearbox.com (the paths are the same)
RewriteCond %{HTTP_HOST} ^dmts\.com\.sg$ [NC]
RewriteRule ^ https://jackygearbox.com%{REQUEST_URI} [L,R=301]

# Our own "page not found" page (the parent's /404.html does not exist on the client's domains)
ErrorDocument 404 /404.html
